---
import '@/index.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/footer/Footer.astro';
import StickyCall from '@/components/site/StickyCall.astro';
import SchemaOrg from '@/components/SchemaOrg.astro';
import { breadcrumbFor } from '@/lib/breadcrumbs';

const SITE = 'https://www.lussarocollection.com';
const DEFAULTS = {
  title: 'Lussaro Collection | Miami Luxury Car Rentals',
  description:
    'Lussaro Collection offers Miami luxury car rentals with exotic vehicles, premium delivery, and fast WhatsApp booking across South Beach and Brickell.',
  image: `${SITE}/preview.png`,
};

const {
  title = DEFAULTS.title,
  description = DEFAULTS.description,
  image = DEFAULTS.image,
  type = 'website',
  noFooter = false,
  schema = null,
  breadcrumbName,        // leaf crumb label for routes the path can't name (car pages)
} = Astro.props;

// canonical from the current path against the configured site
const canonical = new URL(Astro.url.pathname, SITE).href;

// One breadcrumb implementation for the whole site — see lib/breadcrumbs.js.
const breadcrumb = breadcrumbFor(Astro.url.pathname, breadcrumbName);

---

<!doctype html>
<html lang="en">
  <head>
    <!-- MUST stay first. The charset declaration has to land inside the first
         1024 bytes of the document or the browser may begin parsing with the
         wrong encoding — Lighthouse flags it as "charset declaration is missing
         or occurs too late". It used to sit below the GTM block, which is large
         enough on its own to push it past the limit. Nothing goes above this. -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Marks the document as scripting-capable at parse time. Anything that
         must degrade when JS never runs (see the booking-calendar fallback on
         car pages) keys off `html.js` rather than duplicating itself into a
         <noscript> block.

         Re-applied after every view transition: ClientRouter's swap copies the
         <html> attributes from the incoming server-rendered document, which has
         no `js` class, so navigating within the site silently stripped it. That
         un-hid the calendar fallback on every SPA navigation — the message
         appeared under a working calendar with its own data-show never set,
         because the CSS that hides it had stopped matching. -->
    <script is:inline>
      (function () {
        var mark = function () { document.documentElement.classList.add('js'); };
        mark();
        document.addEventListener('astro:after-swap', mark);
      })();
    </script>

    <!-- Google Tag Manager (deferred) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function loadGTM() {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = document.getElementsByTagName('script')[0];
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5J937M8K';
        f.parentNode.insertBefore(s, f);
      }
      // Any real interaction loads the tags immediately, so an engaged visitor
      // is always tracked without delay. This path is unchanged.
      ['click', 'keydown', 'mousemove', 'touchstart', 'scroll'].forEach(function (e) {
        window.addEventListener(e, function h() { loadGTM(); }, { passive: true, once: true });
      });

      // For everyone else, wait for `load` before even scheduling idle work.
      // The container pulls roughly 600 KB across GTM, the Meta Pixel, Clarity
      // and Google Ads. Evaluating that on the main thread while the hero image
      // was sitting decoded and waiting to paint was adding ~1.2s of LCP element
      // render delay on mobile — the image itself downloads in 6.5ms. Firing on
      // a bare 3s idle timeout landed the tags squarely inside the paint window.
      function scheduleGTM() {
        if ('requestIdleCallback' in window) requestIdleCallback(loadGTM, { timeout: 4000 });
        else setTimeout(loadGTM, 2000);
      }
      if (document.readyState === 'complete') scheduleGTM();
      else window.addEventListener('load', scheduleGTM, { once: true });
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Miami luxury car rental, exotic car rental Miami, Lamborghini rental Miami, G-Wagon rental Miami, Mercedes-AMG G63, luxury SUV rental"
    />
    <link rel="canonical" href={canonical} />
    {/* /favicon.ico first: browsers and Googlebot request that path by default,
        and it 404'd until now. The 96px PNG is declared because Google asks for
        a square favicon whose size is a multiple of 48 — the 512px master is
        not one. Regenerate all of these with scripts/make-favicon.mjs. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Fonts loaded non-render-blocking: preload fetches early, then the stylesheet swaps
        media print→all on load so first paint isn't gated on the Google Fonts round trip.
        display=swap shows fallback text immediately and swaps in; <noscript> covers JS-off. */}
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      />
    </noscript>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <SchemaOrg />
    {breadcrumb && <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumb)} />}
    {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}

    <ClientRouter />

    <style is:global>
      /* NOTE: root scroller stays 'auto' (instant). Smooth scroll for in-page anchor
         clicks is handled in JS so it can't animate Astro's scroll restoration. */
      [id] { scroll-margin-top: 5rem; }
      @media (prefers-reduced-motion: no-preference) {
        .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
        .reveal.in { opacity: 1; transform: none; }
        .reveal-d1 { transition-delay: .08s; }
        .reveal-d2 { transition-delay: .16s; }
        .reveal-d3 { transition-delay: .24s; }
      }
      /* Pure opacity dissolve — no transform, so even the tall homepage snapshot
         can't jitter on the way back. No shared-element morph either. */
      ::view-transition-old(root) { animation: vt-out .2s ease-in both; }
      ::view-transition-new(root) { animation: vt-in .28s ease-out both; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      }
      /* on SPA nav, already-visible reveals snap in (no 0.8s slide fighting the fade) */
      .reveal.reveal-instant { opacity: 1 !important; transform: none !important; transition: none !important; }

      /* Degradation fallbacks (booking calendar): hidden whenever scripting is
         available, and put back by JS only if the island fails to mount. With
         scripting off html.js never appears, so they are visible from the start. */
      html.js [data-calendar-fallback] { display: none; }
      html.js [data-calendar-fallback][data-show] { display: block; }
    </style>
  </head>

  <body class="bg-black font-sans">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5J937M8K"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <div class="min-h-screen flex flex-col bg-black">
      <div class="flex-1">
        <slot />
      </div>
      {!noFooter && <Footer />}
    </div>

    <!-- Floating desktop Call button (mobile has its own sticky Call bar) -->
    <StickyCall />

    <!-- Reveal-on-scroll motion layer (re-runs on each view-transition navigation) -->
    <script>
      // On SPA navigation, settle anything already on-screen instantly so the
      // page lands fully composed instead of animating in under the cross-fade.
      document.addEventListener('astro:after-swap', () => {
        const vh = window.innerHeight || 0;
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 1.1 && r.bottom > 0) el.classList.add('in', 'reveal-instant');
        });
      });

      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((e) => io.observe(e));
      }
      // astro:page-load is fired by ClientRouter, which is a module bundle. If
      // that bundle is blocked (content blocker, proxy, flaky network) or throws,
      // the event never fires and every .reveal stays at opacity 0 — the page
      // renders as a hero followed by a screenful of black. This inline script
      // is not a module and always runs, so kick the observer off here too.
      // initReveal only selects `.reveal:not(.in)`, so running twice is a no-op.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>

    <noscript>
      {/* With scripting off nothing can add .in, so opt out of the animation
          entirely rather than leaving the whole page invisible. */}
      <style>.reveal { opacity: 1 !important; transform: none !important; }</style>
    </noscript>

    <!-- Hide the floating Call buttons (mobile pill + desktop pill) while ANY
         inline Call CTA (marked with data-call-inline — the /fleet hero button,
         a car page's "Call to book", …) is on screen, so two call buttons never
         stack. Re-syncs on every view-transition navigation; a single observer
         is kept and swapped so listeners never accumulate. -->
    <script>
      let callCtaObserver;
      function syncCallButtons() {
        const stickies = document.querySelectorAll(
          '[data-cta="sticky_mobile"], [data-cta="sticky_call_desktop"]'
        );
        const inlines = document.querySelectorAll('[data-call-inline]');
        if (callCtaObserver) { callCtaObserver.disconnect(); callCtaObserver = undefined; }
        if (!stickies.length) return;
        stickies.forEach((s) => s.classList.remove('sticky-hidden')); // default: visible
        if (!inlines.length || !('IntersectionObserver' in window)) return;
        const visible = new Set();
        callCtaObserver = new IntersectionObserver(
          (entries) => {
            for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
            stickies.forEach((s) => s.classList.toggle('sticky-hidden', visible.size > 0));
          },
          { threshold: 0.1 }
        );
        inlines.forEach((el) => callCtaObserver.observe(el));
      }
      document.addEventListener('astro:page-load', syncCallButtons);
    </script>

    <!-- Smooth-scroll for genuine in-page anchor clicks only (root scroller is
         otherwise instant, so Astro's scroll restoration never animates). Capture
         phase + stopPropagation so we own same-page hashes and the router doesn't. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var hash = '';
        if (href.charAt(0) === '#') hash = href;
        else if (href.indexOf('/#') === 0 && location.pathname === '/') hash = href.slice(1);
        if (!hash || hash === '#') return;
        var el = document.querySelector(hash);
        if (!el) return;
        e.preventDefault();
        e.stopPropagation();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, true);
    </script>

    <!-- "Collection" back button: when we arrived from within the site, do a REAL
         back-navigation. Astro's router restores the exact prior scroll instantly,
         before the transition snapshot (router.js moveToLocation) — so there's no
         hash, no smooth scroll, no jump. Capture phase so we run before the router. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var back = e.target.closest && e.target.closest('[data-collection-back]');
        if (!back) return;
        var inSite = false;
        try { inSite = sessionStorage.getItem('lussaroInSiteBack') === '1'; } catch (err) {}
        if (!inSite) return; // direct visitor: fall through to the href="/" fallback
        e.preventDefault();
        e.stopPropagation();
        try { sessionStorage.removeItem('lussaroInSiteBack'); } catch (err) {}
        history.back();
      }, true);
    </script>

    <!-- Auto-fire conversion events for every WhatsApp / Call CTA (mapped to Meta Pixel in GTM) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        // breadcrumb: opening a car page from within the site means "back" is safe
        if (href.indexOf('/cars/') === 0) { try { sessionStorage.setItem('lussaroInSiteBack', '1'); } catch (e) {} }
        window.dataLayer = window.dataLayer || [];
        if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
          window.dataLayer.push({ event: 'whatsapp_click', cta_location: a.dataset.cta || 'unknown' });
        } else if (href.indexOf('tel:') === 0) {
          window.dataLayer.push({ event: 'call_click', cta_location: a.dataset.cta || 'unknown' });
        }
      });
    </script>
  </body>
</html>

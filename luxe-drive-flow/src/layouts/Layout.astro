---
import '@/index.css';
import { ClientRouter } from 'astro:transitions';
import Footer from '@/components/footer/Footer.astro';

const SITE = 'https://www.lussarocollection.com';
const DEFAULTS = {
  title: 'Lussaro Collection | Miami Luxury Car Rentals',
  description:
    'Lussaro Collection offers Miami luxury car rentals with exotic vehicles, premium delivery, and fast WhatsApp booking across South Beach and Brickell.',
  image: `${SITE}/preview.png`,
};

const {
  title = DEFAULTS.title,
  description = DEFAULTS.description,
  image = DEFAULTS.image,
  type = 'website',
  noFooter = false,
} = Astro.props;

// canonical from the current path against the configured site
const canonical = new URL(Astro.url.pathname, SITE).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRental',
  name: 'Lussaro Collection',
  description: DEFAULTS.description,
  url: SITE,
  image: `${SITE}/preview.png`,
  telephone: '+1-645-248-7305',
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '900 Biscayne Blvd',
    addressLocality: 'Miami',
    addressRegion: 'FL',
    postalCode: '33132',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'Place', name: 'Miami' },
    { '@type': 'Place', name: 'South Beach' },
    { '@type': 'Place', name: 'Brickell' },
  ],
  sameAs: ['https://instagram.com/lussarocollection'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google Tag Manager (deferred) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function loadGTM() {
        if (window.gtmLoaded) return;
        window.gtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = document.getElementsByTagName('script')[0];
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-5J937M8K';
        f.parentNode.insertBefore(s, f);
      }
      ['click', 'keydown', 'mousemove', 'touchstart', 'scroll'].forEach(function (e) {
        window.addEventListener(e, function h() { loadGTM(); }, { passive: true, once: true });
      });
      if ('requestIdleCallback' in window) requestIdleCallback(loadGTM, { timeout: 3000 });
      else setTimeout(loadGTM, 3000);
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Miami luxury car rental, exotic car rental Miami, Lamborghini rental Miami, G-Wagon rental Miami, Mercedes-AMG G63, luxury SUV rental"
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />

    <style is:global>
      /* NOTE: root scroller stays 'auto' (instant). Smooth scroll for in-page anchor
         clicks is handled in JS so it can't animate Astro's scroll restoration. */
      [id] { scroll-margin-top: 5rem; }
      @media (prefers-reduced-motion: no-preference) {
        .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s cubic-bezier(.22,1,.36,1), transform .8s cubic-bezier(.22,1,.36,1); }
        .reveal.in { opacity: 1; transform: none; }
        .reveal-d1 { transition-delay: .08s; }
        .reveal-d2 { transition-delay: .16s; }
        .reveal-d3 { transition-delay: .24s; }
      }
      /* Pure opacity dissolve — no transform, so even the tall homepage snapshot
         can't jitter on the way back. No shared-element morph either. */
      ::view-transition-old(root) { animation: vt-out .2s ease-in both; }
      ::view-transition-new(root) { animation: vt-in .28s ease-out both; }
      @keyframes vt-out { to { opacity: 0; } }
      @keyframes vt-in { from { opacity: 0; } }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root), ::view-transition-new(root) { animation: none; }
      }
      /* on SPA nav, already-visible reveals snap in (no 0.8s slide fighting the fade) */
      .reveal.reveal-instant { opacity: 1 !important; transform: none !important; transition: none !important; }
    </style>
  </head>

  <body class="bg-black font-sans">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-5J937M8K"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>

    <div class="min-h-screen flex flex-col bg-black">
      <div class="flex-1">
        <slot />
      </div>
      {!noFooter && <Footer />}
    </div>

    <!-- Reveal-on-scroll motion layer (re-runs on each view-transition navigation) -->
    <script>
      // On SPA navigation, settle anything already on-screen instantly so the
      // page lands fully composed instead of animating in under the cross-fade.
      document.addEventListener('astro:after-swap', () => {
        const vh = window.innerHeight || 0;
        document.querySelectorAll('.reveal:not(.in)').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < vh * 1.1 && r.bottom > 0) el.classList.add('in', 'reveal-instant');
        });
      });

      function initReveal() {
        const els = document.querySelectorAll('.reveal:not(.in)');
        if (!els.length) return;
        if (!('IntersectionObserver' in window)) { els.forEach((e) => e.classList.add('in')); return; }
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((e) => io.observe(e));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>

    <!-- Smooth-scroll for genuine in-page anchor clicks only (root scroller is
         otherwise instant, so Astro's scroll restoration never animates). Capture
         phase + stopPropagation so we own same-page hashes and the router doesn't. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        var hash = '';
        if (href.charAt(0) === '#') hash = href;
        else if (href.indexOf('/#') === 0 && location.pathname === '/') hash = href.slice(1);
        if (!hash || hash === '#') return;
        var el = document.querySelector(hash);
        if (!el) return;
        e.preventDefault();
        e.stopPropagation();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, true);
    </script>

    <!-- "Collection" back button: when we arrived from within the site, do a REAL
         back-navigation. Astro's router restores the exact prior scroll instantly,
         before the transition snapshot (router.js moveToLocation) — so there's no
         hash, no smooth scroll, no jump. Capture phase so we run before the router. -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var back = e.target.closest && e.target.closest('[data-collection-back]');
        if (!back) return;
        var inSite = false;
        try { inSite = sessionStorage.getItem('lussaroInSiteBack') === '1'; } catch (err) {}
        if (!inSite) return; // direct visitor: fall through to the href="/" fallback
        e.preventDefault();
        e.stopPropagation();
        try { sessionStorage.removeItem('lussaroInSiteBack'); } catch (err) {}
        history.back();
      }, true);
    </script>

    <!-- Auto-fire conversion events for every WhatsApp / Call CTA (mapped to Meta Pixel in GTM) -->
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href]');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        // breadcrumb: opening a car page from within the site means "back" is safe
        if (href.indexOf('/cars/') === 0) { try { sessionStorage.setItem('lussaroInSiteBack', '1'); } catch (e) {} }
        window.dataLayer = window.dataLayer || [];
        if (href.indexOf('wa.me') !== -1 || href.indexOf('api.whatsapp.com') !== -1) {
          window.dataLayer.push({ event: 'whatsapp_click', cta_location: a.dataset.cta || 'unknown' });
        } else if (href.indexOf('tel:') === 0) {
          window.dataLayer.push({ event: 'call_click', cta_location: a.dataset.cta || 'unknown' });
        }
      });
    </script>
  </body>
</html>

---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import FleetGrid from '@/components/fleet/FleetGrid.jsx';
import LeadForm from '@/components/site/LeadForm.jsx';

const {
  title,
  description,
  h1,
  intro,
  match,                 // array of keywords to filter the fleet (optional)
  ctaTitle = 'Reserve your Miami exotic',
} = Astro.props;

const waMessage = `Hi, I'm interested in renting a luxury car with Lussaro Collection (${h1}).`;
const wa = `https://wa.me/16452487305?text=${encodeURIComponent(waMessage)}`;
---
<Layout title={title} description={description}>
  <Nav />

  <!-- HERO -->
  <header class="relative bg-black pt-28 md:pt-36 pb-16 md:pb-20 overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img src="https://ik.imagekit.io/8i3ae7fac/cars-14.jpg?tr=w-1600,q-70,f-webp" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Lussaro Collection</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold tracking-tight text-white max-w-4xl">{h1}</h1>
      <p class="text-white/65 max-w-3xl text-base md:text-lg leading-relaxed mt-5">{intro}</p>

      <div class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md">
        <a href={wa} data-cta="landing_hero" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-black px-7 py-4 rounded-full font-semibold hover:bg-white transition">
          Reserve on WhatsApp <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
        </a>
        <a href="tel:+16452487305" data-cta="landing_hero" class="flex-1 inline-flex items-center justify-center border border-white/25 text-white px-7 py-4 rounded-full font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">
          Call Now
        </a>
      </div>

      <div class="mt-5 flex items-center gap-3 text-sm text-white/55">
        <span class="text-[#c9a96e]">★★★★★</span> 5.0 Google · Miami Delivery
      </div>
    </div>
  </header>

  <!-- FLEET -->
  <section class="bg-[#f7f5f0] text-[#0a0a0a] py-16 md:py-20">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <FleetGrid match={match} client:visible />
    </div>
  </section>

  <!-- SEO CONTENT -->
  <section class="bg-[#f7f5f0] text-[#0a0a0a] pb-20 md:pb-24">
    <div class="reveal prose prose-neutral max-w-3xl mx-auto px-5 md:px-8 prose-headings:font-display prose-a:text-[#c9a96e] prose-a:no-underline hover:prose-a:underline">
      <slot />
    </div>
  </section>

  <!-- LEAD FORM -->
  <section id="contact" class="bg-black py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-10">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white">{ctaTitle}</h2>
        <p class="text-white/55 mt-3 max-w-md mx-auto">Tell us what and when — we'll confirm in minutes.</p>
      </div>
      <LeadForm client:visible />
    </div>
  </section>

  <CtaBand message={waMessage} />
  <StickyMobileCta message={waMessage} />
</Layout>

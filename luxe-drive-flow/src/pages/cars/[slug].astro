---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import UrusHero from '@/components/hero/UrusHero.jsx';
import ArButton from '@/components/hero/ArButton.jsx';
import CarGallery from '@/components/fleet/CarGallery.jsx';
import BookingCalendar from '@/components/booking/BookingCalendar.jsx';
import { cars } from '@/data/cars';

export function getStaticPaths() {
  return cars.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}

const { car } = Astro.props;
const message = `Hi, I'm interested in booking the ${car.name} with Lussaro Collection.`;
const wa = `https://wa.me/16452487305?text=${encodeURIComponent(message)}`;
const imgs = car.images || [];

const chips = [
  { label: '0–60', value: car.zeroToSixty },
  { label: 'Power', value: `${car.power} hp` },
  { label: 'Miles / day', value: car.miles },
];
// `to` = number to roll up to, with decimals + suffix for the count-up animation
const specs = [
  { k: '0–60 mph', to: parseFloat(car.zeroToSixty) || 0, decimals: 1, suffix: 's' },
  { k: 'Horsepower', to: car.power, decimals: 0, suffix: ' hp' },
  { k: 'Model year', to: car.year, decimals: 0, suffix: '' },
  { k: 'Miles / day', to: car.miles, decimals: 0, suffix: '' },
];

// Per-car structured data for richer Google results (price/day + breadcrumb)
const SITE = 'https://www.lussarocollection.com';
const carUrl = `${SITE}/cars/${car.slug}`;
const carSchema = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: car.name,
  brand: { '@type': 'Brand', name: car.make },
  image: imgs.map((u) => (u.startsWith('http') ? u : `${SITE}${u}`)),
  description: car.description,
  url: carUrl,
  ...(car.year ? { modelDate: String(car.year) } : {}),
  offers: {
    '@type': 'Offer',
    priceCurrency: 'USD',
    price: car.price,
    availability: 'https://schema.org/InStock',
    url: carUrl,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: car.price,
      priceCurrency: 'USD',
      unitCode: 'DAY',
    },
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fleet', item: `${SITE}/#fleet` },
    { '@type': 'ListItem', position: 2, name: car.name, item: carUrl },
  ],
};
---
<Layout
  title={`${car.name} Rental Miami | Lussaro Collection`}
  description={`Rent the ${car.name} in Miami with Lussaro Collection — check availability and book in minutes. ${car.description.slice(0, 110)}`}
  schema={[carSchema, breadcrumbSchema]}
>
  <Nav />

  <!-- back -->
  <div class="bg-black pt-20 md:pt-24">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <a href="/" data-collection-back class="group inline-flex items-center gap-2 text-white/60 hover:text-white text-sm transition">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full border border-white/15 group-hover:border-[#c9a96e] transition">‹</span>
        Collection
      </a>
    </div>
  </div>

  <!-- MAIN: gallery + details (left) · booking card (right) -->
  <section class="bg-black pt-5 pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-[1.45fr_1fr] gap-8 lg:gap-12 items-start">

      <!-- LEFT -->
      <div>
        <div class="relative">
          <CarGallery images={imgs} name={car.name} slug={`g-${car.slug}`} client:visible />
          {car.model && (
            <a href="#see-in-3d" class="absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 bg-[#c9a96e] text-black text-[11px] font-semibold px-3 py-1.5 rounded-full hover:bg-white transition shadow-lg">
              ◆ View in 3D &amp; AR
            </a>
          )}
        </div>

        <div class="mt-7">
          <p class="text-[#c9a96e] tracking-[0.25em] uppercase text-xs mb-2">{car.make} · {car.year}</p>
          <h1 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight leading-[1.05]">{car.name}</h1>

          <div class="flex flex-wrap gap-2 mt-5">
            {chips.map((c) => (
              <span class="inline-flex items-baseline gap-1.5 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-sm">
                <span class="text-white font-semibold">{c.value}</span>
                <span class="text-white/45 text-xs">{c.label}</span>
              </span>
            ))}
          </div>

          <p class="text-white/65 leading-relaxed mt-6 max-w-prose">{car.description}</p>
        </div>
      </div>

      <!-- RIGHT: booking card -->
      <aside>
        <div class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-5 md:p-6 shadow-[0_20px_60px_rgba(0,0,0,0.4)]">
          <div class="flex items-center gap-2.5 mb-4">
            <span class="relative flex h-2 w-2 shrink-0">
              <span class="absolute inline-flex h-full w-full rounded-full bg-[#c9a96e] opacity-70 animate-ping"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-[#c9a96e]"></span>
            </span>
            <span class="text-[13px] leading-snug text-white/85 font-medium tracking-wide" data-urgency>Only 1 in our Miami fleet — dates are booking out fast.</span>
          </div>
          <div class="flex items-end justify-between mb-5">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-white/45 text-base line-through">${(car.price + 200).toLocaleString()}</span>
                <span class="bg-red-600 text-white text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded">$200 OFF</span>
              </div>
              <span class="font-display text-3xl font-bold text-white">${car.price.toLocaleString()}</span>
              <span class="text-white/45 text-sm"> / day</span>
            </div>
            <span class="inline-flex items-center gap-1 text-sm text-white/70"><span class="text-[#c9a96e]">★</span> 5.0</span>
          </div>

          <BookingCalendar client:visible pricePerDay={car.price} carName={car.name} phone="16452487305" />

          <a href="tel:+16452487305" data-cta="car_booking_card"
            class="flex items-center justify-center gap-2 mt-2.5 border border-white/15 text-white py-3 rounded-full font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">
            Call to book
          </a>

          <div class="flex items-center justify-center gap-x-4 gap-y-1 flex-wrap mt-5 text-[11px] text-white/40">
            <span>✓ Insurance options</span>
            <span>✓ Miami Delivery</span>
            <span>✓ Replies in minutes</span>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- SPECS — full-width, one row across, centered -->
  <section class="bg-black border-t border-white/5 py-12 md:py-14">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white text-center mb-7">Specifications</h2>
      <div class="reveal grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {specs.map((s) => (
          <div class="rounded-xl border border-white/10 bg-[#0f0f0f] p-4 md:p-5 text-center">
            <p class="text-white/45 text-[11px] uppercase tracking-wide mb-2">{s.k}</p>
            <p
              class="font-display text-2xl md:text-3xl font-bold text-white leading-none tabular-nums"
              data-countup
              data-to={s.to}
              data-decimals={s.decimals}
              data-suffix={s.suffix}
            >{s.decimals > 0 ? Number(s.to).toFixed(s.decimals) : s.to}{s.suffix}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3D / AR (Urus) — live, spinning model embedded inline -->
  {car.model && (
    <section id="see-in-3d" class="relative bg-black border-t border-white/5 py-16 md:py-24 text-center overflow-hidden scroll-mt-24">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(60% 55% at 50% 40%, rgba(201,169,110,0.14), transparent 70%);"></div>
      <div class="reveal relative z-10 max-w-5xl mx-auto px-5">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Interactive</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-3">See it in 3D &amp; AR</h2>
        <p class="text-white/60 mb-8 max-w-md mx-auto">Drag to spin the {car.name} from every angle — or place it in your driveway with AR.</p>

        <!-- live spinning model (lazy-loads when scrolled into view; mobile + desktop) -->
        <div class="relative w-full h-[56svh] md:h-[54svh] rounded-[24px] overflow-hidden border border-white/10 bg-gradient-to-b from-[#161616] to-[#0a0a0a]">
          <UrusHero client:visible />
          <span class="absolute bottom-3 inset-x-0 text-center text-white/35 text-[11px] pointer-events-none">Drag to explore</span>
        </div>

        <ArButton client:idle title={car.name} />
      </div>
    </section>
  )}

  <!-- CONTACT / lead form -->
  <section id="contact" class="bg-[#0c0c0c] border-t border-white/5 py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-8">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight text-balance">Book the {car.name}</h2>
        <p class="text-white/55 mt-3">Fastest reply on WhatsApp — or send your details and we'll confirm availability.</p>
      </div>

      <div class="reveal flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-10">
        <a href={wa} data-cta="car_contact" target="_blank" rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-black px-7 py-4 rounded-full font-semibold hover:bg-white transition">
          WhatsApp <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
        </a>
        <a href="tel:+16452487305" data-cta="car_contact"
          class="flex-1 inline-flex items-center justify-center border border-white/20 text-white px-7 py-4 rounded-full font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">
          Call Now
        </a>
      </div>

      <LeadForm client:visible defaultVehicle={car.name} />
      <p class="text-white/35 text-xs mt-8 text-center max-w-md mx-auto">Must be 21+ with a valid driver’s license and full coverage insurance. Security deposit required.</p>
    </div>
  </section>

  <CtaBand message={message} />
  <StickyMobileCta message={message} />

  <script>
    // Roll the spec numbers up to their value when they scroll into view.
    function lussaroCountup() {
      const els = Array.from(document.querySelectorAll('[data-countup]'));
      if (!els.length) return;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setup = (el) => ({
        to: parseFloat(el.getAttribute('data-to')) || 0,
        dec: parseInt(el.getAttribute('data-decimals') || '0', 10),
        suffix: el.getAttribute('data-suffix') || '',
      });
      const fmt = (val, dec, suffix) => (dec > 0 ? val.toFixed(dec) : String(Math.round(val))) + suffix;

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => { const c = setup(el); el.textContent = fmt(c.to, c.dec, c.suffix); });
        return;
      }
      // reset to 0 while off-screen, then roll up on intersect
      els.forEach((el) => { const c = setup(el); el.textContent = fmt(0, c.dec, c.suffix); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          io.unobserve(el);
          const c = setup(el);
          const dur = 1100;
          const t0 = performance.now();
          const ease = (t) => 1 - Math.pow(1 - t, 3);
          const tick = (now) => {
            const p = Math.min(1, (now - t0) / dur);
            el.textContent = fmt(c.to * ease(p), c.dec, c.suffix);
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(c.to, c.dec, c.suffix);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 });
      els.forEach((el) => io.observe(el));
    }

    // Rotating urgency line — picks a fresh message each load (never the last one shown).
    const URGENCY = [
      "Only 1 in our Miami fleet — dates are booking out fast.",
      "In high demand this week — reserve before someone else does.",
      "Weekends go first. Lock in your dates while they're open.",
    ];
    function rotateUrgency() {
      const el = document.querySelector('[data-urgency]');
      if (!el) return;
      let last = -1;
      try { last = parseInt(sessionStorage.getItem('lussaroUrgency') || '-1', 10); } catch (e) {}
      let idx = Math.floor(Math.random() * URGENCY.length);
      if (URGENCY.length > 1 && idx === last) idx = (idx + 1) % URGENCY.length;
      try { sessionStorage.setItem('lussaroUrgency', String(idx)); } catch (e) {}
      el.textContent = URGENCY[idx];
    }

    document.addEventListener('astro:page-load', () => { lussaroCountup(); rotateUrgency(); });
  </script>
</Layout>

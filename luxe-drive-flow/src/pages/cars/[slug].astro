---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import UrusHero from '@/components/hero/UrusHero.jsx';
import ArButton from '@/components/hero/ArButton.jsx';
import CarGallery from '@/components/fleet/CarGallery.jsx';
import BookingCalendar from '@/components/booking/BookingCalendar.jsx';
import { Phone, MessageCircle } from 'lucide-react';
import { cars } from '@/data/cars';
import { rentalTerms, termsSummary, deliveryEachWaySummary } from '@/data/rental-terms';
import { descriptionFor } from '@/data/meta-descriptions';
import { titleFor } from '@/data/meta-titles';
import { contentFor } from '@/data/car-content';
import { business, telHref, whatsappWith } from '@/data/business';

export function getStaticPaths() {
  return cars.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}

const { car } = Astro.props;
const wasPrice = car.wasPrice ?? car.price + 200;
const offAmount = wasPrice - car.price;
const message = car.comingSoon
  ? `Hi, I'd like to reserve the ${car.name} early with Lussaro Collection — I hear it's arriving soon.`
  : `Hi, I'm interested in booking the ${car.name} with Lussaro Collection.`;
const wa = whatsappWith(message);
const imgs = car.images || [];

// Per-car editorial content. Absent => none of these sections render at all.
const routePath = `/cars/${car.slug}`;
// Hand-written meta. Previously the description concatenated boilerplate with
// car.description.slice(0, 110), which clipped mid-word.
const pageTitle = titleFor(routePath) ?? `${car.name} Rental Miami | Lussaro Collection`;
const pageDescription = descriptionFor(routePath);

const content = contentFor(car.slug);
const siblingCars = (content?.siblings ?? [])
  .map((s) => cars.find((c) => c.slug === s))
  .filter(Boolean);
const named = (c) => (c.name.startsWith(c.make) ? c.name : `${c.make} ${c.name}`);

const milesPerDay = car.miles ?? rentalTerms.mileage.includedPerDay;
const exDays = 3;

// Four questions, all answered from data that exists: deposit, mileage,
// delivery, and the car's own first Good-to-know fact.
const carFaqs = content ? [
  {
    q: `What is the security deposit on the ${car.name}?`,
    a: `${rentalTerms.deposit.display}, the same on every car we run, taken when your booking is confirmed. ${rentalTerms.deposit.note} It can also cover excess mileage, a late return, cleaning, or fines picked up during the rental.`,
  },
  {
    q: `How many miles come with the ${car.name}?`,
    a: `${milesPerDay} a day, pooled across the whole booking rather than capped daily. Take it for ${exDays} days and you have ${milesPerDay * exDays} miles to spend however suits you — only the total showing at return is counted. Anything past that is charged at a per-mile rate confirmed before you book, and can come out of your deposit.`,
  },
  {
    q: `Will you bring the ${car.name} to my hotel?`,
    a: `Yes, along with residences, offices and both airports. Delivery is ${deliveryEachWaySummary}, and collection at the end of the rental is charged separately at typically the same fee. Beyond those two areas we quote you first, so nothing lands on the invoice unannounced.`,
  },
  {
    q: content.faqQuestion,
    a: content.faqAnswer,
  },
] : [];

const faqSchema = carFaqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: carFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;

// One spec list, rendered once. These numbers used to appear three times on a
// car page: a chips row under the gallery, then a full-width Specifications
// band whose two rows repeated "Miles / day" between them.
//
// `to` means the value counts up when it scrolls into view; `v` renders as-is
// (the model year should not animate). Anything without a value drops out, so
// a car missing a seat count simply shows one card fewer.
const specList = [
  { k: '0–60 mph', to: parseFloat(car.zeroToSixty) || 0, decimals: 1, suffix: 's' },
  { k: 'Horsepower', to: car.power, decimals: 0, suffix: ' hp' },
  { k: 'Miles / day', to: car.miles, decimals: 0, suffix: '' },
  { k: 'Seats', v: car.seats, sub: car.seatsNote },
  { k: 'Doors', v: car.doors },
  { k: 'Model year', v: car.year },
].filter((x) => x.to || x.v);

// Per-car structured data for richer Google results (price/day + breadcrumb)
const SITE = 'https://www.lussarocollection.com';
const carUrl = `${SITE}/cars/${car.slug}`;
// Social-share image = the car's first photo (absolute URL). Skip SVG
// placeholders since most share previews don't render SVG → Layout default.
const firstImg = imgs[0] || '';
const ogImage = firstImg && !firstImg.endsWith('.svg')
  ? (firstImg.startsWith('http') ? firstImg : `${SITE}${firstImg}`)
  : undefined;
// Per-vehicle Product schema, generated entirely from the car's fleet.js entry.
// Replaces the previous `Car` node: schema.org Car is a subtype of Product
// (Product > Vehicle > Car), so emitting both for the same page would put two
// competing product entities with two Offers on one URL.
//
// DO NOT ADD aggregateRating OR review HERE. There is no visible review text on
// these pages, and rating markup without on-page reviews it describes is a
// Google manual-action risk (structured-data spam). Only add it once real
// reviews are rendered on the page itself.

// fleet.js `name` sometimes already carries the make ("Lamborghini Urus") and
// sometimes does not ("S580"), so only prepend when it is missing.
const fullName = car.name.startsWith(car.make) ? car.name : `${car.make} ${car.name}`;
const abs = (u) => (u.startsWith('http') ? u : `${SITE}${u}`);

// One PropertyValue per spec that actually exists on the car.
const additionalProperty = [
  car.power && {
    '@type': 'PropertyValue', name: 'Horsepower', value: car.power, unitText: 'hp',
  },
  car.zeroToSixty && {
    '@type': 'PropertyValue', name: '0–60 mph',
    value: parseFloat(car.zeroToSixty), unitCode: 'SEC', unitText: 'seconds',
  },
  car.miles && {
    '@type': 'PropertyValue', name: 'Included mileage',
    value: car.miles, unitCode: 'SMI', unitText: 'miles per day',
  },
].filter(Boolean);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${fullName} Rental — Miami`,
  image: imgs.map(abs),
  // Same hand-written line the page's <meta name="description"> uses, so the
  // structured data and the visible-to-Google copy cannot disagree. The old
  // `car.description` boilerplate ("...this is how you stand out and own the
  // road") is still fine as on-page prose but is not what we want in schema.
  // Falls back to it only if a car is ever added without a meta-descriptions
  // entry, so this can't emit an undefined description.
  description: pageDescription ?? car.description,
  brand: { '@type': 'Brand', name: car.make },
  sku: `LC-${car.slug.toUpperCase()}`,
  offers: {
    '@type': 'Offer',
    url: carUrl,
    // `price` is the actual bookable rate. car.wasPrice (the struck-through
    // figure shown on the page) is deliberately NOT used here.
    price: car.price.toFixed(2),
    priceCurrency: 'USD',
    availability: car.comingSoon
      ? 'https://schema.org/PreOrder'
      : 'https://schema.org/InStock',
    validFrom: '2026-01-01',
    priceValidUntil: '2026-12-31',
    seller: { '@id': `${SITE}/#business` },
    eligibleDuration: { '@type': 'QuantitativeValue', value: 1, unitCode: 'DAY' },
  },
  ...(additionalProperty.length ? { additionalProperty } : {}),
};
---
<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  schema={faqSchema ? [productSchema, faqSchema] : [productSchema]}
  breadcrumbName={car.name}
>
  <Nav />

  <!-- back -->
  <div class="bg-black pt-20 md:pt-24">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <a href="/" data-collection-back class="group inline-flex items-center gap-2 text-white/60 hover:text-white text-sm transition">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full border border-white/15 group-hover:border-[#ff1516] transition">‹</span>
        Collection
      </a>
    </div>
  </div>

  {/* Page title: one line, one size, centred above the gallery.
      Uppercasing is done with CSS, not by rewriting the string — the DOM text
      stays "Lamborghini Urus Rental In Miami, FL" so crawlers and screen
      readers get natural casing while it renders in caps. The city is wrapped
      only to tint it — it is the word that distinguishes this page from every
      other Urus rental listing — and it sits inside the same continuous text
      run, so the heading still reads as one phrase. */}
  <header class="bg-black pt-3 md:pt-5 pb-4 md:pb-6">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      {car.comingSoon && (
        <p class="text-center mb-3">
          <span class="bg-[#e00e10] text-black text-[10px] font-bold tracking-[0.15em] uppercase px-2.5 py-1 rounded-full">Coming Soon</span>
        </p>
      )}
      <h1 class="font-display font-extrabold text-white uppercase text-center text-balance tracking-tight leading-[1.1] text-[clamp(1.25rem,3.4vw,2.625rem)]">
        {fullName} Rental In <span class="text-[#ff1516]">{business.city}, {business.region}</span>
      </h1>
    </div>
  </header>

  {/* MAIN. Source order is the phone's order — photos, then price + calendar,
      then the reading matter. Desktop rebuilds the two columns with explicit
      grid placement rather than CSS `order`, so the tab order a keyboard or
      screen reader follows always matches what is on screen. */}
  <section class="bg-black pt-0 pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-[1.45fr_1fr] gap-5 lg:gap-x-12 lg:gap-y-8 items-start">

      <!-- 1 · PHOTOS -->
      <div class="relative lg:col-start-1 lg:row-start-1">
        <CarGallery images={imgs} name={car.name} slug={`g-${car.slug}`} client:visible />
        {car.model && (
          <a href="#see-in-3d" class="absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 bg-white text-black text-[11px] font-semibold px-3 py-1.5 rounded-full hover:bg-[#ff1516] transition shadow-lg">
            ◆ View in 3D{car.usdz ? ' & AR' : ''}
          </a>
        )}
      </div>

      <!-- 2 · PRICE + CALENDAR — straight under the photos on a phone -->
      <aside class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <div class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-4 md:p-6 shadow-[0_20px_60px_rgba(0,0,0,0.4)]">
          <div class="flex items-end justify-between mb-4 md:mb-5">
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="text-white/50 text-base line-through">${wasPrice.toLocaleString()}</span>
                <span class="bg-[#e00e10] text-white text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded">${offAmount} OFF</span>
              </div>
              <span class="font-display text-3xl font-bold text-white">${car.price.toLocaleString()}</span>
              <span class="text-white/50 text-sm"> / day</span>
            </div>
            <span class="inline-flex items-center gap-1 text-sm text-white/70"><span class="text-[#ff1516]">★</span> 5.0</span>
          </div>


          {/* client:only (not client:visible) so the calendar renders fresh on the client
              against the real current date. With static SSR, server HTML bakes in the build-date
              "today", and React hydration won't repaint the stale disabled/red states until a
              month flip — so past dates wrongly showed as available on first load. */}
          {/* client:only renders NOTHING on the server, so if the React bundle
              never executes this box is 520px of empty black with no way to
              book. The fallback below covers both failure modes: with scripting
              off `html.js` is absent so it shows immediately, and with scripting
              on it is hidden at parse time and only restored if the island is
              still empty after the bundle has had time to mount. */}
          {/* Reserves the space the island will occupy so the card does not
              jump as React mounts. Two values because the calendar starts
              collapsed on a phone and open on desktop — a flat 520px here left
              the collapsed card padded out with ~290px of nothing. */}
          <div class="min-h-[150px] lg:min-h-[520px]">
            <BookingCalendar client:only="react" pricePerDay={car.price} carName={car.name} vehicleId={car.dashboardId || null} tiers={car.discountTiers} />

            <div data-calendar-fallback class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-6 text-center">
              <p class="text-white font-medium">Check availability with us directly</p>
              <p class="mt-2 text-white/55 text-sm leading-relaxed">
                The live calendar could not load in your browser. Tell us your dates and we
                will confirm whether the {car.name} is free — usually within the hour.
              </p>
              <div class="mt-5 flex flex-col gap-2.5">
                <a href={wa} data-cta="car_calendar_fallback_whatsapp" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center justify-center bg-white text-black py-3.5 rounded-full font-semibold hover:bg-[#ff1516] transition">
                  Message us on WhatsApp
                </a>
                <a href={telHref} data-cta="car_calendar_fallback_call"
                  class="inline-flex items-center justify-center border border-white/20 text-white py-3.5 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition">
                  Call {business.phoneDisplayShort}
                </a>
              </div>
              <p class="mt-4 text-white/50 text-xs">
                ${car.price.toLocaleString('en-US')} / day · {milesPerDay} miles included
              </p>
            </div>
          </div>

          {/* Call was full width here; it gives up half to WhatsApp so both
              channels sit under the calendar. Labels shorten to "Call" and
              "WhatsApp" — "Call to book" no longer fits a half-width pill in
              this column on a narrow phone, and whitespace-nowrap would push it
              past the edge rather than wrap it.

              data-call-inline stays on the Call anchor only. It is what hides
              the floating sticky pair while this card is on screen, and one
              marked element is enough to trigger that — putting it on both
              would just double-count the same card. */}
          <div class="flex gap-2.5 mt-2.5">
            <a href={wa} data-cta="car_booking_card_whatsapp" target="_blank" rel="noopener noreferrer"
              class="wa-pop flex-1 inline-flex items-center justify-center gap-1.5 px-3 bg-[#128f42] text-white py-3.5 rounded-full font-semibold text-sm md:text-base whitespace-nowrap shadow-[0_8px_24px_rgba(37,211,102,0.5)] ring-1 ring-white/15 hover:bg-[#0f7536] transition-colors">
              <MessageCircle className="w-4 h-4 shrink-0" /> WhatsApp
            </a>
            <a href={telHref} data-cta="car_booking_card" data-call-inline
              class="call-pop flex-1 inline-flex items-center justify-center gap-1.5 px-3 bg-[#e00e10] text-white py-3.5 rounded-full font-semibold text-sm md:text-base whitespace-nowrap shadow-[0_8px_24px_rgba(255,21,22,0.45)] ring-1 ring-white/15 hover:bg-[#c40c0e] transition-colors">
              <Phone className="w-4 h-4 shrink-0" /> Call
            </a>
          </div>

          <div class="flex items-center justify-center gap-x-4 gap-y-1 flex-wrap mt-5 text-[11px] text-white/50">
            <span>✓ Insurance options</span>
            <span>✓ Miami Delivery</span>
            <span>✓ Replies in minutes</span>
          </div>
        </div>
      </aside>

      {/* 3 · THE READING MATTER — last on a phone, because someone who has
           already scrolled past the price is browsing rather than booking.
           On desktop it returns to the left column under the photos. */}
      <div class="lg:col-start-1 lg:row-start-2 mt-2 lg:mt-0">
        <p class="text-white/65 leading-relaxed max-w-prose">{car.description}</p>

        {/* Three across from `sm` up, two on a phone. */}
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5 mt-6">
          {specList.map((s) => (
            <div class="rounded-xl border border-white/10 bg-[#0f0f0f] px-3 py-3.5 text-center">
              <p class="text-white/50 text-[10px] uppercase tracking-wide mb-1.5">{s.k}</p>
              {s.to !== undefined ? (
                <p
                  class="font-display text-xl lg:text-2xl font-bold text-white leading-none tabular-nums"
                  data-countup
                  data-to={s.to}
                  data-decimals={s.decimals}
                  data-suffix={s.suffix}
                >{s.decimals > 0 ? Number(s.to).toFixed(s.decimals) : s.to}{s.suffix}</p>
              ) : (
                <p class="font-display text-xl lg:text-2xl font-bold text-white leading-none">{s.v}</p>
              )}
              {s.sub && <p class="text-white/50 text-[10px] mt-1 leading-none">{s.sub}</p>}
            </div>
          ))}
        </div>
        {car.drivetrain && <p class="text-white/50 text-xs mt-3">{car.drivetrain}</p>}
      </div>
    </div>
  </section>

  {/* The full-width "Specifications" band that used to sit here is gone — it
      restated the spec grid that now lives under the description, and repeated
      "Miles / day" between its own two rows. */}

  {content && (
    <section class="bg-black border-t border-white/5 py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-5 md:px-8 space-y-10">
        <div class="space-y-4">
          <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white tracking-tight">Is the {car.name} right for your trip?</h2>
          <p class="reveal text-white/70 leading-relaxed">{content.useCases}</p>
        </div>

        <div class="space-y-4">
          <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white tracking-tight">Good to know</h2>
          <ul class="reveal list-disc list-outside pl-5 space-y-2.5 text-white/70">
            {content.goodToKnow.map((g) => <li>{g}</li>)}
          </ul>
          {content.realMoment && <p class="reveal text-white/70 leading-relaxed border-l-2 border-[#ff1516] pl-4 italic">{content.realMoment}</p>}
          {content.operatorNotes && <p class="reveal text-white/70 leading-relaxed">{content.operatorNotes}</p>}
          {content.deliveryNotes && <p class="reveal text-white/70 leading-relaxed">{content.deliveryNotes}</p>}
        </div>

        <div class="space-y-3">
          <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white tracking-tight">Renting this car</h2>
          <ul class="reveal list-disc list-outside pl-5 space-y-2 text-white/70">
            <li>{rentalTerms.deposit.display} refundable deposit, taken at booking. {rentalTerms.deposit.note}</li>
            <li>{milesPerDay} miles a day, pooled — {exDays} days is {milesPerDay * exDays} miles in total.{' '}
              {rentalTerms.mileage.overagePerMile
                ? `Extra miles run ${'$'}${rentalTerms.mileage.overagePerMile} each.`
                : 'The rate beyond that is confirmed before you book.'}</li>
            <li>Delivery {deliveryEachWaySummary}; collection charged separately; further afield is quoted first.</li>
            <li>{rentalTerms.minimumAge}+ with a valid licence. {rentalTerms.insurance.summary}</li>
          </ul>
          <p class="reveal text-white/50 text-xs">
            <a href="/pricing" class="text-[#ff1516] hover:underline">Full rate card</a> · <a href="/terms" class="text-[#ff1516] hover:underline">Terms of Service</a>
          </p>
        </div>

        {carFaqs.length > 0 && (
          <div class="space-y-3">
            <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white tracking-tight">{car.name} questions</h2>
            <div class="reveal divide-y divide-white/10 border-y border-white/10">
              {carFaqs.map((f) => (
                <details class="group py-5">
                  <summary class="flex items-center justify-between cursor-pointer list-none">
                    <span class="font-display text-lg text-white pr-6">{f.q}</span>
                    <span class="text-[#ff1516] text-xl shrink-0 transition-transform group-open:rotate-45">+</span>
                  </summary>
                  <p class="text-white/60 leading-relaxed mt-3">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        {(siblingCars.length > 0 || content.category) && (
          <div class="space-y-4">
            <h2 class="reveal font-display text-2xl md:text-3xl font-bold text-white tracking-tight">Also consider</h2>
            <div class="reveal grid gap-3 sm:grid-cols-2">
              {siblingCars.map((s) => (
                <a href={`/cars/${s.slug}`} class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-4 hover:border-[#ff1516]/50 transition">
                  <p class="text-white font-display text-lg">{named(s)}</p>
                  <p class="text-white/50 text-sm mt-1">${s.price.toLocaleString()}/day{s.seats ? ` · ${s.seats} seats` : ''} · {s.zeroToSixty} to 60</p>
                </a>
              ))}
            </div>
            {content.category && <p class="reveal text-sm"><a href={content.category.href} class="text-[#ff1516] hover:underline">{content.category.label} →</a></p>}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- 3D / AR (Urus) — live, spinning model embedded inline -->
  {car.model && (
    <section id="see-in-3d" class="relative bg-black border-t border-white/5 py-16 md:py-24 text-center overflow-hidden scroll-mt-24">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(60% 55% at 50% 40%, rgba(255, 21, 22, 0.07), transparent 70%);"></div>
      <div class="reveal relative z-10 max-w-5xl mx-auto px-5">
        <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Interactive</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-3">See it in 3D{car.usdz ? ' & AR' : ''}</h2>
        <p class="text-white/60 mb-8 max-w-md mx-auto">Drag to spin the {car.name} from every angle{car.usdz ? ' — or place it in your driveway with AR' : ''}.</p>

        <!-- live spinning model (lazy-loads when scrolled into view; mobile + desktop) -->
        <div class="relative w-full h-[56svh] md:h-[54svh] rounded-[24px] overflow-hidden border border-white/10 bg-gradient-to-b from-[#161616] to-[#0a0a0a]">
          <UrusHero src={car.model} poster={car.poster} client:visible />
          <span class="absolute bottom-3 inset-x-0 text-center text-white/50 text-[11px] pointer-events-none">Drag to explore</span>
        </div>

        {car.usdz && <ArButton client:visible title={car.name} usdz={car.usdz} glb={car.model} />}
      </div>
    </section>
  )}

  <!-- CONTACT / lead form -->
  <section id="contact" class="bg-[#0c0c0c] border-t border-white/5 py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-8">
        <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight text-balance">Book the {car.name}</h2>
        <p class="text-white/55 mt-3">Fastest reply on WhatsApp — or send your details and we'll confirm availability.</p>
      </div>

      <div class="reveal flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-10">
        <a href={wa} data-cta="car_contact" target="_blank" rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center gap-2 bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">
          WhatsApp <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
        </a>
        <a href={telHref} data-cta="car_contact"
          class="flex-1 inline-flex items-center justify-center border border-white/20 text-white px-7 py-4 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition">
          Call Now
        </a>
      </div>

      <LeadForm client:visible defaultVehicle={car.name} />
      <p class="text-white/50 text-xs mt-8 text-center max-w-md mx-auto">{termsSummary} {rentalTerms.cancellation.summary} <a href="/pricing" class="underline hover:text-white/60">Pricing &amp; policies</a> · <a href="/terms" class="underline hover:text-white/60">Full terms</a>.</p>
    </div>
  </section>

  <CtaBand message={message} />
  <StickyMobileCta message={message} />

  <script>
    // Show the booking fallback only if the calendar island never mounts.
    // client:only means the island is empty until React executes, so an empty
    // island after a grace period is the signal that the bundle did not run.
    function lussaroCalendarFallback() {
      const fb = document.querySelector('[data-calendar-fallback]');
      if (!fb) return;
      if (window.__lussaroFbTimer) clearInterval(window.__lussaroFbTimer);
      fb.removeAttribute('data-show');

      // Re-query on every check. Holding one reference was an earlier bug:
      // Astro can swap the island element as it hydrates, so a captured node
      // goes stale and reports 0 children forever.
      const mounted = () => {
        const el = document.querySelector('astro-island[component-url*="BookingCalendar"]');
        return !!(el && el.children.length > 0);
      };
      if (mounted()) return;

      // Keep watching. The previous version armed a MutationObserver, then at
      // 6s showed the fallback AND disconnected the observer — so a calendar
      // that mounted at, say, 7s (cold cache, slow connection, a dev server
      // compiling on demand) left the "could not load" message on screen
      // underneath a perfectly working calendar. Nothing was left to take it
      // down. Polling instead: the fallback appears only while the calendar is
      // genuinely absent, and retracts the moment it arrives.
      const started = Date.now();
      window.__lussaroFbTimer = setInterval(() => {
        if (mounted()) {
          fb.removeAttribute('data-show');
          clearInterval(window.__lussaroFbTimer);
          return;
        }
        if (Date.now() - started > 6000) fb.setAttribute('data-show', '');
        // Stop eventually so a truly dead bundle doesn't leave a timer running.
        if (Date.now() - started > 60000) clearInterval(window.__lussaroFbTimer);
      }, 250);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', lussaroCalendarFallback);
    } else {
      lussaroCalendarFallback();
    }
    document.addEventListener('astro:page-load', lussaroCalendarFallback);

    // Roll the spec numbers up to their value when they scroll into view.
    function lussaroCountup() {
      const els = Array.from(document.querySelectorAll('[data-countup]'));
      if (!els.length) return;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const setup = (el) => ({
        to: parseFloat(el.getAttribute('data-to')) || 0,
        dec: parseInt(el.getAttribute('data-decimals') || '0', 10),
        suffix: el.getAttribute('data-suffix') || '',
      });
      const fmt = (val, dec, suffix) => (dec > 0 ? val.toFixed(dec) : String(Math.round(val))) + suffix;

      if (reduce || !('IntersectionObserver' in window)) {
        els.forEach((el) => { const c = setup(el); el.textContent = fmt(c.to, c.dec, c.suffix); });
        return;
      }
      // reset to 0 while off-screen, then roll up on intersect
      els.forEach((el) => { const c = setup(el); el.textContent = fmt(0, c.dec, c.suffix); });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target;
          io.unobserve(el);
          const c = setup(el);
          const dur = 1100;
          const t0 = performance.now();
          const ease = (t) => 1 - Math.pow(1 - t, 3);
          const tick = (now) => {
            const p = Math.min(1, (now - t0) / dur);
            el.textContent = fmt(c.to * ease(p), c.dec, c.suffix);
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = fmt(c.to, c.dec, c.suffix);
          };
          requestAnimationFrame(tick);
        });
      }, { threshold: 0.5 });
      els.forEach((el) => io.observe(el));
    }

    document.addEventListener('astro:page-load', () => { lussaroCountup();  });
  </script>
</Layout>

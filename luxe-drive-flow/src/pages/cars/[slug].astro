---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import UrusHero from '@/components/hero/UrusHero.jsx';
import ArButton from '@/components/hero/ArButton.jsx';
import CarGallery from '@/components/fleet/CarGallery.jsx';
import BookingCalendar from '@/components/booking/BookingCalendar.jsx';
import VehicleBookingCard from '@/components/booking/VehicleBookingCard.jsx';
import { Phone } from 'lucide-react';
import WhatsAppIcon from '@/components/site/WhatsAppIcon.astro';
import ReviewCards from '@/components/reviews/ReviewCards.astro';
import { carLabel } from '@/data/fleet';
import { cars } from '@/data/cars';
import { postsForCar, postPath } from '@/data/posts';
import { rentalTerms, deliveryEachWaySummary, rateForDays } from '@/data/rental-terms';
import { altFor } from '@/data/image-alt';
import { descriptionFor } from '@/data/meta-descriptions';
import { titleFor } from '@/data/meta-titles';
import { contentFor } from '@/data/car-content';
import { business, telHref, whatsappWith } from '@/data/business';

export function getStaticPaths() {
  return cars.map((car) => ({ params: { slug: car.slug }, props: { car } }));
}

const { car } = Astro.props;
const label = carLabel(car);

// TEMPORARY — owner's call, Oct 2026. Hides the availability calendar on every
// car page. Nothing is deleted: the island, its no-JS fallback and the
// fallback-watcher script all stay wired, so flipping this back to true
// restores the booking flow exactly as it was.
//
// While it is false the card reads price → WhatsApp/Call → trust line, and
// those two CTAs are the only booking path on a car page.
const SHOW_BOOKING_CALENDAR = false;

// A car is on sale only when fleet.js gives it an explicit wasPrice.
const onSale = car.wasPrice > car.price;
const offAmount = car.wasPrice - car.price;
const message = car.comingSoon
  ? `Hi, I'd like to reserve the ${car.name} early with Lussaro Collection — I hear it's arriving soon.`
  : `Hi, I'm interested in booking the ${car.name} with Lussaro Collection.`;
const wa = whatsappWith(message, { car: car.name, page: `/cars/${car.slug}` });
const imgs = car.images || [];

// Per-car editorial content. Absent => none of these sections render at all.
const routePath = `/cars/${car.slug}`;
// Hand-written meta. Previously the description concatenated boilerplate with
// car.description.slice(0, 110), which clipped mid-word.
const pageTitle = titleFor(routePath) ?? `${label} Rental Miami | Lussaro Collection`;
const pageDescription = descriptionFor(routePath);

const content = contentFor(car.slug);
const siblingCars = (content?.siblings ?? [])
  .map((s) => cars.find((c) => c.slug === s))
  .filter(Boolean);
const named = (c) => (c.name.startsWith(c.make) ? c.name : `${c.make} ${c.name}`);

const milesPerDay = car.miles ?? rentalTerms.mileage.includedPerDay;

// Guides that cover this car. The posts link down to these pages; without
// this the link only runs one way and each post stays an island.
const guides = postsForCar(car.slug);

// The car's discount ladder, falling back to the site-wide one. The booking
// card applies it to the chosen dates.
const bookingTiers = car.discountTiers ?? rentalTerms.discountTiers;

// The fine print under the contact form, built from THIS car's terms. The
// shared termsSummary in rental-terms.js states the fleet defaults, which would
// be wrong on a car with its own deposit or minimum age.
const carTermsSummary = [
  `Must be ${car.minimumAge}+ with a valid driver's license and qualifying insurance.`,
  `${car.deposit.display} refundable security deposit.`,
  `${milesPerDay} miles per day included.`,
].join(' ');
const exDays = 3;

// Four questions, all answered from data that exists: deposit, mileage,
// delivery, and the car's own first Good-to-know fact.
const usdFmt = (n) => `$${n.toLocaleString('en-US')}`;
const firstTier = bookingTiers[0];
const multiDayRate = rateForDays(car.price, firstTier.days, bookingTiers).perDay;
const weekTier = bookingTiers.at(-1);
const fiveTier = bookingTiers.find((t) => t.days === 5) ?? bookingTiers[1] ?? firstTier;
const taxPct = Math.round(rentalTerms.taxesAndFeesRate * 100);
const miamiDelivery = rentalTerms.delivery.find((d) => d.area === 'Miami');
const ftlDelivery = rentalTerms.delivery.find((d) => d.area === 'Fort Lauderdale');
// Copy tokens for cars that carry `sections` / `extraFaqs` in car-content.js.
// Every figure comes from fleet.js or rental-terms.js. A missing car yields ''.
const carBySlug = (s) => cars.find((c) => c.slug === s);
const evoCar = carBySlug('huracan-evo');
const spyderCar = carBySlug('huracan-evo-spyder');
const copyVars = {
  price: usdFmt(car.price),
  threeDay: usdFmt(multiDayRate),
  threeDays: String(firstTier.days),
  weekDays: String(weekTier.days),
  weekRate: usdFmt(rateForDays(car.price, weekTier.days, bookingTiers).perDay),
  fiveDays: String(fiveTier.days),
  fiveRate: usdFmt(rateForDays(car.price, fiveTier.days, bookingTiers).perDay),
  miamiDelivery: miamiDelivery?.display ?? '',
  ftlDelivery: ftlDelivery?.display ?? '',
  miles: String(milesPerDay),
  power: String(car.power),
  zero: car.zeroToSixty,
  deposit: car.deposit.display,
  age: String(car.minimumAge),
  tax: String(taxPct),
  fleetDeposit: rentalTerms.deposit.display,
  evoPrice: evoCar ? usdFmt(evoCar.price) : '',
  evoPower: evoCar ? String(evoCar.power) : '',
  evoZero: evoCar ? evoCar.zeroToSixty : '',
  spyderPrice: spyderCar ? usdFmt(spyderCar.price) : '',
};
const fillCopy = (s) => String(s ?? '').replace(/\{\{(\w+)\}\}/g, (_, k) => (k in copyVars ? String(copyVars[k]) : ''));
// [label](/path) only. The path must be site-root relative so copy cannot inject an off-site URL.
const linkParts = (s) => {
  const filled = fillCopy(s);
  const out = [];
  const re = /\[([^\]]+)\]\((\/[^)\s]+)\)/g;
  let last = 0;
  let m;
  while ((m = re.exec(filled))) {
    if (m.index > last) out.push({ type: 'text', value: filled.slice(last, m.index) });
    out.push({ type: 'link', href: m[2], label: m[1] });
    last = re.lastIndex;
  }
  if (last < filled.length) out.push({ type: 'text', value: filled.slice(last) });
  return out;
};
const compareRows = ['huracan-sto', 'huracan-evo', 'huracan-evo-spyder', 'lamborghini-urus']
  .map(carBySlug)
  .filter(Boolean);
// 1-day rate, then each multi-day tier on this car. The 3-day deal in
// three-day-deals.json is already folded into bookingTiers.
const rateLadder = [
  { label: '1 day', perDay: car.price },
  ...bookingTiers.map((t) => ({
    label: `${t.days} days+`,
    perDay: rateForDays(car.price, t.days, bookingTiers).perDay,
  })),
];
const driveLabel = (c) => (c.drivetrain || '').split('·')[0].trim();
const carFaqs = content ? [
  {
    // Added 15 Nov 2026: "<car> rental price" is a common search and nothing
    // on the page answered it directly. Every figure is derived.
    q: `How much does it cost to rent the ${named(car)} in Miami?`,
    a: `${usdFmt(car.price)} a day, with ${milesPerDay} miles included. Book ${firstTier.days} days or more and it drops to ${usdFmt(rateForDays(car.price, firstTier.days, bookingTiers).perDay)} a day, or ${usdFmt(rateForDays(car.price, weekTier.days, bookingTiers).perDay)} a day for ${weekTier.days} days or more. Taxes and fees of ${taxPct}% are added to the rental, and the ${car.deposit.display} deposit is refundable and held separately.`,
  },
  {
    q: `What is the security deposit on the ${label}?`,
    a: `${car.deposit.display}${car.depositDiffers ? ` on the ${label}, above the ${rentalTerms.deposit.display} that applies to the rest of the fleet` : ''}, taken when your booking is confirmed. ${rentalTerms.deposit.note} It can also cover excess mileage, a late return, cleaning, or fines picked up during the rental.`,
  },
  {
    q: `How many miles come with the ${label}?`,
    a: `${milesPerDay} a day, pooled across the whole booking rather than capped daily. Take it for ${exDays} days and you have ${milesPerDay * exDays} miles to spend however suits you — only the total showing at return is counted. Anything past that is charged at a per-mile rate confirmed before you book, and can come out of your deposit.`,
  },
  {
    q: `Will you bring the ${label} to my hotel?`,
    a: `Yes, along with residences, offices and both airports. Delivery is ${deliveryEachWaySummary}, and collection at the end of the rental is charged separately at typically the same fee. Beyond those two areas we quote you first, so nothing lands on the invoice unannounced.`,
  },
  {
    q: content.faqQuestion,
    a: content.faqAnswer,
  },
  // Extra questions are rendered in the same list, so FAQPage schema cannot
  // describe a question the visitor cannot see.
  ...(content.extraFaqs ?? []).map((f) => ({ q: fillCopy(f.q), a: fillCopy(f.a) })),
] : [];

const faqSchema = carFaqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: carFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;

// One spec list, rendered once. These numbers used to appear three times on a
// car page: a chips row under the gallery, then a full-width Specifications
// band whose two rows repeated "Miles / day" between them.
//
// `to` means the value counts up when it scrolls into view; `v` renders as-is
// (a seat count should not animate). Anything without a value drops out, so a
// car missing a seat count simply shows one card fewer.
// Miles/day, doors and model year were dropped from this grid (owner's call,
// Oct 2026) — mileage is already stated under the booking card, and the other
// two earned their space least. They are still emitted in `additionalProperty`
// below, so the structured data keeps the full spec sheet.
const specList = [
  { k: '0–60 mph', to: parseFloat(car.zeroToSixty) || 0, decimals: 1, suffix: 's' },
  { k: 'Horsepower', to: car.power, decimals: 0, suffix: ' hp' },
  { k: 'Seats', v: car.seats, sub: car.seatsNote },
].filter((x) => x.to || x.v);

// Per-car structured data for richer Google results (price/day + breadcrumb)
const SITE = 'https://www.lussarocollection.com';
const carUrl = `${SITE}/cars/${car.slug}`;
// Social-share image = the car's first photo (absolute URL). Skip SVG
// placeholders since most share previews don't render SVG → Layout default.
const firstImg = imgs[0] || '';
const ogImage = firstImg && !firstImg.endsWith('.svg')
  ? (firstImg.startsWith('http') ? firstImg : `${SITE}${firstImg}`)
  : undefined;
// Per-vehicle Product schema, generated entirely from the car's fleet.js entry.
// Replaces the previous `Car` node: schema.org Car is a subtype of Product
// (Product > Vehicle > Car), so emitting both for the same page would put two
// competing product entities with two Offers on one URL.
//
// DO NOT ADD aggregateRating OR review HERE. There is no visible review text on
// these pages, and rating markup without on-page reviews it describes is a
// Google manual-action risk (structured-data spam). Only add it once real
// reviews are rendered on the page itself.

// fleet.js `name` sometimes already carries the make ("Lamborghini Urus") and
// sometimes does not ("S580"), so only prepend when it is missing.
const fullName = car.name === 'GLS 600 Maybach'
  ? label
  : (car.name.startsWith(car.make) ? car.name : `${car.make} ${car.name}`);
// /porsche-911-turbo-s-rental-miami owns "porsche rental miami" and leads with
// "Porsche 911 Turbo S Rental Miami". This URL is the spec and booking record,
// so its heading does not repeat that query.
const detailH1 = car.slug === 'porsche-911-turbo-s'
  ? 'Porsche 911 Turbo S Cabriolet Specs, Photos and Rates'
  : '';

// Carousel alt text: the reviewed description from image-alt.js where one
// exists, otherwise a fallback that still names the car and the city.
const galleryAlts = imgs.map((src, i) => altFor(src, `${fullName} rental in Miami — photo ${i + 1}`));
const abs = (u) => (u.startsWith('http') ? u : `${SITE}${u}`);

// One PropertyValue per spec that actually exists on the car.
const additionalProperty = [
  car.power && {
    '@type': 'PropertyValue', name: 'Horsepower', value: car.power, unitText: 'hp',
  },
  car.zeroToSixty && {
    '@type': 'PropertyValue', name: '0–60 mph',
    value: parseFloat(car.zeroToSixty), unitCode: 'SEC', unitText: 'seconds',
  },
  car.miles && {
    '@type': 'PropertyValue', name: 'Included mileage',
    value: car.miles, unitCode: 'SMI', unitText: 'miles per day',
  },
].filter(Boolean);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${fullName} Rental — Miami`,
  image: imgs.map(abs),
  // Same hand-written line the page's <meta name="description"> uses, so the
  // structured data and the visible-to-Google copy cannot disagree. The old
  // `car.description` boilerplate ("...this is how you stand out and own the
  // road") is still fine as on-page prose but is not what we want in schema.
  // Falls back to it only if a car is ever added without a meta-descriptions
  // entry, so this can't emit an undefined description.
  description: pageDescription ?? car.description,
  brand: { '@type': 'Brand', name: car.make },
  sku: `LC-${car.slug.toUpperCase()}`,
  offers: {
    '@type': 'Offer',
    url: carUrl,
    // `price` is the actual bookable rate. car.wasPrice (the struck-through
    // figure shown on the page) is deliberately NOT used here.
    price: car.price.toFixed(2),
    priceCurrency: 'USD',
    availability: car.comingSoon
      ? 'https://schema.org/PreOrder'
      : 'https://schema.org/InStock',
    validFrom: '2026-01-01',
    priceValidUntil: '2026-12-31',
    seller: { '@id': `${SITE}/#business` },
    eligibleDuration: { '@type': 'QuantitativeValue', value: 1, unitCode: 'DAY' },
  },
  ...(additionalProperty.length ? { additionalProperty } : {}),
};

// The STO page asks for a Vehicle/Car entity with the same Offer the visitor
// sees. Car is a Vehicle and a Product, so this stays ONE node — a second
// Product beside it would be two competing offers on one URL. Other car pages
// keep the shared Product shape; a site-wide schema pass can rebase this block.
const engineLabel = (car.drivetrain || '').split('·').slice(1).join('·').trim();
const pageProductSchema = car.slug === 'huracan-sto'
  ? {
      ...productSchema,
      '@type': ['Product', 'Car'],
      model: 'Huracán STO',
      vehicleModelDate: String(car.year),
      bodyType: 'Coupe',
      vehicleSeatingCapacity: car.seats,
      numberOfDoors: car.doors,
      driveWheelConfiguration: 'https://schema.org/RearWheelDriveConfiguration',
      fuelType: 'Gasoline',
      accelerationTime: {
        '@type': 'QuantitativeValue',
        name: '0–60 mph',
        value: parseFloat(car.zeroToSixty),
        unitCode: 'SEC',
        unitText: 'seconds',
      },
      vehicleEngine: {
        '@type': 'EngineSpecification',
        name: engineLabel || 'Naturally aspirated V10',
        fuelType: 'Gasoline',
        enginePower: {
          '@type': 'QuantitativeValue',
          value: car.power,
          unitText: 'hp',
        },
      },
    }
  : productSchema;
---
<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  schema={faqSchema ? [pageProductSchema, faqSchema] : [pageProductSchema]}
  breadcrumbName={label}
>
  <Nav />

  <!-- back -->
  <div class="bg-black pt-20 md:pt-24">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <a href="/" data-collection-back class="group inline-flex items-center gap-2 text-white/60 hover:text-white text-sm transition">
        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full border border-white/15 group-hover:border-[#ff1516] transition">‹</span>
        Collection
      </a>
    </div>
  </div>

  {/* Page title: one line, one size, centred above the gallery.
      Uppercasing is done with CSS, not by rewriting the string — the DOM text
      stays "Lamborghini Urus Rental In Miami, FL" so crawlers and screen
      readers get natural casing while it renders in caps. The city is wrapped
      only to tint it — it is the word that distinguishes this page from every
      other Urus rental listing — and it sits inside the same continuous text
      run, so the heading still reads as one phrase. */}
  <header class="bg-black pt-3 md:pt-5 pb-4 md:pb-6">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      {car.comingSoon && (
        <p class="text-center mb-3">
          <span class="bg-[#e00e10] text-black text-[10px] font-bold tracking-[0.15em] uppercase px-2.5 py-1 rounded-full">Coming Soon</span>
        </p>
      )}
      <h1 class="font-display font-extrabold text-white uppercase text-center text-balance tracking-tight leading-[1.1] text-[clamp(1.25rem,3.4vw,2.625rem)]">
        {detailH1 ? (
          detailH1
        ) : content?.h1Lead ? (
          <>{content.h1Lead}{' '}<span class="text-[#ff1516]">{business.city}</span></>
        ) : (
          <>{fullName} Rental In <span class="text-[#ff1516]">{business.city}, {business.region}</span></>
        )}
      </h1>
      {detailH1 && (
        <p class="text-center text-white/70 text-sm md:text-base mt-4">
          <a href="/porsche-911-turbo-s-rental-miami" class="text-[#ff1516] underline underline-offset-4">Porsche rental in Miami</a>
          <span aria-hidden="true"> · </span>
          rates, delivery and how this car compares
        </p>
      )}
    </div>
  </header>

  {/* MAIN. Source order is the phone's order — photos, then price + calendar,
      then the reading matter. Desktop rebuilds the two columns with explicit
      grid placement rather than CSS `order`, so the tab order a keyboard or
      screen reader follows always matches what is on screen. */}
  <section class="bg-black pt-0 pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-5 md:px-8 grid lg:grid-cols-[1.45fr_1fr] gap-5 lg:gap-x-12 lg:gap-y-8 items-start">

      <!-- 1 · PHOTOS -->
      <div class="relative lg:col-start-1 lg:row-start-1">
        <CarGallery images={imgs} name={label} slug={`g-${car.slug}`} alts={galleryAlts} client:visible />
        {car.model && (
          <a href="#see-in-3d" class="absolute top-3 left-3 z-10 inline-flex items-center gap-1.5 bg-white text-black text-[11px] font-semibold px-3 py-1.5 rounded-full hover:bg-[#ff1516] transition shadow-lg">
            ◆ View in 3D{car.usdz ? ' & AR' : ''}
          </a>
        )}
      </div>

      <!-- 2 · PRICE + BOOKING — straight under the photos on a phone.
           Spans both rows on desktop. The booking card runs ~800px against the
           gallery's ~430px, so it has to reach down past the gallery alongside
           the reading matter; confine it to row 1 and the left column opens a
           void under the photos the full height of the form. -->
      <aside class="lg:col-start-2 lg:row-start-1 lg:row-span-2">
        <div class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-4 md:p-6 shadow-[0_20px_60px_rgba(0,0,0,0.4)]">
          <div class="mb-4 md:mb-5">
            <div>
              {onSale && (
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-white/50 text-base line-through">${car.wasPrice.toLocaleString()}</span>
                  <span class="bg-[#e00e10] text-white text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded">${offAmount} OFF</span>
                </div>
              )}
              {/* Two-tier price, owner's layout (23 Nov 2026): the 1-day rate,
                  then the per-day rate for the first multi-day tier — the 3-Day
                  Deal typed in Keystatic when there is one, otherwise the
                  standard discount. Car pages only; fleet cards show one price.
                  #ff1516 holds AA on this #0f0f0f card (#e00e10 does not). */}
              <div class="flex items-end gap-6">
                <div>
                  <p class="text-white/50 text-[11px] font-semibold uppercase tracking-[0.2em]">1 Day</p>
                  <p class="font-display text-2xl font-bold text-white leading-none mt-1">${car.price.toLocaleString()}</p>
                </div>
                <div>
                  <p class="text-[#ff1516] text-[11px] font-semibold uppercase tracking-[0.2em]">{firstTier.days} Days+</p>
                  <p class="font-display text-4xl font-bold text-[#ff1516] leading-none mt-1">${multiDayRate.toLocaleString()}<span class="text-white/50 text-sm font-normal"> / day</span></p>
                </div>
              </div>
            </div>
          </div>

          {/* client:only (not client:visible) so the calendar renders fresh on the client
              against the real current date. With static SSR, server HTML bakes in the build-date
              "today", and React hydration won't repaint the stale disabled/red states until a
              month flip — so past dates wrongly showed as available on first load. */}
          {/* client:only renders NOTHING on the server, so if the React bundle
              never executes this box is 520px of empty black with no way to
              book. The fallback below covers both failure modes: with scripting
              off `html.js` is absent so it shows immediately, and with scripting
              on it is hidden at parse time and only restored if the island is
              still empty after the bundle has had time to mount. */}
          {/* Reserves the space the island will occupy so the card does not
              jump as React mounts. Two values because the calendar starts
              collapsed on a phone and open on desktop — a flat 520px here left
              the collapsed card padded out with ~290px of nothing. */}
          {SHOW_BOOKING_CALENDAR && (
          <div class="min-h-[150px] lg:min-h-[520px]">
            <BookingCalendar client:only="react" pricePerDay={car.price} carName={car.name} vehicleId={car.dashboardId || null} tiers={car.discountTiers} />

            <div data-calendar-fallback class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-6 text-center">
              <p class="text-white font-medium">Check availability with us directly</p>
              <p class="mt-2 text-white/55 text-sm leading-relaxed">
                The live calendar could not load in your browser. Tell us your dates and we
                will confirm whether the {label} is free.
              </p>
              <div class="mt-5 flex flex-col gap-2.5">
                <a href={wa} data-cta="car_calendar_fallback_whatsapp" target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center justify-center bg-white text-black py-3.5 rounded-full font-semibold hover:bg-[#ff1516] transition">
                  Message us on WhatsApp
                </a>
                <a href={telHref} data-cta="car_calendar_fallback_call"
                  class="inline-flex items-center justify-center border border-white/20 text-white py-3.5 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition">
                  Call {business.phoneDisplayShort}
                </a>
              </div>
              <p class="mt-4 text-white/50 text-xs">
                ${car.price.toLocaleString('en-US')} / day · {milesPerDay} miles included
              </p>
            </div>
          </div>
          )}

          {/* The booking request card. client:visible rather than client:only so
              the fields and the reassurance copy are in the server HTML — this
              is the page's primary conversion unit and it must exist for a
              crawler, and for anyone whose bundle is slow. It collects dates
              but checks no availability: nothing here can tell a visitor a car
              is free when it is not. */}
          <VehicleBookingCard client:visible pricePerDay={car.price} carName={car.name} tiers={bookingTiers} milesPerDay={milesPerDay} depositDisplay={car.deposit.display} minimumAge={car.minimumAge} vehicleId={car.dashboardId || null} />

          {/* Call was full width here; it gives up half to WhatsApp so both
              channels sit under the calendar. Labels shorten to "Call" and
              "WhatsApp" — "Call to book" no longer fits a half-width pill in
              this column on a narrow phone, and whitespace-nowrap would push it
              past the edge rather than wrap it.

              data-call-inline stays on the Call anchor only. It is what hides
              the floating sticky pair while this card is on screen, and one
              marked element is enough to trigger that — putting it on both
              would just double-count the same card. */}
          <div class="flex gap-2.5 mt-4">
            <a href={wa} data-cta="car_booking_card_whatsapp" target="_blank" rel="noopener noreferrer"

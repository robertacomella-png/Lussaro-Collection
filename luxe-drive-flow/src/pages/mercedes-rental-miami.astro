---
// /mercedes-rental-miami
//
// Owns "mercedes rental miami" only. The G-Wagon page keeps the G63 query,
// /mercedes-s580-rental-miami keeps the S-Class query, and /maybach-rental-miami
// keeps the Maybach query. This page is the lineup, and it links down.
import LandingLayout from '@/layouts/LandingLayout.astro';
import RateGrid from '@/components/site/RateGrid.astro';
import { hoursSummary } from '@/data/business';
import { rentalTerms } from '@/data/rental-terms';
import {
  assertMeta,
  assertTitle,
  carsInOrder,
  faqPage,
  fllDelivery,
  miamiDelivery,
  hubCtaSubtitle,
  itemListFor,
  publicName,
  usd,
} from '@/lib/hub';

const ORDER = ['mercedes-amg-g63', 'mercedes-s580', 'mercedes-maybach-s580', 'mercedes-maybach-gls-600'];
const mercs = carsInOrder(ORDER);
const bySlug = (slug) => mercs.find((c) => c.slug === slug);
const g63 = bySlug('mercedes-amg-g63');
const s580 = bySlug('mercedes-s580');
const maybachS = bySlug('mercedes-maybach-s580');
const gls = bySlug('mercedes-maybach-gls-600');
const { mileage, minimumAge, deposit } = rentalTerms;

const title = assertTitle('Mercedes', 'Mercedes Rental Miami | Lussaro Collection');
const description = assertMeta(
  'Mercedes',
  `Mercedes rental in Miami: Mercedes-AMG G63, Mercedes-Benz S580, Mercedes-Maybach S580 and Mercedes-Maybach GLS 600. Delivery from ${miamiDelivery.display} each way in Miami.`,
);

const item = (car, href) => ({ car, href, name: publicName(car) });

const faqs = [
  {
    q: 'Which Mercedes should I book?',
    a: [
      g63 && `The ${publicName(g63)} at ${usd(g63.price)} a day when you want the upright SUV.`,
      s580 && `The ${publicName(s580)} at ${usd(s580.price)} a day when you are driving yourself.`,
      maybachS && `The ${publicName(maybachS)} at ${usd(maybachS.price)} a day when the rear seat is the point.`,
      gls && `The ${publicName(gls)} at ${usd(gls.price)} a day when you want the Maybach SUV.`,
    ].filter(Boolean).join(' '),
  },
  {
    q: 'Is the Mercedes-Benz S580 the same car as the Mercedes-Maybach S580?',
    a: s580 && maybachS
      ? `No. The Mercedes-Benz S580 is ${usd(s580.price)} a day, ${s580.power} hp, ${s580.zeroToSixty} to 60. The Mercedes-Maybach S580 is ${usd(maybachS.price)} a day, ${maybachS.power} hp, ${maybachS.zeroToSixty} to 60, with a longer wheelbase and a pair of executive rear seats. They are separate cars.`
      : 'They are separate cars, with separate rates on this page.',
  },
  {
    q: 'Where do the single-model pages live?',
    a: 'The G63 has its own G-Wagon page. The Mercedes-Benz S580 has its own S-Class page. The Mercedes-Maybach S580 and the Mercedes-Maybach GLS 600 share the Maybach page. This page is the lineup, and each name below links to that car.',
  },
  {
    q: 'What does delivery cost?',
    a: `Any of these Mercedes cars is ${miamiDelivery.display} each way in Miami, and ${fllDelivery.display} each way in Fort Lauderdale, with the handover point agreed in your quote. ${mileage.includedPerDay} miles a day are included, the refundable deposit is ${deposit.display}, and drivers must be ${minimumAge} or over with a valid license. ${hoursSummary}.`,
  },
];
---
<LandingLayout
  title={title}
  description={description}
  h1="Mercedes Rental Miami"
  intro="Four Mercedes cars, and they are not substitutes. The Mercedes-AMG G63 is the upright SUV. The Mercedes-Benz S580 is the sedan you drive. The Mercedes-Maybach S580 is the sedan you sit in. The Mercedes-Maybach GLS 600 is the Maybach SUV."
  only={mercs.map((c) => c.slug)}
  fleetHeading="Mercedes cars in the fleet"
  fullFleetLink
  ctaTitle="Reserve a Mercedes"
  heroImage="/cars/mercedes-s580-rental-miami-front-quarter.jpg"
  showRating={false}
  reserveNote="Tell us the car and the dates and we'll confirm availability."
  leadNote="Prefer to talk now? Call or WhatsApp us."
  ctaSubtitle={hubCtaSubtitle}
  schema={[itemListFor(mercs), faqPage(faqs)]}
>
  <p>This page owns the Mercedes lineup. A single model keeps its own page, linked under each car. The day rates in the table are the live fleet prices.</p>

  <h2>Daily rates</h2>
  <RateGrid items={mercs.map((car) => item(car, `/cars/${car.slug}`))} />
  <p>The 1-day column is the published day rate. Each longer column is the per-day rate once the rental reaches that length. {mileage.includedPerDay} miles a day are included and pooled across the booking.</p>

  {g63 && (
    <>
      <h2><a href="/cars/mercedes-amg-g63">{publicName(g63)}</a></h2>
      <p>{g63.power} hp, {g63.zeroToSixty} to 60, {usd(g63.price)} a day. It is the boxy SUV, high enough that a hotel ramp is not the problem a low nose would be. Specs and photos are on the <a href="/cars/mercedes-amg-g63">G63 car page</a>. The page that answers the G-Wagon question on its own is <a href="/g-wagon-rental-miami">G-Wagon rental Miami</a>.</p>
    </>
  )}

  {s580 && (
    <>
      <h2><a href="/cars/mercedes-s580">{publicName(s580)}</a></h2>
      <p>{s580.power} hp from a twin-turbo V8 with mild-hybrid assist, {s580.zeroToSixty} to 60, {usd(s580.price)} a day. This is the Mercedes-Benz S580, the sedan you drive, not the Maybach. The <a href="/cars/mercedes-s580">S580 car page</a> has the photos. The page aimed at the S-Class search is <a href="/mercedes-s580-rental-miami">Mercedes-Benz S580 rental Miami</a>.</p>
    </>
  )}

  {maybachS && (
    <>
      <h2><a href="/cars/mercedes-maybach-s580">{publicName(maybachS)}</a></h2>
      <p>{maybachS.power} hp, {maybachS.zeroToSixty} to 60, {usd(maybachS.price)} a day. Four seats: the rear is a pair of executive chairs with a fixed console between them, so there is no middle seat. It is quieter and longer than the Mercedes-Benz S580, and it costs more. Photos are on the <a href="/cars/mercedes-maybach-s580">Mercedes-Maybach S580 car page</a>.</p>
    </>
  )}

  {gls && (
    <>
      <h2><a href="/cars/mercedes-maybach-gls-600">{publicName(gls)}</a></h2>
      <p>{gls.power} hp, {gls.zeroToSixty} to 60, {usd(gls.price)} a day. The rear is built around reclining executive seats. It is the Maybach SUV, not a third-row family hauler. Photos are on the <a href="/cars/mercedes-maybach-gls-600">Mercedes-Maybach GLS 600 car page</a>.</p>
    </>
  )}

  <p>The Mercedes-Maybach S580 and the Mercedes-Maybach GLS 600 together, including chauffeur in the GLS 600, are on <a href="/maybach-rental-miami">Maybach rental Miami</a>. This page does not take that query.</p>

  <h2>Delivery and hours</h2>
  <p>Mercedes delivery is {miamiDelivery.display} each way in Miami, and {fllDelivery.display} each way in Fort Lauderdale, with the handover point agreed in your quote. {hoursSummary}. Deposit, miles and insurance are on the <a href="/pricing">rate card</a>.</p>

  <h2>Questions</h2>
  {faqs.map((f) => (
    <>
      <h3>{f.q}</h3>
      <p>{f.a}</p>
    </>
  ))}
</LandingLayout>

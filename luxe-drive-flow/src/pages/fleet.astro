---
// /fleet — standalone fleet landing page (the Nav "Fleet" link and the
// destination for paid ads). Mirrors the homepage's "The Collection" section
// exactly (shared FleetCollection component), then adds the deeper info an ad
// visitor needs to convert: what's included, how booking works, FAQs (with
// FAQPage + ItemList schema), reviews, and a lead form.
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import Car3DViewer from '@/components/hero/Car3DViewer.jsx';
import FleetCollection from '@/components/fleet/FleetCollection.astro';
import { Phone } from 'lucide-react';
import { cars } from '@/data/cars';

const SITE = 'https://www.lussarocollection.com';
const waMsg = "Hi, I'm interested in renting an exotic car with Lussaro Collection. What's available?";
const wa = `https://wa.me/16452487305?text=${encodeURIComponent(waMsg)}`;

const included = [
  { t: 'Door-to-door delivery', d: 'Hotel, home, or airport — South Beach, Brickell & beyond.' },
  { t: 'Flexible insurance', d: 'Drive on your full-coverage policy, or ask us about options.' },
  { t: 'Multi-day discounts', d: 'Save up to 25% on longer rentals.' },
  { t: '24/7 support', d: 'A direct line to us the whole time the car is yours.' },
];

const steps = [
  { n: '1', t: 'Message us', d: 'Tap WhatsApp or call. Tell us the car and dates — we reply in minutes.' },
  { n: '2', t: 'We deliver', d: 'White-glove delivery anywhere in Miami — hotel, home, or airport.' },
  { n: '3', t: 'You drive', d: 'Keys in hand, full orientation, 24/7 support. Just enjoy the road.' },
];

const faqs = [
  { q: 'What do I need to rent?', a: '21+ with a valid driver’s license and full-coverage insurance. A refundable security deposit confirms your booking.' },
  { q: 'How fast can I book?', a: 'Often same-day. Message or call — we reply in minutes, and most bookings confirm within the hour.' },
  { q: 'Do you deliver the car to me?', a: 'Yes — hotel, home, or airport, anywhere in Miami: South Beach, Brickell, and beyond.' },
  { q: 'Are there discounts for longer rentals?', a: 'Yes: most cars are 15% off at 3+ days, 20% at 5+, 25% at 7+. Exact pricing shows on each car’s calendar.' },
  { q: 'How does the security deposit work?', a: 'It varies by car, is disclosed before you book, and is refunded after inspection.' },
  { q: 'Is the car in the photos the car I get?', a: 'Yes. Every listing is the exact car we deliver — most are one-of-one in Miami.' },
  { q: 'Which car should I choose?', a: 'Tell us the occasion on WhatsApp — we’ll match you to the right car in one message.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const fleetSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Lussaro Collection — Miami Exotic Car Rental Fleet',
  itemListElement: cars.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `${SITE}/cars/${c.slug}`,
  })),
};
---
<Layout
  title="Exotic Car Rental Fleet Miami | From $445/Day | Lussaro Collection"
  description="Browse Lussaro Collection's Miami exotic fleet — Lamborghini, Ferrari, Rolls-Royce, Maybach & G-Wagon from $445/day. Door-to-door delivery, multi-day discounts, and booking in minutes."
  schema={[fleetSchema, faqSchema]}
>
  <Nav />

  <!-- HERO — tight, conversion-first: price-anchored headline, scannable trust
       chips, one concrete CTA. Kept short so the first cars sit right at the
       fold — on an ad click, the inventory is the pitch. -->
  <header class="relative bg-black pt-24 md:pt-32 pb-8 md:pb-12 overflow-hidden">
    <div class="absolute inset-0 opacity-35">
      <img src="https://ik.imagekit.io/8i3ae7fac/cars-14.jpg?tr=w-1600,q-70,f-webp" alt="" class="w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/40 to-black"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-5 md:px-8 text-center">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-[11px] md:text-xs font-medium mb-4">Lussaro Collection · Miami</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold leading-[1.02] tracking-tight text-white text-balance">
        Miami's Most-Wanted Exotics<span class="text-[#c9a96e]"> — from $445/day</span>
      </h1>

      <!-- Trust chips — the whole pitch, scannable in one second -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-[13px] text-white/85"><span class="text-[#c9a96e]">★</span> 5.0 on Google</span>
        <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-[13px] text-white/85">Door-to-door delivery</span>
        <span class="inline-flex items-center rounded-full border border-white/15 bg-white/5 backdrop-blur px-4 py-1.5 text-[13px] text-white/85">Same-day booking</span>
      </div>

      <div class="mt-7 flex flex-row gap-2.5 max-w-md mx-auto">
        <a href="#fleet" class="cta-shine flex-1 inline-flex items-center justify-center bg-[#c9a96e] text-black px-3 py-3 md:px-5 md:py-3.5 rounded-full font-bold text-sm md:text-base whitespace-nowrap hover:bg-white transition-colors">See Cars &amp; Prices ↓</a>
        <a href="tel:+16452487305" data-cta="fleet_hero" data-call-inline class="call-pop flex-1 inline-flex items-center justify-center gap-1.5 bg-[#16a34a] text-white px-3 py-3 md:px-5 md:py-3.5 rounded-full font-semibold text-sm md:text-base whitespace-nowrap shadow-[0_8px_24px_rgba(22,163,74,0.5)] ring-1 ring-white/15 hover:bg-[#22c55e] transition-colors">
          <Phone className="w-4 h-4 shrink-0" />
          <span class="lg:hidden">Call Now</span>
          <span class="hidden lg:inline">Call (645) 248-7305</span>
        </a>
      </div>
    </div>
  </header>

  <!-- THE COLLECTION — identical to the homepage section (shared component);
       tighter top padding since it sits directly under the compact hero -->
  <FleetCollection id="fleet" pad="pt-8 pb-16 md:pt-12 md:pb-24" />

  <!-- WHAT'S INCLUDED -->
  <section class="bg-black py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-14">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Every Rental</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white">What's included</h2>
      </div>
      <div class="reveal grid sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
        {included.map((b) => (
          <div class="rounded-2xl border border-white/10 bg-[#0f0f0f] p-6">
            <h3 class="font-display text-lg font-semibold text-white mb-2">{b.t}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS — mirrors the homepage -->
  <section id="process" class="bg-[#0c0c0c] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-14">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">How It Works</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white">Booked in three steps.</h2>
      </div>
      <div class="reveal grid md:grid-cols-3 gap-8">
        {steps.map((s) => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full border border-[#c9a96e]/40 text-[#c9a96e] flex items-center justify-center mx-auto mb-5 font-display text-xl">{s.n}</div>
            <h3 class="font-display text-xl font-semibold text-white mb-2">{s.t}</h3>
            <p class="text-white/50 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-black border-t border-white/5 py-20 md:py-28">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="reveal mb-10 text-center">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Good to know</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight">Renting, answered</h2>
      </div>
      <div class="reveal divide-y divide-white/10 border-y border-white/10">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex items-center justify-between cursor-pointer list-none">
              <span class="font-display text-lg text-white pr-6">{f.q}</span>
              <span class="text-[#c9a96e] text-xl shrink-0 transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="text-white/60 leading-relaxed mt-3">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- RESERVE / LEAD FORM -->
  <section id="contact" class="bg-black py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-8">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight text-balance">Lock in your dates</h2>
        <p class="text-white/55 mt-4">Fastest on WhatsApp — or send your details and we'll confirm in minutes.</p>
        <a href="https://maps.app.goo.gl/9nEuwbuyZzhGTQscA" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 mt-4 text-sm text-white/55 hover:text-white transition"><span class="text-[#c9a96e]">★★★★★</span> 5.0 on Google — read reviews →</a>
      </div>
      <div class="reveal flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-10">
        <a href={wa} data-cta="fleet_reserve" target="_blank" rel="noopener noreferrer" class="flex-1 inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-black px-7 py-4 rounded-full font-semibold hover:bg-white transition">
          WhatsApp <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
        </a>
        <a href="tel:+16452487305" data-cta="fleet_reserve" class="flex-1 inline-flex items-center justify-center border border-white/20 text-white px-7 py-4 rounded-full font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">
          Call now
        </a>
      </div>
      <LeadForm client:visible />
    </div>
  </section>

  <CtaBand title={'Your Miami arrival,<br><span class="text-[#c9a96e]">unforgettable.</span>'} message={waMsg} />

  <StickyMobileCta />
  <Car3DViewer client:idle />
</Layout>

---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import { business, telHref, whatsappWith } from '@/data/business';
---
<Layout title="Page Not Found | Lussaro Collection" description="The page you were looking for could not be found.">
  <div class="min-h-screen bg-black text-white">
    <Nav />
    <section class="min-h-screen flex items-center justify-center px-6">
      <div class="max-w-xl w-full text-center">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs font-medium mb-6">Lussaro Collection</p>
        <h1 class="font-display text-7xl md:text-9xl font-bold leading-none tracking-tight">404</h1>
        <div class="h-px w-16 bg-[#c9a96e]/50 mx-auto my-8"></div>
        <h2 class="font-display text-2xl md:text-3xl font-semibold mb-4">This road doesn’t exist</h2>
        <p class="text-white/60 leading-relaxed mb-10">The page you were looking for could not be found. It may have moved or never existed.</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto">
          <a href="/" class="flex-1 bg-[#c9a96e] text-black px-8 py-3.5 rounded-full text-sm font-semibold hover:bg-white transition">Back to Home</a>
          <a href={business.whatsapp} data-cta="404" target="_blank" rel="noopener noreferrer" class="flex-1 border border-white/20 text-white px-8 py-3.5 rounded-full text-sm font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">Contact Us</a>
        </div>
      </div>
    </section>
  </div>
</Layout>

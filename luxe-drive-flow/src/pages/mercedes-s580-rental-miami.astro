---
// /mercedes-s580-rental-miami — paid-traffic funnel for the Mercedes-Benz S580.
//
// THIS IS THE MERCEDES-BENZ S580 AT $399, NOT THE MAYBACH S580 AT $899.
// fleet.js carries the same warning on both entries because the two get
// confused constantly. The marque leads everywhere on this page, and the page
// says plainly which car it is not — that confusion is a live support cost, so
// resolving it is part of the job rather than a footnote.
//
// The Maybach S580 is already covered by /maybach-rental-miami. This page owns
// `mercedes s class rental miami`, which keywords.csv had pointed at the car
// page, and must not drift onto the Maybach terms.
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import SmartLink from '@/components/site/SmartLink.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import BookingRequestCard from '@/components/booking/BookingRequestCard.jsx';
import CarGallery from '@/components/fleet/CarGallery.jsx';
import { cars } from '@/data/cars';
import { rentalTerms, deliveryEachWaySummary } from '@/data/rental-terms';
import { reviews, averageRating, reviewCount } from '@/data/reviews';
import { business, telHref, whatsappWith } from '@/data/business';

const SITE = 'https://www.lussarocollection.com';

const s580 = cars.find((c) => c.slug === 'mercedes-s580');
const maybachS580 = cars.find((c) => c.slug === 'mercedes-maybach-s580');
const fullName = `${s580.make} ${s580.name}`;
const priceDisplay = s580.price.toLocaleString('en-US');
const onSale = s580.wasPrice > s580.price;

const milesPerDay = s580.miles ?? rentalTerms.mileage.includedPerDay;
const overage = rentalTerms.mileage.overagePerMile;
const tiers = s580.discountTiers ?? rentalTerms.discountTiers;
const weekPct = tiers.reduce((acc, t) => (7 >= t.days ? t.pct : acc), 0);
const miamiDelivery = rentalTerms.delivery.find((d) => d.area === 'Miami');

// No review names this car. The two below carry no vehicle attribution at all,
// so they are shown as what they are — comments on the service — and the
// Product schema below deliberately carries NO aggregateRating or review.
// Rating markup describing a product the on-page quotes do not describe is the
// structured-data spam risk the car-page template warns about.
const serviceReviews = reviews.filter((r) => !r.car);

const galleryImages = s580.images.filter((i) => i.startsWith('/cars/')).slice(0, 8);

const waMessage = `Hi, I'd like to rent the Mercedes-Benz S580 in Miami. Which dates do you have open?`;
const wa = whatsappWith(waMessage, { car: fullName, page: '/mercedes-s580-rental-miami' });

const objections = [
  {
    q: 'Is this the Maybach S580?',
    a: `No. This is the ${fullName} at $${priceDisplay} a day. The Mercedes-Maybach S580 is a different car — longer, four seats instead of ${s580.seats}, and $${maybachS580.price.toLocaleString('en-US')} a day. We rent both, and they are easy to confuse because the badge reads the same.`,
  },
  {
    q: 'Is the price negotiable?',
    a: `Our price is published, and it is the same number for you as for anyone. $${priceDisplay} a day is what you will be quoted on the phone, in a message, or on this page.`,
  },
  {
    q: 'What happens if I go over the included miles?',
    a: `${milesPerDay} miles a day are included and pooled across the whole booking, so three days is ${milesPerDay * 3} miles in total rather than a daily cap.${overage ? ` Anything past that is $${overage} a mile, and it can come out of your deposit.` : ''} Only the total showing at return is counted.`,
  },
  {
    q: 'What is the deposit, and when do I get it back?',
    a: `${rentalTerms.deposit.display}, flat on every vehicle — the same on this car as on the Ferrari. ${rentalTerms.deposit.note}`,
  },
  {
    q: 'Do I need my own insurance?',
    a: `${rentalTerms.insurance.summary} You also need to be ${rentalTerms.minimumAge} or over with a valid driver's license. If coverage has to be arranged, the rate is confirmed in writing before you book.`,
  },
  {
    q: 'Can you deliver it?',
    a: `Delivery ${deliveryEachWaySummary}. Collection at the end is charged separately, so budget roughly double for a round trip. Hotels, Brickell addresses, South Beach and both airports are routine.`,
  },
];

// No aggregateRating here, on purpose. See the comment above serviceReviews.
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: `${fullName} Rental — Miami`,
  description: `Rent the ${fullName} in Miami at $${priceDisplay} a day. ${s580.power} hp, ${s580.zeroToSixty} to 60, delivered across Miami.`,
  image: galleryImages.map((i) => `${SITE}${i}`),
  brand: { '@type': 'Brand', name: s580.make },
  sku: `LC-${s580.slug.toUpperCase()}-LP`,
  offers: {
    '@type': 'Offer',
    url: `${SITE}/mercedes-s580-rental-miami`,
    price: s580.price.toFixed(2),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    seller: { '@id': `${SITE}/#business` },
    eligibleDuration: { '@type': 'QuantitativeValue', value: 1, unitCode: 'DAY' },
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Horsepower', value: s580.power, unitText: 'hp' },
    { '@type': 'PropertyValue', name: '0–60 mph', value: parseFloat(s580.zeroToSixty), unitCode: 'SEC', unitText: 'seconds' },
    { '@type': 'PropertyValue', name: 'Included mileage', value: milesPerDay, unitCode: 'SMI', unitText: 'miles per day' },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: objections.map((o) => ({
    '@type': 'Question',
    name: o.q,
    acceptedAnswer: { '@type': 'Answer', text: o.a },
  })),
};
---
<Layout
  title="Mercedes-Benz S580 Rental Miami | Lussaro Collection"
  description={`Rent the ${fullName} in Miami at $${priceDisplay} a day — ${s580.power} hp and ${s580.zeroToSixty} to 60. ${milesPerDay} miles a day included, ${rentalTerms.deposit.display} refundable deposit, delivered across Miami.`}
  breadcrumbName="Mercedes-Benz S580 Rental Miami"
  schema={[productSchema, faqSchema]}
>
  <Nav />

  {/* ============ 1. HOOK ============================================ */}
  <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-10 md:pb-14">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8">
      <h1 class="font-display text-center text-[2rem] leading-[1.08] md:text-5xl lg:text-[3.4rem] font-bold tracking-tight text-white uppercase">
        Mercedes-Benz S580 Rental Miami
      </h1>

      <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] gap-8 lg:gap-12 items-start mt-9 md:mt-12">
        <div>
          <CarGallery images={galleryImages} name={fullName} slug="g-s580-landing" client:load />
        </div>

        <div class="text-center lg:text-left lg:pt-4">
          <p class="text-white/55 text-sm uppercase tracking-[0.2em]">Starting at</p>
          <p class="font-display text-white text-6xl md:text-7xl font-bold tracking-tight mt-2">
            ${priceDisplay}
            <span class="text-white/45 text-xl font-sans font-normal tracking-normal"> / day</span>
          </p>
          {onSale && (
            <p class="text-white/50 text-sm mt-1.5">
              <span class="line-through">${s580.wasPrice.toLocaleString('en-US')}</span>
              <span aria-hidden="true"> · </span>${(s580.wasPrice - s580.price).toLocaleString('en-US')} off the standard rate
            </p>
          )}

          <ul class="mt-6 space-y-1.5 text-white/70 text-[15px] leading-relaxed list-none p-0">
            <li>{milesPerDay} miles per day included</li>
            {overage && <li>${overage} per additional mile</li>}
            <li>{rentalTerms.deposit.display} refundable security deposit</li>
            <li>{rentalTerms.minimumAge}+ with qualifying insurance</li>
          </ul>

          <div class="mt-8 pt-7 border-t border-white/10 grid grid-cols-2 gap-6">
            <div>
              <p class="text-white/55 text-[11px] uppercase tracking-[0.16em]">Power</p>
              <p class="font-display text-white text-3xl font-bold mt-1.5">{s580.power}<span class="text-lg text-white/55"> hp</span></p>
              <p class="text-white/55 text-sm mt-0.5">Twin-turbo V8, mild hybrid</p>
            </div>
            <div>
              <p class="text-white/55 text-[11px] uppercase tracking-[0.16em]">0–60</p>
              <p class="font-display text-white text-3xl font-bold mt-1.5">{s580.zeroToSixty}</p>
              <p class="text-white/55 text-sm mt-0.5">{s580.seats} seats</p>
            </div>
          </div>

          <div class="mt-8 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center lg:justify-start">
            <a
              href={wa}
              data-cta="s580_hero"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] hover:text-white transition sm:flex-1 lg:flex-none"
            >
              Message us <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
            </a>
            <a
              href={telHref}
              data-cta="s580_hero"
              data-call-inline
              class="inline-flex items-center justify-center border border-white/25 text-white px-7 py-4 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition sm:flex-1 lg:flex-none"
            >
              Call {business.phoneDisplayShort}
            </a>
          </div>

          <p class="text-white/50 text-sm mt-5">
            <span class="text-[#ff1516]" aria-hidden="true">★</span> {averageRating.toFixed(1)} on Google
            <span aria-hidden="true"> · </span>Owner operated
            <span aria-hidden="true"> · </span>Replies usually take minutes
          </p>
        </div>
      </div>
    </div>
  </header>

  {/* ============ 2. THE ASK ========================================== */}
  <section id="quote" class="bg-[#ffffff] py-16 md:py-24">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[1fr_minmax(0,460px)] gap-10 lg:gap-14 items-center">
        <div class="text-[#0a0a0a]">
          <h2 class="font-display text-3xl md:text-[2.75rem] leading-[1.1] font-bold tracking-tight uppercase">
            Reserve the S580
          </h2>
          <p class="text-[#0a0a0a]/70 text-lg leading-relaxed mt-4 max-w-lg">
            Send us your name and number and we will come back with what is open, the total, and
            delivery if you want it brought to you. No deposit to ask.
          </p>
          <ul class="mt-7 space-y-2.5 list-none p-0 max-w-lg">
            {[
              'The published rate, with any multi-day discount already applied',
              'Delivery quoted up front, not added at handover',
              `The same ${rentalTerms.deposit.display} deposit as every other car we rent`,
            ].map((line) => (
              <li class="flex gap-3 text-[#0a0a0a]/75 text-[15px] leading-relaxed">
                <span aria-hidden="true" class="text-[#e00e10] font-bold">✓</span>{line}
              </li>
            ))}
          </ul>
          <p class="mt-7 text-[#0a0a0a]/70 text-sm">
            Or call <a href={telHref} data-cta="s580_form_band" class="text-[#e00e10] font-semibold underline underline-offset-4">{business.phoneDisplay}</a>
          </p>
        </div>

        <div class="rounded-[30px] bg-[#0a0a0a] p-5 md:p-7 shadow-[0_26px_70px_rgba(0,0,0,0.25)]">
          <BookingRequestCard
            client:visible
            pricePerDay={s580.price}
            carName={fullName}
            tiers={tiers}
            milesPerDay={milesPerDay}
            allowDates={false}
          />
        </div>
      </div>
    </div>
  </section>

  {/* ============ 3. WHICH S580 ========================================
      The highest-value section on this page. Two cars wear the same badge
      at a $500 difference, and someone arriving from an ad does not know
      which one they are looking at. */}
  <section class="bg-[#0a0a0a] py-16 md:py-24">
    <div class="max-w-[1240px] mx-auto px-5 md:px-8">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-white">
        There are two S580s. This is the {s580.make}.
      </h2>
      <p class="text-white/60 mt-3 max-w-2xl leading-relaxed">
        The badge reads the same on both and the engine is the same V8. Everything else is
        different, including $
        {(maybachS580.price - s580.price).toLocaleString('en-US')} a day.
      </p>

      <div class="grid md:grid-cols-2 gap-6 mt-10">
        {[
          { car: s580, tag: 'This page', note: `The S-Class you drive yourself. ${s580.seats} seats, the quickest of the two, and the lowest daily rate in the fleet.` },
          { car: maybachS580, tag: 'The other one', note: `Longer, with ${maybachS580.seats} seats instead of ${s580.seats} and a reclining rear bench behind double-glazed glass. Booked to be driven in, not to drive.` },
        ].map(({ car, tag, note }) => (
          <article class="rounded-[22px] bg-[#0f0f0f] border border-white/10 p-6 md:p-7">
            <p class="text-[#ff1516] text-[11px] uppercase tracking-[0.18em] font-medium">{tag}</p>
            <h3 class="font-display text-2xl font-bold text-white mt-2">{car.make} {car.name}</h3>
            <p class="text-white/60 leading-relaxed mt-3 text-[15px]">{note}</p>
            <p class="text-white/55 text-sm mt-5">
              {car.power} hp<span aria-hidden="true"> · </span>{car.zeroToSixty} to 60
              <span aria-hidden="true"> · </span><strong class="text-white">${car.price.toLocaleString('en-US')} / day</strong>
            </p>
          </article>
        ))}
      </div>

      <p class="text-white/60 leading-relaxed mt-8 max-w-3xl">
        We wrote the two out side by side, with what each one is actually for:{' '}
        <SmartLink href="/blog/mercedes-s580-vs-maybach-s580-rental-miami" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition">Mercedes S580 vs Maybach S580</SmartLink>. The Maybach has its own page at{' '}
        <SmartLink href="/maybach-rental-miami" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition">Maybach rental Miami</SmartLink>, and
        this car's full specification sits on its{' '}
        <SmartLink href={`/cars/${s580.slug}`} class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition">own page</SmartLink>.
      </p>
    </div>
  </section>

  {/* ============ 4. PROOF ============================================
      No review names this car, so none is presented as though it does.
      These two carry no vehicle attribution and are shown as comments on
      the service. The Product schema above carries no rating for the same
      reason. */}
  {serviceReviews.length > 0 && (
    <section class="bg-[#ffffff] text-[#0a0a0a] py-16 md:py-24">
      <div class="max-w-[1240px] mx-auto px-5 md:px-8">
        <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight">
          What people say about the service
        </h2>
        <p class="text-[#0a0a0a]/60 mt-3">
          {averageRating.toFixed(1)} across every review we have.
        </p>
        <div class="grid md:grid-cols-2 gap-6 mt-9">
          {serviceReviews.slice(0, 2).map((r) => (
            <figure class="rounded-[22px] border border-[#0a0a0a]/12 p-6">
              <div class="text-[#e00e10]" aria-hidden="true">★★★★★</div>
              <blockquote class="text-[#0a0a0a]/70 leading-relaxed mt-3 text-[15px]">{r.text}</blockquote>
              <figcaption class="text-[#0a0a0a]/60 text-xs mt-4">{r.name}</figcaption>
            </figure>
          ))}
        </div>
        <p class="text-[#0a0a0a]/65 text-sm mt-7">
          <SmartLink href="/reviews" class="text-[#e00e10] underline underline-offset-4">Read all {reviewCount} reviews</SmartLink>
        </p>
      </div>
    </section>
  )}

  {/* ============ 5. OBJECTIONS ======================================= */}
  <section class="bg-[#0a0a0a] py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight text-white">
        The questions worth asking
      </h2>
      <div class="mt-10 divide-y divide-white/10">
        {objections.map((o) => (
          <div class="py-6 first:pt-0">
            <h3 class="font-display text-lg md:text-xl font-semibold text-white">{o.q}</h3>
            <p class="text-white/65 leading-relaxed mt-2.5">{o.a}</p>
          </div>
        ))}
      </div>
      <p class="text-white/60 leading-relaxed mt-10">
        How we keep the cars between rentals is written up{' '}
        <SmartLink href="/blog/well-kept-exotic-car-rental-miami" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition">here</SmartLink>, and full terms sit on{' '}
        <SmartLink href="/pricing" class="text-white underline decoration-white/30 underline-offset-4 hover:decoration-white transition">the pricing page</SmartLink>.
      </p>
    </div>
  </section>

  <CtaBand
    car={fullName}
    page="/mercedes-s580-rental-miami"
    message={waMessage}
    title={'Open the door and check.\nThat is the whole <span class="text-[#ff1516]">argument</span>'}
    subtitle={`The Mercedes-Benz S580 at $${priceDisplay} a day, delivered across Miami. Replies usually take minutes.`}
  />
  <StickyMobileCta message={waMessage} car={fullName} page="/mercedes-s580-rental-miami" />
</Layout>

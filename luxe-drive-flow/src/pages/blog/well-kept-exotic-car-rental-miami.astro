const PUBLISHED_ISO = '2026-10-07';
const UPDATED_ISO = '2026-10-07';
const published = 'October 7, 2026';
const updated = 'October 7, 2026';
const readingMinutes = 7;

// Two constraints met at once: no apostrophe ("Don't" becomes an HTML entity

    q: 'What is the deposit and mileage on a Lussaro rental?',
    a: `${deposit.display} flat on every car, returned after the car is inspected on its way back. Mileage is ${perDay} miles a day, pooled across the rental rather than capped daily, so three days is ${perDay * 3} miles in total, spent however you like.`,
  },
];

const authorSchema = {
  '@context': 'https://schema.org',

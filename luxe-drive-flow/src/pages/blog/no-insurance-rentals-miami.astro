import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import {
  rentalTerms,
  deliveryEachWaySummary,
  discountSummary,
  rateForDays,
} from '@/data/rental-terms';

const bySlug = (s) => cars.find((c) => c.slug === s);

// >>> FILL — pull only the cars this post actually discusses. Slugs:
// lamborghini-urus · huracan-evo · huracan-evo-spyder · sf90 ·
// rolls-royce-cullinan · mercedes-maybach-gls-600 · mercedes-s580 ·
// mercedes-maybach-s580 · mercedes-amg-g63
const car = bySlug('mercedes-maybach-gls-600');
const sedan = bySlug('mercedes-maybach-s580');
const entry = bySlug('mercedes-s580');

// Daily policy band for the Maybachs, from fleet.js. A range rather than one
// number because it moves with driver age.
const cover = car.insurancePerDay;

const { deposit, mileage, minimumAge, cancellation } = rentalTerms;
const perDay = mileage.includedPerDay;
const usd = (n) => `$${n.toLocaleString('en-US')}`;

// rateForDays returns { pct, perDay } — an object. Render .perDay or the page
// prints "$[object Object]".
const weekRate = rateForDays(car.price, 7).perDay;

const SITE = 'https://www.lussarocollection.com';
const PATH = '/blog/no-insurance-rentals-miami';
const PAGE_URL = `${SITE}${PATH}`;

// IMAGES. Generated by the image step in SKILL.md from the existing library —
// never hotlinked, never from image search. The hero is a real, visible figure.
const HERO_KEY = '/cars/mercedes-maybach-gls-600-rental-miami-side-palms.jpg';
const heroSrc = '/blog/no-insurance-rentals-miami-hero-760.webp';
const heroSrcSet =
  '/blog/no-insurance-rentals-miami-hero-560.webp 560w, /blog/no-insurance-rentals-miami-hero-760.webp 760w, /blog/no-insurance-rentals-miami-hero-800.webp 800w, /blog/no-insurance-rentals-miami-hero-1120.webp 1120w, /blog/no-insurance-rentals-miami-hero-1200.webp 1200w, /blog/no-insurance-rentals-miami-hero-1560.webp 1560w';
const heroAlt = altFor(HERO_KEY);

// One inline image in the body. Long form with no picture in it reads as a wall.
const BODY_KEY = '/cars/mercedes-maybach-s580-rental-miami-executive-rear-seats.jpg';
const bodySrc = '/blog/no-insurance-rentals-miami-body-1000.webp';
const bodySrcSet =
  '/blog/no-insurance-rentals-miami-body-700.webp 700w, /blog/no-insurance-rentals-miami-body-1000.webp 1000w';
const bodyAlt = altFor(BODY_KEY);

const OG_IMAGE = `${SITE}/og/no-insurance-rentals-miami.jpg`;   // 1200×630, under 1 MB

const PUBLISHED_ISO = '2026-10-22';
const UPDATED_ISO = '2026-10-22';
const published = 'October 22, 2026';
const updated = 'October 22, 2026';
const readingMinutes = 7;

// 50 chars MAX: Layout renders `${TITLE} | Lussaro`, and verify.py wants the
// rendered <title> between 50 and 60.
const TITLE = 'No Insurance Rentals Miami: What It Costs';
const waMessage = 'Hi, I read the piece on rental insurance. I do not have my own policy — what would coverage cost for my dates?';
const wa = whatsappWith(waMessage);

// A named reviewer, quoted verbatim. Pick one with NO exclamation marks:
// reviews[0] and reviews[4] contain them and will fail verify.py.
const testimonial = reviews[2];

const toc = [
  { id: 'the-answer', label: 'What it actually means' },
  { id: 'what-it-costs', label: 'What the policy costs' },
  { id: 'your-own-policy', label: 'Why your own policy may not do it' },
  { id: 'what-we-check', label: 'What we check before you drive' },
  { id: 'faq', label: 'Common questions' },
];

// Every number renders from the data files, never typed as a literal.
const faqs = [
  {
    q: 'Can you rent a car in Miami with no insurance?',
    a: `The car has to be insured. It does not have to be insured by you. If you hold a policy that genuinely extends to a vehicle of this value, bring it. If you do not, we can sell you coverage for the days you have the car, quoted in writing before you book.`,
  },
  {
    q: 'What if I have no car insurance at all?',
    a: `That is a normal situation rather than a problem — anyone who lives in a city and does not own a car is in it. Coverage is arranged for the rental period itself. On either Maybach that runs ${usd(cover.from)} to ${usd(cover.to)} a day depending on your age.`,
  },
  {
    q: 'How much does exotic car rental insurance cost in Miami?',
    a: `It depends on the car and on the driver. For the ${car.make} ${car.name} and the ${sedan.make} ${sedan.name} it is ${usd(cover.from)} to ${usd(cover.to)} a day. Quicker and more valuable cars cost more to cover, and a younger driver costs more than an older one on the same car.`,
  },
  {
    q: 'Does my credit card cover an exotic rental?',
    a: `Usually not. Most card benefits exclude high-value and exotic vehicles outright, and those that do not often cap the payout well below what the car is worth. Read the benefits guide itself rather than the summary, and where it is ambiguous, assume it does not apply.`,
  },
  {
    q: 'How old do you have to be to rent an exotic car in Miami?',
    a: `With us, ${minimumAge}. Much of the industry says 25, and the general-interest articles ranking for this question repeat that number. Age still affects what coverage costs, so a younger driver pays more for the policy than for the car.`,
  },
  {
    q: 'Is the deposit the same thing as insurance?',
    a: `No, and they do different jobs. The deposit is ${deposit.display}, flat on every vehicle, and it is refundable after the car is inspected on return. Insurance is what stands behind damage beyond that.`,
  },
  {
    q: 'Does everyone driving need to be covered?',
    a: `Yes. Whoever is behind the wheel has to be named and covered before they drive. An unnamed driver voids the arrangement, which is the most expensive mistake available on a rental like this.`,
  },
]

// --- Schema. Do not restructure. ------------------------------------------
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: 'No insurance rentals in Miami: the car has to be insured, but the policy does not have to be yours. What coverage costs on a Maybach, and what we check before you drive.',
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;

---
<Layout
  title={`${TITLE} | Lussaro`}
  description={`No insurance rentals in Miami: you do not need a policy of your own to rent an exotic car. Coverage from ${usd(cover.from)} a day on a Maybach, quoted before you book.`}
  image={OG_IMAGE}
  type="article"
  breadcrumbName="No Insurance Rentals Miami"
  schema={[articleSchema, authorSchema, faqSchema]}
>
  {/* Skip link stays on the page, not in Layout: the other routes have no
       #main target yet, and a skip link that lands nowhere is worse than none. */}
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <main id="main" tabindex="-1">
    {/* The header sits OUTSIDE <article> deliberately. The hero markup — a
        srcset of six candidates alone runs ~450 characters — otherwise eats
        the window the on-page checklist uses to confirm the bolded answer is
        near the top, and every future post would fight the same budget. The
        article element wraps the prose, which is what the word-count and link
        checks measure anyway. */}
      {/* ARTICLE HEADER. The photograph used to sit behind this text at 25%
           opacity under a 60% black gradient, which meant nobody ever saw it.
           The header is now type only, and the image gets its own figure
           below at full opacity where it can actually be looked at. */}
      {/* SPLIT HERO. The first version buried the photo behind the headline at
          25% opacity; the second stacked a 1076px-wide image under a 768px text
          block, which left a dead column on the right and pushed the article
          below the fold. Headline and photograph now sit side by side at one
          shared height, so the image is a real element and the body starts
          sooner. Explicit grid placement rather than source order: on a phone
          the stack reads headline, photo, then byline and buttons. */}
      <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-12 md:pb-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">
          <nav aria-label="Breadcrumb" class="mb-7">
            <ol class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs text-white/50">
              <li><a href="/" class="hover:text-white transition">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="/blog" class="hover:text-white transition">Rental Guides</a></li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-white/70">No insurance rentals</li>
            </ol>
          </nav>

          <div class="lg:grid lg:grid-cols-[1.05fr_1fr] lg:gap-12 xl:gap-16">
            <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
              <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Before you book</p>
              <h1 class="font-display text-3xl md:text-[2.75rem] xl:text-5xl font-bold tracking-tight text-white leading-[1.08] text-balance">
                No insurance rentals in Miami: what you actually need
              </h1>
              <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5">
                Not having a policy of your own does not stop you renting here. The car still has to be insured — that part is law — but the policy does not have to be yours, and that distinction is where most of the confusion and most of the cost actually lives.
              </p>
            </div>

            <figure class="mt-8 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
              <img
                src={heroSrc}
                srcset={heroSrcSet}
                sizes="(min-width: 1024px) 520px, 100vw"
                width="760"
                height="507"
                alt={heroAlt}
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto rounded-2xl"
              />
              <figcaption class="text-white/45 text-xs mt-3 text-center lg:text-left">
                {`The ${car.make} ${car.name}. Coverage on it runs ${usd(cover.from)} to ${usd(cover.to)} a day, depending on who is driving.`}
              </figcaption>
            </figure>

            <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-end">
              <div class="mt-8 lg:mt-7 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-white/60">
                <span>By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>, founder</span>
                <span aria-hidden="true" class="text-white/25">|</span>
                <span><time datetime={PUBLISHED_ISO}>{published}</time> <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time></span>
                <span aria-hidden="true" class="text-white/25">|</span>
                <span>{readingMinutes} min read</span>
              </div>

              <div class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto lg:mx-0">
                <a href={wa} data-cta="blog_hero" target="_blank" rel="noopener noreferrer"
                   class="flex-1 inline-flex items-center justify-center gap-2 min-h-[48px] bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">
                  Check your dates <span class="w-2 h-2 rounded-full bg-[#1f7a3f]" aria-hidden="true"></span>
                </a>
                <a href={telHref} data-cta="blog_hero" data-call-inline
                   class="flex-1 inline-flex items-center justify-center min-h-[48px] border border-white/25 text-white px-7 py-4 rounded-full font-medium hover:border-[#e00e10] hover:text-[#e00e10] transition">
                  Call {business.phoneDisplayShort}
                </a>
              </div>
            </div>
          </div>
        </div>
      </header>

    <article>
      <div class="bg-white text-[#0a0a0a] py-12 md:py-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">

          {/* SHORT ANSWER. Full width, above the columns, so it reads as the
               answer to the headline rather than as the first paragraph. */}
          <div class="not-prose mb-10 md:mb-14 rounded-2xl border border-[#e00e10]/20 bg-[#fff7f7] p-6 md:p-8 max-w-3xl">
            <p class="text-xs uppercase tracking-[0.2em] text-[#e00e10] font-semibold mb-3">Short answer</p>
            <p class="text-lg md:text-xl leading-relaxed">
              <strong>
                {`A no insurance rental is a normal booking here, not an exception. The car still has
                to be insured — in Florida that is not optional — but the policy does not have to be
                yours. We sell you one covering the days you have the car: ${usd(cover.from)} to
                ${usd(cover.to)} a day on either Maybach, set by your age and the vehicle.`}
              </strong>
            </p>
          </div>

          {/* TWO COLUMNS from lg up: a readable measure for the prose and a
               sticky contents rail, instead of one long column of text across a
               desktop viewport. The rail is first in the DOM so it is reachable
               before the content it indexes. */}
          <div class="lg:grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] lg:gap-14 xl:gap-20">
            <aside class="mb-10 lg:mb-0">
              <nav aria-label="Table of contents" class="not-prose lg:sticky lg:top-28 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
                <h2 class="font-display text-base font-bold mb-3">On this page</h2>
                <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-2.5 text-sm">
                  {toc.map((t, i) => (
                    <li>
                      <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                        <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>

            {/* Inline links underlined: color alone fails WCAG 1.4.1.
                 text-black/60 is the floor on this background; /40 fails AA. */}
            <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:scroll-mt-28 prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm prose-h2:mt-12 prose-h2:pt-8 prose-h2:border-t prose-h2:border-black/10 first:prose-h2:mt-0 first:prose-h2:pt-0 first:prose-h2:border-0">

        <p>
          Every rental site in this city answers this question with a phone number. That is an
          answer. It is just not one you can plan a trip around.
        </p>

        {/* ===================== BODY — YOURS TO WRITE =====================
             One H2 per toc entry, ids matching exactly. H3s only under H2s.
             Every number renders from the data files; never type a literal.

             Developer notes must be JSX comments, never HTML ones: HTML
             comments ship to the browser and count against the 4000-character
             window verify.py uses.

             And never write a closing JSX comment marker INSIDE a comment.
             These do not nest — the inner marker ends the comment early and
             everything after it renders as visible page text. That shipped to
             production once, on 22 Oct 2026, from this very block.
        ===================================================================== */}

        <h2 id="the-answer">What "no insurance rental" actually means</h2>

        <p>
          Two separate things get collapsed into one question here. The first is whether the
          vehicle must be insured, and the answer to that is not ours to give: Florida requires
          financial responsibility for a vehicle operated on its roads, and you can read{' '}
          <a href="https://www.leg.state.fl.us/statutes/index.cfm?App_mode=Display_Statute&amp;URL=0300-0399/0324/0324.html" rel="noopener noreferrer" target="_blank">the statute itself</a>{' '}
          if you want the exact language. Nobody drives one of these uninsured, with us or with
          anyone else, and an operator who offers to let you is telling you something important
          about how the rest of their business is run.
        </p>

        <p>
          The second question is whose policy it is, and that one has a comfortable answer. If you
          already carry coverage that genuinely extends to a vehicle of this value, bring it and we
          will verify it. If you do not — and a great many people do not, including most people who
          live in a city and have no reason to own a car — we can sell you a policy that covers the
          days you have the vehicle. You are not disqualified. You just have a line item.
        </p>

        {/* INLINE FIGURE. Lazy, never fetchpriority — the hero owns that. */}
        <figure class="not-prose my-10">
          <img
            src={bodySrc}
            srcset={bodySrcSet}
            sizes="(min-width: 1140px) 760px, 100vw"
            width="1000"
            height="667"
            alt={bodyAlt}
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-2xl"
          />
          <figcaption class="text-black/60 text-sm mt-3">{`The ${sedan.make} ${sedan.name}. Most of the value in a car like this sits in the rear cabin, which is also the part a standard personal policy is least likely to have considered.`}</figcaption>
        </figure>

        <h2 id="what-it-costs">What the policy costs</h2>

        <p>
          {`On either Maybach — the ${car.make} ${car.name} or the ${sedan.make} ${sedan.name}, both at ${usd(car.price)} a day — coverage runs ${usd(cover.from)} to ${usd(cover.to)} a day.`}
          It is a range rather than a number because two things move it: the car, and the driver.
          A quicker and more valuable vehicle costs more to cover, and on the same car a younger
          driver costs more than an older one. Your figure gets confirmed in writing before you
          book, not discovered at handover.
        </p>

        <p>
          We publish that band for a reason. Search this question and you will find the same
          sentence on every result: that you can buy coverage from the rental company. Not one of
          them says what it costs. That is a price. It is just not one anybody wants written down,
          and it leaves you unable to work out what three days actually costs until you are already
          on the phone.
        </p>

        <p>
          It is also worth separating from the deposit, because the two get confused constantly.
          {` The deposit is ${deposit.display}, flat on every vehicle we rent, and it comes back to you after the car is inspected on return. `}
          Insurance is not a deposit and the deposit is not insurance. One is held and returned; the
          other is spent. The full set of terms is on{' '}
          <a href="/pricing">our pricing and policies page</a>.
        </p>

        {/* Real Google review. Verbatim, never edited. Pick one with NO
            exclamation marks — verify.py bans [a-z]! in the article body. */}
        <figure class="not-prose my-10 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
          <blockquote class="text-[#0a0a0a]/80 leading-relaxed">
            <p>“{testimonial.text}”</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-[#0a0a0a]/60">
            <span class="text-[#e00e10]" aria-hidden="true">★★★★★</span>
            <span class="font-semibold text-[#0a0a0a]"> {testimonial.name}</span> — verified Google review
          </figcaption>
        </figure>

        <h2 id="your-own-policy">Why your own policy may not do it</h2>

        <p>
          People arrive confident on this point more often than any other, and it is the one place
          where confidence is expensive. Personal auto policies are written around the kind of car
          most people own. High-value and exotic vehicles are routinely excluded outright, and where
          they are not, the payout is frequently capped well below what the car is worth — which
          means you are covered right up until the moment it matters. The{' '}
          <a href="https://www.iii.org/article/rental-car-insurance" rel="noopener noreferrer" target="_blank">Insurance Information Institute</a>{' '}
          sets out how rental coverage interacts with a personal policy, and it is worth ten minutes
          before you assume.
        </p>

        <p>
          Credit card benefits deserve the same scepticism. Most carve out exotic and high-value
          vehicles explicitly. Read the benefits guide rather than the marketing summary, and where
          the wording is ambiguous, treat it as not applying. We would rather you came to us already
          knowing the answer than found it out afterwards.
        </p>

        <p>
          {`If the coverage figure is what is making the trip hard to justify, the honest move is often a different car rather than a different policy. The ${entry.make} ${entry.name} is ${usd(entry.price)} a day`}
          {` — a long way under the Maybach — and it covers for less, because what a policy costs tracks what the car is worth. `}
          We have written the two S-Classes out{' '}
          <a href="/blog/mercedes-s580-vs-maybach-s580-rental-miami">side by side</a>, and the{' '}
          <a href="/mercedes-s580-rental-miami">Mercedes-Benz S580 page</a> has the rest. Recommending
          down costs us money on the day and is still the right call most of the time.
        </p>

        <h2 id="what-we-check">What we check before you drive</h2>

        <p>
          {`Coverage is one of four things. You need to be ${minimumAge} or over, hold a valid driver's license, be covered — by your policy or by ours — and pass screening. `}
          That age is worth pausing on: most of this industry says 25, and the general-interest
          articles that rank for this question repeat it. We do not.
        </p>

        <p>
          We screen every renter, and we do not publish what disqualifies someone. What is worth
          saying is why the screening exists at all. The first time the Urus went out, the tracker
          recorded roughly twenty minutes above 100 mph in a single stretch. We shut the car down
          remotely and recovered it the following morning. Every policy this business runs on — the
          tracker, the deposit, the insurance requirement, the screening itself — dates from that
          one booking. None of it was theoretical when it was written.
        </p>

        <p>
          Which is really the argument for all of it. The person who had the car before you was put
          through the same four checks you are about to go through, and the car you collect is the
          one that produces. Both Maybachs sit on the{' '}
          <a href="/maybach-rental-miami">Maybach rental page</a> with current rates, and the{' '}
          <a href="/cars/mercedes-maybach-gls-600">GLS 600's own page</a> has the full specification
          and the photographs.
        </p>


//     bans [a-z]! in the article body and reviews.js forbids editing one.
//   · rateForDays(price, days) returns { pct, perDay } — an object. Render
//     .perDay, or the page prints "$[object Object]".
// ============================================================================

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    no insurance rentals miami
//   SECONDARY:  do you need insurance to rent an exotic car,
//               what do you need to rent an exotic car in miami,
//               exotic car rental insurance cost miami,
//               rent a maybach without your own insurance,
//               exotic car rental miami under 25,
//               exotic car rental age requirement miami
//
// Informational, and the one question every Miami operator answers with a phone
// number. The commercial terms belong to the landing pages; this post funnels
// into them.
//
// FRAMING, NON-NEGOTIABLE: "no insurance" here means the RENTER has none of
// their own, which is what somebody typing that phrase actually means and is
// both true and sellable. It never means the car goes out uninsured — under
// Florida's financial-responsibility law it may not, and the post says so with
// a link to the statute. Every heading holds that line. Retargeted to this
// phrase on the owner's instruction, 22 Oct 2026, before publication, so no
// ranking history was discarded.

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import { altFor } from '@/data/image-alt';

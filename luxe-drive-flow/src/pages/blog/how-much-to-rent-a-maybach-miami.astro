---
// How much to rent a Maybach in Miami. Rates, miles, deposit, delivery,
// insurance and the chauffeur hour render from fleet.js, cars.js and
// rental-terms.js. The draft copy is the body; do not pad it.

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    how much to rent a maybach
//   SECONDARY:  how much is it to rent a maybach,
//               how much does it cost to rent a maybach,
//               how much to rent a maybach for a day,
//               maybach rental price, maybach suv rental
//   /maybach-rental-miami keeps the commercial "maybach rental miami".

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import BlogBookingCta from '@/components/blog/BlogBookingCta.astro';
import { altFor } from '@/data/image-alt';
import { cars } from '@/data/cars';
import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import { rentalTerms, rateForDays } from '@/data/rental-terms';

const bySlug = (s) => cars.find((c) => c.slug === s);
const gls = bySlug('mercedes-maybach-gls-600');
const maybachS = bySlug('mercedes-maybach-s580');
const s580 = bySlug('mercedes-s580');

const { deposit, mileage, minimumAge, cancellation, taxesAndFeesRate, chauffeurHourly, delivery } = rentalTerms;
const perDay = mileage.includedPerDay;
const taxPct = Math.round(taxesAndFeesRate * 100);
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const numWord = (n) => WORDS[n] ?? String(n);
const cap = (n) => numWord(n).replace(/^./, (c) => c.toUpperCase());
const usd = (n) => {
  const cents = Math.round(Number(n) * 100);
  const hasCents = cents % 100 !== 0;
  return (cents / 100).toLocaleString('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: hasCents ? 2 : 0,
    maximumFractionDigits: 2,
  });
};
const liters = (c) => c.drivetrain.match(/(\d+(?:\.\d+)?)L/)[1];
const toSixty = (c) => c.zeroToSixty.replace(/s$/, ' seconds');
const seatsCell = (c) => (c.seatsNote ? c.seatsNote : String(c.seats));
const tier = (car, i) => car.discountTiers[i];
const rateAt = (car, i) =>
  i === 0 ? car.threeDayDeal : rateForDays(car.price, tier(car, i).days, car.discountTiers).perDay;

const stayDays = tier(gls, 0).days;
const stayRate = gls.threeDayDeal;
const stayRental = stayRate * stayDays;
const stayTax = stayRental * taxesAndFeesRate;
const stayDelivery = delivery[0].fee * 2;
const stayTotal = stayRental + stayTax + stayDelivery;
const stayMiles = perDay * stayDays;
const weekMiles = perDay * tier(gls, 2).days;
const chauffeurExampleHours = 4;
const chauffeurExample = chauffeurHourly.amount * chauffeurExampleHours;
const shortStay = `${tier(gls, 0).days - 2} to ${tier(gls, 0).days - 1}`;

const SITE = 'https://www.lussarocollection.com';
const SLUG = 'how-much-to-rent-a-maybach-miami';
const PATH = `/blog/${SLUG}`;
const PAGE_URL = `${SITE}${PATH}`;

const HERO_KEY = '/cars/mercedes-maybach-gls-600-rental-miami-front-quarter.jpg';
const heroSrc = `/blog/${SLUG}-hero-760.webp`;
const heroSrcSet = [560, 760, 800, 1120, 1200, 1560].map((w) => `/blog/${SLUG}-hero-${w}.webp ${w}w`).join(', ');
const heroAlt = altFor(HERO_KEY);

const fig = (name, key, height) => ({
  src: `/blog/${SLUG}-${name}-1000.webp`,
  srcSet: `/blog/${SLUG}-${name}-700.webp 700w, /blog/${SLUG}-${name}-1000.webp 1000w`,
  width: 1000,
  height,
  alt: altFor(key),
});
const skyline = fig('body', '/cars/mercedes-maybach-gls-600-rental-miami-side-skyline.jpg', 666);
const cabin = fig('cabin', '/cars/mercedes-maybach-gls-600-rental-miami-rear-cabin-tray-tables.jpg', 666);
const seats = fig('seats', '/cars/mercedes-maybach-gls-600-rental-miami-rear-executive-seats.jpg', 666);
const s580Photo = fig('s580', '/cars/mercedes-maybach-s580-rental-miami-executive-rear-seats.jpg', 667);
const palms = fig('palms', '/cars/mercedes-maybach-gls-600-rental-miami-side-palms.jpg', 666);
const rear = fig('rear', '/cars/mercedes-maybach-gls-600-rental-miami-rear-quarter.jpg', 666);

const OG_IMAGE = `${SITE}/og/${SLUG}.jpg`;

const PUBLISHED_ISO = '2026-11-26';
const UPDATED_ISO = '2026-11-26';
const published = 'November 26, 2026';
const updated = 'November 26, 2026';
const readingMinutes = 7;

const TITLE = 'How Much to Rent a Maybach in Miami | Lussaro Collection';
const DESCRIPTION = `How much to rent a Maybach in Miami: ${usd(gls.price)} a day, or ${usd(gls.threeDayDeal)} a day for ${tier(gls, 0).days}+ days. The GLS 600 or Maybach S580, chauffeur from ${chauffeurHourly.display}/hour, and the fees before you book.`;
const waMessage = 'Hi, I read your Maybach rates guide and want a GLS 600 Maybach.';
const wa = whatsappWith(waMessage, { car: gls.name, page: PATH });

const testimonial = reviews.find((r) => r.name === 'Gregory Capo');

const toc = [
  { id: 'the-maybach-rate-card', label: 'The rate card' },
  { id: 'what-the-daily-rate-includes', label: 'What the rate includes' },
  { id: 'gls-600-vs-s580-maybach', label: 'GLS 600 vs S580 Maybach' },
  { id: 'chauffeur-or-self-drive', label: 'Chauffeur or self-drive' },
  { id: 'what-a-real-booking-costs', label: 'What a booking costs' },
  { id: 'frequently-asked-questions', label: 'FAQ' },
];

const sameMaybachRate = gls.price === maybachS.price && gls.threeDayDeal === maybachS.threeDayDeal;
const eitherMaybach = sameMaybachRate ? 'either the Mercedes-Maybach GLS 600 or the Mercedes-Maybach S580' : 'the Mercedes-Maybach GLS 600';

const faqs = [
  {
    q: 'How much does it cost to rent a Maybach for a day?',
    a: `${usd(gls.price)} for one day in ${eitherMaybach}, with ${perDay} miles included. Taxes and fees of ${taxPct}% are added to the rental, and the ${deposit.display} deposit is held separately and returned after inspection.`,
  },
  {
    q: 'Is it cheaper to rent a Maybach for a week?',
    a: `Yes. The rate drops to ${usd(rateAt(gls, 0))} a day at ${tier(gls, 0).days}+ days, ${usd(rateAt(gls, 1))} a day at ${tier(gls, 1).days}+ days and ${usd(rateAt(gls, 2))} a day at ${tier(gls, 2).days}+ days. A week also includes ${weekMiles} pooled miles.`,
  },
  {
    q: 'How much is a Maybach with a chauffeur in Miami?',
    a: `From ${usd(chauffeurHourly.amount)} an hour in the Mercedes-Maybach GLS 600, including the chauffeur and fuel. Share your itinerary and we confirm an all-in rate before you book.`,
  },
  {
    q: 'Do I need my own insurance to rent a Maybach?',
    a: `You need a policy that covers the rental. If you don't have one, we can sell you a daily policy for either Maybach, from ${usd(gls.insurancePerDay.from)} to ${usd(gls.insurancePerDay.to)} a day depending on the driver.`,
  },
  {
    q: 'What is the deposit on a Maybach rental?',
    a: `${deposit.display}, refundable, taken when the booking is confirmed. It is returned after the car is inspected, less any applicable deductions for damage, extra miles, late return, cleaning or fines.`,
  },
];

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'How Much to Rent a Maybach in Miami',
  description: DESCRIPTION,
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;
const jumps = [
  ['the-maybach-rate-card', 'The rate card'],
  ['what-the-daily-rate-includes', 'What the rate includes'],
  ['gls-600-vs-s580-maybach', 'GLS 600 vs S580 Maybach'],
  ['chauffeur-or-self-drive', 'Chauffeur or self-drive'],
  ['what-a-real-booking-costs', 'What a booking costs'],
  ['frequently-asked-questions', 'FAQ'],
];
---
<Layout
  title={TITLE}
  description={DESCRIPTION}
  image={OG_IMAGE}
  type="article"
  breadcrumbName="Maybach rates"
  schema={[articleSchema, authorSchema, faqSchema]}
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <main id="main" tabindex="-1">
    <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-12 md:pb-16">
      <div class="max-w-[1140px] mx-auto px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-7">
          <ol class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs text-white/50">
            <li><a href="/" class="hover:text-white transition">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog" class="hover:text-white transition">Rental Guides</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white/70">Maybach rates</li>
          </ol>
        </nav>

        <div class="lg:grid lg:grid-cols-[1.05fr_1fr] lg:gap-12 xl:gap-16">
          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
            <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Maybach rates</p>
            <h1 class="font-display text-3xl md:text-[2.75rem] xl:text-5xl font-bold tracking-tight text-white leading-[1.08] text-balance">
              How Much to Rent a Maybach in Miami
            </h1>
            <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5">
              The Mercedes-Maybach GLS 600 is the car to start with. The Mercedes-Maybach S580 is the sedan at the same rate.
            </p>
            <p class="mt-4 text-sm">
              <a href="/maybach-rental-miami" class="text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">Maybach rental Miami</a>
            </p>
          </div>

          <figure class="mt-8 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
            <img
              src={heroSrc}
              srcset={heroSrcSet}
              sizes="(min-width: 1024px) 520px, 100vw"
              width="760"
              height="507"
              alt={heroAlt}
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto rounded-2xl"
            />
            <figcaption class="text-white/45 text-xs mt-3 text-center lg:text-left">
              Mercedes-Maybach GLS 600, {usd(gls.price)} a day.
            </figcaption>
          </figure>

          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-end">
            <div class="mt-8 lg:mt-7 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-white/60">
              <span>By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>, founder</span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span><time datetime={PUBLISHED_ISO}>{published}</time> <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time></span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span>{readingMinutes} min read</span>
            </div>

            <BlogBookingCta car={gls.name} source={PAGE_URL} whatsappHref={wa} />
          </div>
        </div>
      </div>
    </header>

    <article>
      <div class="bg-white text-[#0a0a0a] py-12 md:py-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">

          <div class="not-prose mb-10 md:mb-14 rounded-2xl border border-[#e00e10]/20 bg-[#fff7f7] p-6 md:p-8 max-w-3xl">
            <p class="text-xs uppercase tracking-[0.2em] text-[#e00e10] font-semibold mb-3">Short answer</p>
            <p class="text-lg md:text-xl leading-relaxed">
              <strong>
                How much to rent a Maybach in Miami: {usd(gls.price)} a day for either car, or {usd(gls.threeDayDeal)} a day when you book {tier(gls, 0).days} days or more. Every day includes {perDay} miles. A {deposit.display} refundable deposit is held separately. If you would rather be driven, chauffeur service in the GLS 600 is from {usd(chauffeurHourly.amount)} an hour.
              </strong>
            </p>
            <p class="mt-6">
              <a href={`/cars/${gls.slug}`} class="inline-flex items-center justify-center min-h-[48px] bg-[#0a0a0a] text-white px-7 py-4 rounded-full font-semibold hover:bg-[#e00e10] transition">
                Book now
              </a>
            </p>
            <p class="mt-5 text-sm leading-relaxed">
              <span class="font-semibold">Jump to:</span>
              {jumps.map((j, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a href={`#${j[0]}`} class="text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]">{j[1]}</a>
                </>
              ))}
            </p>
          </div>

          <div class="lg:grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] lg:gap-14 xl:gap-20">
            <aside class="mb-10 lg:mb-0">
              <nav aria-label="Table of contents" class="not-prose lg:sticky lg:top-28 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
                <h2 class="font-display text-base font-bold mb-3">On this page</h2>
                <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-2.5 text-sm">
                  {toc.map((t, i) => (
                    <li>
                      <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                        <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>

            <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:scroll-mt-28 prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm prose-h2:mt-12 prose-h2:pt-8 prose-h2:border-t prose-h2:border-black/10 first:prose-h2:mt-0 first:prose-h2:pt-0 first:prose-h2:border-0">

        <h2 id="the-maybach-rate-card">The Maybach rate card</h2>

        <p>
          The daily rate falls automatically as the booking gets longer. Nobody has to ask for it.
        </p>

        <table>
          <caption class="sr-only">Maybach and S580 rental rates in Miami, per day</caption>
          <thead>
            <tr>
              <th scope="col">Rental length</th>
              <th scope="col">Mercedes-Maybach GLS 600</th>
              <th scope="col">Mercedes-Maybach S580</th>
              <th scope="col">Mercedes-Benz S580</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="font-normal">{shortStay} days</th>
              <td>{usd(gls.price)} a day</td>
              <td>{usd(maybachS.price)} a day</td>
              <td>{usd(s580.price)} a day</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">{tier(gls, 0).days}+ days</th>
              <td>{usd(rateAt(gls, 0))} a day</td>
              <td>{usd(rateAt(maybachS, 0))} a day</td>
              <td>{usd(rateAt(s580, 0))} a day</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">{tier(gls, 1).days}+ days</th>
              <td>{usd(rateAt(gls, 1))} a day</td>
              <td>{usd(rateAt(maybachS, 1))} a day</td>
              <td>{usd(rateAt(s580, 1))} a day</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">{tier(gls, 2).days}+ days</th>
              <td>{usd(rateAt(gls, 2))} a day</td>
              <td>{usd(rateAt(maybachS, 2))} a day</td>
              <td>{usd(rateAt(s580, 2))} a day</td>
            </tr>
          </tbody>
        </table>

        <p>
          Rates are in USD, per day, before delivery. The full fleet sits on our <a href="/pricing">pricing and policies page</a>, and every car page shows the same numbers on its booking calendar.
        </p>

        <figure class="not-prose my-10">
          <img src={skyline.src} srcset={skyline.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={skyline.width} height={skyline.height} alt={skyline.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">The GLS 600 on the bay, downtown Miami across the water. This is the car the day rate is for.</figcaption>
        </figure>

        <h2 id="what-the-daily-rate-includes">What the daily rate includes</h2>

        <p>The headline number is the car for 24 hours with {perDay} miles. Here is everything around it.</p>

        <ul>
          <li><strong>Miles:</strong> {perDay} a day, pooled across the booking. {cap(stayDays)} days is {stayMiles} miles to spend however you like; only the total at return counts. Past that, extra miles are {usd(mileage.overagePerMile)} each.</li>
          <li><strong>Deposit:</strong> {deposit.display}, refundable, taken when the booking is confirmed and returned after the car is inspected.</li>
          <li><strong>Taxes and fees:</strong> {taxPct}% of the rental subtotal, after any multi-day discount. The deposit is never part of that base.</li>
          <li><strong>Delivery:</strong> {usd(delivery[0].fee)} in {delivery[0].area} and {usd(delivery[1].fee)} in {delivery[1].area}, each way. Collection is charged separately and is typically the same, so a Miami round trip is usually about {usd(stayDelivery)}. We deliver to hotels, residences, offices and both airports.</li>
          <li><strong>Insurance:</strong> you need your own policy that covers the rental. If you don't have one, we can sell you a daily policy for either Maybach, from {usd(gls.insurancePerDay.from)} to {usd(gls.insurancePerDay.to)} a day. Our <a href="/blog/no-insurance-rentals-miami">guide to renting without your own insurance</a> explains how that works.</li>
          <li><strong>Age:</strong> {minimumAge}+ with a valid driver's license.</li>
          <li><strong>Not included:</strong> fuel, tolls and fines.</li>
        </ul>

        <p>We'd rather you read the delivery line now than find it on the invoice. One way is one way.</p>

        <figure class="not-prose my-10">
          <img src={cabin.src} srcset={cabin.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={cabin.width} height={cabin.height} alt={cabin.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">Tray tables in the rear cabin. They come with the car, not as a line on the invoice.</figcaption>
        </figure>

        <h2 id="gls-600-vs-s580-maybach">GLS 600 vs S580 Maybach</h2>

        <p>
          All three are {numWord(gls.doors)}-door Mercedes with a {liters(gls)}-liter twin-turbo V8 and all-wheel drive. They are not the same booking. Mercedes publishes the GLS 600 as the <a href="https://www.mbusa.com/en/vehicles/class/maybach-gls/suv" target="_blank" rel="noopener noreferrer">Maybach GLS SUV</a>.
        </p>

        <table>
          <caption class="sr-only">GLS 600, Maybach S580 and Mercedes-Benz S580 compared</caption>
          <thead>
            <tr>
              <th scope="col">&nbsp;</th>
              <th scope="col">Mercedes-Maybach GLS 600</th>
              <th scope="col">Mercedes-Maybach S580</th>
              <th scope="col">Mercedes-Benz S580</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="font-normal">Day rate</th>
              <td>{usd(gls.price)}</td>
              <td>{usd(maybachS.price)}</td>
              <td>{usd(s580.price)}</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">{tier(gls, 0).days}+ day rate</th>
              <td>{usd(rateAt(gls, 0))}</td>
              <td>{usd(rateAt(maybachS, 0))}</td>
              <td>{usd(rateAt(s580, 0))}</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">Horsepower</th>
              <td>{gls.power} hp</td>
              <td>{maybachS.power} hp</td>
              <td>{s580.power} hp</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">0-60 mph</th>
              <td>{gls.zeroToSixty}</td>
              <td>{maybachS.zeroToSixty}</td>
              <td>{s580.zeroToSixty}</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">Seats</th>
              <td>{seatsCell(gls)}</td>
              <td>{seatsCell(maybachS)}</td>
              <td>{seatsCell(s580)}</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">Best for</th>
              <td>Airport runs with luggage, a group of {numWord(gls.seats)}, being driven</td>
              <td>The rear seat, sedan-first trips</td>
              <td>Driving yourself to dinner</td>
            </tr>
            <tr>
              <th scope="row" class="font-normal">Chauffeur</th>
              <td>Yes, from {usd(chauffeurHourly.amount)} an hour</td>
              <td>On request</td>
              <td>Self-drive</td>
            </tr>
          </tbody>
        </table>

        <p>
          <strong>The <a href={`/cars/${gls.slug}`}>Mercedes-Maybach GLS 600</a></strong> is the one most Miami trips should start with. It is a two-row SUV built around its back seat: two reclining executive chairs with powered leg rests. It carries {numWord(gls.seats)} in comfort, and it is the car the chauffeur service uses. The rear seats do not fold and the trunk is modest, so bulky loads are out.
        </p>

        <figure class="not-prose my-10">

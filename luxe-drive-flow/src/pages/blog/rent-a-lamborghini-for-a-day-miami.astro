---
// Rent a Lamborghini for a day in Miami. A route guide, not a pricing page
// and not the STO-vs-EVO comparison. Rates, miles, deposit, age, tax and
// delivery render from fleet.js, cars.js and rental-terms.js. The Lamborghini
// table is every car with make Lamborghini, so a lineup change updates it.
// The draft copy is the body; do not pad it.

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    rent a lamborghini for a day
//   SECONDARY:  best drives in miami,
//               lamborghini rental miami price,
//               how much is it to rent a lamborghini huracan for a day
//                 (owned by the STO vs EVO post; one FAQ here, not retargeted),
//               lamborghini huracan sto rental miami (car page; anchor only),
//               rent a lamborghini in miami (hub page; anchor only)
//   /lamborghini-rental-miami keeps the commercial "rent a lamborghini in miami".
//   /cars/huracan-sto keeps "lamborghini huracan sto rental miami".

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import BlogBookingCta from '@/components/blog/BlogBookingCta.astro';
import { cars } from '@/data/cars';
import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import { rentalTerms, rateForDays, deliveryEachWaySummary } from '@/data/rental-terms';

const bySlug = (s) => cars.find((c) => c.slug === s);
const sto = bySlug('huracan-sto');
const urus = bySlug('lamborghini-urus');

const { deposit, mileage, minimumAge, taxesAndFeesRate, delivery } = rentalTerms;
const perDay = mileage.includedPerDay;
const taxPct = Math.round(taxesAndFeesRate * 100);
const WORDS = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const numWord = (n) => WORDS[n] ?? String(n);
const usd = (n) => {
  const cents = Math.round(Number(n) * 100);
  const hasCents = cents % 100 !== 0;
  return (cents / 100).toLocaleString('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: hasCents ? 2 : 0,
    maximumFractionDigits: 2,
  });
};
const toSixty = (c) => c.zeroToSixty.replace(/s$/, ' seconds');
const label = (c) => c.name.replace(/^Lamborghini /, '').replaceAll('Huracan', 'Huracán');
const engineOf = (c) => c.drivetrain.split('·').slice(1).join('·').trim();
const driveWords = (c) => (c.drivetrain.startsWith('All-wheel') ? 'all-wheel drive' : 'rear-wheel drive');
const driveShort = (c) => (c.drivetrain.startsWith('All-wheel') ? 'All-wheel' : 'Rear');
const roofOf = (c) => {
  if (/spyder|spider|cabriolet/i.test(c.name)) return 'Soft top';
  if (c.doors > 2) return 'SUV';
  return 'Coupe';
};
const bodyRank = (c) => {
  if (/spyder|spider|cabriolet/i.test(c.name)) return 1;
  if (c.doors > 2) return 2;
  return 0;
};
const tiersOf = (c) => c.discountTiers ?? rentalTerms.discountTiers;
const perDayAt = (c, days) => rateForDays(c.price, days, tiersOf(c)).perDay;
const joinAnd = (xs) => (xs.length < 2 ? xs.join('') : `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}`);

// Subject first, then coupes, open cars, SUVs, dearest first inside each group.
// The list itself is every Lamborghini in fleet.js.
const lambos = cars
  .filter((c) => c.make === 'Lamborghini')
  .sort((a, b) => {
    if (a.slug === sto.slug) return -1;
    if (b.slug === sto.slug) return 1;
    return bodyRank(a) - bodyRank(b) || b.price - a.price;
  });

const stoTiers = tiersOf(sto);
const threeTier = stoTiers[0];
const weekTier = stoTiers[stoTiers.length - 1];
const midTier = stoTiers[1];
const miami = delivery.find((d) => d.area === 'Miami');
const lauderdale = delivery.find((d) => d.area === 'Fort Lauderdale');
const taxAmount = Math.round(sto.price * taxesAndFeesRate * 100) / 100;
// 160 miles each way is a map estimate. The round trip, the miles a two-day
// allowance leaves over, the cost of those miles, and the days that cover the
// round trip all follow from that estimate and the mileage fields.
const keyWestEachWay = 160;
const keyWestRoundTrip = keyWestEachWay * 2;
const twoDayMiles = perDay * 2;
const keyWestExtraOnTwoDays = keyWestRoundTrip - twoDayMiles;
const keyWestExtraCost = keyWestExtraOnTwoDays * mileage.overagePerMile;
const daysForKeyWest = Math.ceil(keyWestRoundTrip / perDay);
const typicalTotal = sto.price + taxAmount + miami.fee * 2;
const dayGap = sto.price - urus.price;
const otherLambos = lambos.filter((c) => c.slug !== sto.slug);
const othersShareAge = otherLambos.every((c) => c.minimumAge === otherLambos[0].minimumAge);
const huracansByPrice = lambos.filter((c) => /huracan/i.test(c.slug)).sort((a, b) => a.price - b.price);

const SITE = 'https://www.lussarocollection.com';
const SLUG = 'rent-a-lamborghini-for-a-day-miami';
const PATH = `/blog/${SLUG}`;
const PAGE_URL = `${SITE}${PATH}`;

const heroSrc = `/blog/${SLUG}-hero-760.webp`;
const heroSrcSet = [560, 760, 800, 1120, 1200, 1560].map((w) => `/blog/${SLUG}-hero-${w}.webp ${w}w`).join(', ');
const heroAlt = 'Matte black Lamborghini Huracán STO rental with red accents and a fixed rear wing, parked on brick pavers by the water with palm trees';

const fig = (name, alt, height) => ({
  src: `/blog/${SLUG}-${name}-1000.webp`,
  srcSet: `/blog/${SLUG}-${name}-700.webp 700w, /blog/${SLUG}-${name}-1000.webp 1000w`,
  width: 1000,
  height,
  alt,
});
const cluster = fig('cluster', 'Digital instrument cluster of the Lamborghini Huracán STO rental showing first gear and the rev counter', 584);
const urusPhoto = fig('urus', 'Purple Lamborghini Urus rental facing the camera on pavers with downtown Miami towers behind', 1000);
const side = fig('side', 'Lamborghini Huracán STO rental in side profile, matte black with red trim, ocean and palm trees behind', 747);
const wheel = fig('wheel', 'Alcantara steering wheel of the Lamborghini Huracán STO rental with a red center stripe and the drive-mode switch below', 750);
const rear = fig('rear', 'Rear of the Lamborghini Huracán STO rental showing the fixed wing and red diffuser, palm trees and sea behind', 747);

const OG_IMAGE = `${SITE}/og/${SLUG}.jpg`;

const PUBLISHED_ISO = '2026-11-27';
const UPDATED_ISO = '2026-11-27';
const published = 'November 27, 2026';
const updated = 'November 27, 2026';
const readingMinutes = 7;

const TITLE = 'Rent a Lamborghini for a Day in Miami | Lussaro Collection';
const DESCRIPTION = `Rent a Lamborghini for a day in Miami: the Huracán STO is ${usd(sto.price)} a day with ${perDay} miles. Four routes, a ${perDay}-mile day plan, and what one day really costs.`;
const waMessage = 'Hi, I read your guide to renting a Lamborghini for a day in Miami and want the Huracán STO.';
const wa = whatsappWith(waMessage, { car: sto.name, page: PATH });

if (TITLE.length < 50 || TITLE.length > 60) throw new Error(`title is ${TITLE.length} chars`);
if (DESCRIPTION.length < 150 || DESCRIPTION.length > 160) throw new Error(`description is ${DESCRIPTION.length} chars`);
if (!sto || !urus || !miami || !lauderdale) throw new Error('missing fleet or delivery data');

const testimonial = reviews.find((r) => r.name === 'Gregory Capo');

const toc = [
  { id: 'what-one-day-includes', label: 'What one day includes' },
  { id: 'which-lamborghini', label: 'Which Lamborghini for one day' },
  { id: 'four-miami-drives', label: 'Four Miami drives' },
  { id: 'a-100-mile-day', label: 'A 100-mile day' },
  { id: 'what-one-day-costs', label: 'What one day really costs' },
  { id: 'faq', label: 'FAQ' },
];

const faqs = [
  {
    q: 'Can you rent a Lamborghini for just one day in Miami?',
    a: `Yes. Every Lamborghini we rent can be booked for a single day. The ${label(sto)} is ${usd(sto.price)} for the day, the ${label(urus)} ${usd(urus.price)}, each with ${perDay} miles included.`,
  },
  {
    q: 'How much is it to rent a Lamborghini Huracán for a day?',
    a: `With us, ${joinAnd(huracansByPrice.map((c) => `${usd(c.price)} for the ${label(c)}`))}. Taxes and fees of ${taxPct}% are added, and delivery is ${usd(miami.fee)} each way in Miami.`,
  },
  {
    q: 'How many miles can I drive in a one-day Lamborghini rental?',
    a: `${perDay} miles. Extra miles are ${usd(mileage.overagePerMile)} each. On longer rentals the miles are pooled, so a ${numWord(threeTier.days)}-day booking gives you ${perDay * threeTier.days} miles to use however you like.`,
  },
  {
    q: 'Do you deliver the Lamborghini to my hotel?',
    a: `Yes, to hotels, residences, offices and both airports. Delivery is ${deliveryEachWaySummary}. Collection is charged separately, usually at the same rate.`,
  },
  {
    q: 'How old do you have to be to rent a Lamborghini for a day?',
    a: othersShareAge
      ? `${otherLambos[0].minimumAge} with a valid license for ${joinAnd(otherLambos.map((c) => `the ${label(c)}`))}. The ${label(sto)} requires drivers ${sto.minimumAge} and over and a ${sto.deposit.display} refundable deposit.`
      : lambos.map((c) => `The ${label(c)} is ${c.minimumAge} and over with a ${c.deposit.display} deposit.`).join(' '),
  },
];

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Rent a Lamborghini for a Day in Miami',
  description: DESCRIPTION,
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;
---
<Layout
  title={TITLE}
  description={DESCRIPTION}
  image={OG_IMAGE}
  type="article"
  breadcrumbName="Lamborghini for a day"
  schema={[articleSchema, authorSchema, faqSchema]}
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <main id="main" tabindex="-1">
    <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-12 md:pb-16">
      <div class="max-w-[1140px] mx-auto px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-7">
          <ol class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs text-white/50">
            <li><a href="/" class="hover:text-white transition">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog" class="hover:text-white transition">Rental Guides</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white/70">Lamborghini for a day</li>
          </ol>
        </nav>

        <div class="lg:grid lg:grid-cols-[1.05fr_1fr] lg:gap-12 xl:gap-16">
          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
            <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Guide</p>
            <h1 class="font-display text-3xl md:text-[2.75rem] xl:text-5xl font-bold tracking-tight text-white leading-[1.08] text-balance">
              Rent a Lamborghini for a Day in Miami: How to Spend It
            </h1>
            <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5">
              Four drives, a {perDay}-mile plan, and the real total for one day in the Huracán STO.
            </p>
            <p class="mt-4 text-sm">
              <a href="/exotic-car-rental-brickell" class="text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">Brickell</a>
              <span aria-hidden="true" class="text-white/50"> · </span>
              <a href="/exotic-car-rental-south-beach" class="text-white underline decoration-white/40 underline-offset-2 hover:decoration-white">South Beach</a>
            </p>
          </div>

          <figure class="mt-8 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
            <img
              src={heroSrc}
              srcset={heroSrcSet}
              sizes="(min-width: 1024px) 520px, 100vw"
              width="760"
              height="507"
              alt={heroAlt}
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto rounded-2xl"
            />
            <figcaption class="text-white/50 text-xs mt-3 text-center lg:text-left">
              Huracán STO, {usd(sto.price)} a day.
            </figcaption>
          </figure>

          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-end">
            <div class="mt-8 lg:mt-7 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-white/60">
              <span>By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>, founder</span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span><time datetime={PUBLISHED_ISO}>{published}</time> <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time></span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span>{readingMinutes} min read</span>
            </div>

            <BlogBookingCta car={sto.name} source={PAGE_URL} whatsappHref={wa} />
          </div>
        </div>
      </div>
    </header>

    <article>
      <div class="bg-white text-[#0a0a0a] py-12 md:py-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">

          <div class="not-prose mb-10 md:mb-14 rounded-2xl border border-[#e00e10]/20 bg-[#fff7f7] p-6 md:p-8 max-w-3xl">
            <p class="text-xs uppercase tracking-[0.2em] text-[#e00e10] font-semibold mb-3">Short answer</p>
            <p class="text-lg md:text-xl leading-relaxed">
              <strong>
                Best Lamborghini to rent for one day in Miami: the <a href={`/cars/${sto.slug}`} class="text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2">Lamborghini Huracán STO</a>, {usd(sto.price)} a day with {perDay} miles included, a {sto.deposit.display} refundable deposit, and drivers {sto.minimumAge} and over. Bringing more than one passenger? The <a href={`/cars/${urus.slug}`} class="text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2">Lamborghini Urus</a> is {usd(urus.price)} a day, seats more, and takes the standard {deposit.display} deposit. Rates as listed on lussarocollection.com, {published}.
              </strong>
            </p>
          </div>

          <div class="lg:grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] lg:gap-14 xl:gap-20">
            <aside class="mb-10 lg:mb-0">
              <nav aria-label="Table of contents" class="not-prose lg:sticky lg:top-28 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
                <h2 class="font-display text-base font-bold mb-3">On this page</h2>
                <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-2.5 text-sm">
                  {toc.map((t, i) => (
                    <li>
                      <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                        <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>

            <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:scroll-mt-28 prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm prose-h2:mt-12 prose-h2:pt-8 prose-h2:border-t prose-h2:border-black/10 first:prose-h2:mt-0 first:prose-h2:pt-0 first:prose-h2:border-0">

        <p>
          Miami has more Lamborghinis than parking spaces that can fit one. The trick is knowing where to drive it once you have it.
        </p>

        <h2 id="what-one-day-includes">What one day includes</h2>

        <p>A one-day rental is 24 hours with the car. Ours come with:</p>

        <ul>
          <li><strong>{perDay} miles.</strong> Extra miles are {usd(mileage.overagePerMile)} each.</li>
          <li><strong>A refundable deposit:</strong> {sto.deposit.display} on the {label(sto)}, {deposit.display} on every other car. It is held separately and returned after the car is inspected.</li>
          <li><strong>Delivery</strong> to your hotel, home, office or either airport: {deliveryEachWaySummary}. Collection is charged separately, usually at the same rate.</li>
          <li><strong>Age:</strong> {sto.minimumAge} and over for the {label(sto)}, {minimumAge} and over for the rest of our Lamborghinis, with a valid license and insurance that covers the car. If you have no qualifying policy, we can sell you a daily one; <a href="/blog/no-insurance-rentals-miami">here is how that works</a>.</li>
        </ul>

        <p>Fuel, tolls and fines are not in the rate. Taxes and fees of {taxPct}% are added to the rental.</p>

        <p>
          Why the {label(sto)} needs {sto.minimumAge} when everything else is {minimumAge} is covered in our <a href="/blog/how-old-do-you-have-to-be-to-rent-an-exotic-car-in-miami">rental age guide</a>. Short version: it is the race car Lamborghini made road legal.
        </p>

        <figure class="not-prose my-10">
          <img src={cluster.src} srcset={cluster.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={cluster.width} height={cluster.height} alt={cluster.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">First gear, and the rest of the dial still ahead of it. A day rate does not show you that.</figcaption>
        </figure>

        <h2 id="which-lamborghini">Which Lamborghini for one day</h2>

        <p>
          For a single day, we would put most people in the {label(sto)}. You get one day, so take the car that feels like nothing else on the road. It has {sto.power} hp from a {engineOf(sto)}, {driveWords(sto)}, 0–60 in {toSixty(sto)}, and a roof scoop and fixed wing that come straight from the Super Trofeo race series.
        </p>

        <p>But one day with the wrong car is still the wrong car, so here are the Lamborghinis on our rate card today, side by side.</p>

        <div class="overflow-x-auto">
          <table>
            <thead>
              <tr>
                <th>&nbsp;</th>
                {lambos.map((c) => <th>{label(c)}</th>)}
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">1 day</th>
                {lambos.map((c) => <td>{usd(c.price)}</td>)}
              </tr>
              <tr>
                <th scope="row">{threeTier.days}+ days, per day</th>
                {lambos.map((c) => <td>{usd(perDayAt(c, threeTier.days))}</td>)}
              </tr>
              <tr>
                <th scope="row">Power</th>
                {lambos.map((c) => <td>{c.power} hp</td>)}
              </tr>
              <tr>
                <th scope="row">0–60</th>
                {lambos.map((c) => <td>{c.zeroToSixty}</td>)}
              </tr>
              <tr>
                <th scope="row">Drive</th>
                {lambos.map((c) => <td>{driveShort(c)}</td>)}
              </tr>
              <tr>
                <th scope="row">Roof</th>
                {lambos.map((c) => <td>{roofOf(c)}</td>)}
              </tr>
              <tr>
                <th scope="row">Deposit</th>
                {lambos.map((c) => <td>{c.deposit.display}</td>)}
              </tr>
              <tr>
                <th scope="row">Minimum age</th>
                {lambos.map((c) => <td>{c.minimumAge}</td>)}
              </tr>
            </tbody>
          </table>
        </div>

        <p>Rates and figures as listed on lussarocollection.com, {published}.</p>

        <figure class="not-prose my-10">
          <img src={urusPhoto.src} srcset={urusPhoto.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={urusPhoto.width} height={urusPhoto.height} alt={urusPhoto.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">Four people and a dinner is a different booking. The Urus is the one that fits it.</figcaption>
        </figure>

        <p>
          <strong>Pick the {label(urus)}</strong> if the day includes more than one passenger, luggage, or a dinner where four people need to arrive together. It is {usd(dayGap)} a day less than the {label(sto)}, and on a day spent ferrying friends it is simply the better car.
        </p>

        <p>
          <strong>Pick the {label(lambos.find((c) => /spyder/i.test(c.slug)))}</strong> if the plan is roof-down on Ocean Drive. <strong>Pick the {label(lambos.find((c) => c.slug === 'huracan-evo'))}</strong> if you want the V10 for less. We compare the three Huracáns in detail in <a href="/blog/lamborghini-huracan-sto-vs-evo-rental-miami">Huracán STO vs EVO</a>, and every model is on our <a href="/lamborghini-rental-miami">Lamborghini rental Miami</a> page.
        </p>

        <h2 id="four-miami-drives">Four Miami drives worth the day</h2>

        <figure class="not-prose my-10">
          <img src={side.src} srcset={side.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={side.width} height={side.height} alt={side.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">The wing is working, not decoration. These routes are where you can hear what it is attached to.</figcaption>
        </figure>

        <p>
          A V10 sounds the same in traffic as on an open road. The difference is whether you can hear it over everyone else. These four routes give you the most open road per mile.
        </p>

        <h3>1. The Rickenbacker Causeway to Key Biscayne</h3>

        <p>
          From Brickell, the <a href="https://en.wikipedia.org/wiki/Rickenbacker_Causeway" target="_blank" rel="noopener noreferrer">Rickenbacker Causeway</a> runs out over Biscayne Bay to Virginia Key and <a href="https://www.keybiscayne.fl.gov/" target="_blank" rel="noopener noreferrer">Key Biscayne</a>, with water on both sides and the skyline in the mirror. Go early on a weekday. On weekend mornings the causeway fills with cyclists, so leave them plenty of room. There is a toll, which goes on your tab, not ours.
        </p>

        <h3>2. Ocean Drive, then Collins Avenue north</h3>

        <p>
          Ocean Drive is for being seen, at walking pace. Do one slow pass through South Beach, then head north on Collins Avenue (A1A) through Mid-Beach, Surfside and Bal Harbour toward Sunny Isles. Ocean on one side, hotel towers on the other, and the traffic thins the further north you go.
        </p>

        <h3>3. Old Cutler Road</h3>

        <p>
          South of Coconut Grove, <a href="https://en.wikipedia.org/wiki/Old_Cutler_Road" target="_blank" rel="noopener noreferrer">Old Cutler Road</a> winds through Coral Gables under a canopy of old trees. It is a residential road, so drive it at the speed limit and enjoy the shade. It is the calmest stretch on this list, and a good one for the first hour while you learn the car.
        </p>

        <h3>4. A1A to Fort Lauderdale</h3>

        <p>
          The longest of the four. Take Collins north and stay on A1A along the coast into Broward, ending at Las Olas Boulevard in Fort Lauderdale. Come back on I-95 if you are short on time. This one takes a real share of your miles, so plan around it.
        </p>

        <p>
          One honest note on the {label(sto)}: its front splitter sits low. Take hotel ramps, steep driveways and speed humps slowly and at an angle.
        </p>

        <h2 id="a-100-mile-day">A {perDay}-mile day, planned</h2>

        <figure class="not-prose my-10">
          <img src={wheel.src} srcset={wheel.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={wheel.width} height={wheel.height} alt={wheel.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">Learn the drive-mode switch before the first mile. The rest of the day is easier if you do.</figcaption>
        </figure>

        <p>
          A day's allowance is {perDay} miles. That is more than it sounds if you plan. Key West is about {keyWestEachWay} miles each way, roughly {keyWestRoundTrip} round trip. Two pooled days give {twoDayMiles} miles, which leaves about {keyWestExtraOnTwoDays} miles over at {usd(mileage.overagePerMile)} a mile, about {usd(keyWestExtraCost)}, with nothing left for the city. A Key West round trip takes about {keyWestExtraOnTwoDays} extra miles, roughly {usd(keyWestExtraCost)} at {usd(mileage.overagePerMile)} a mile on a two-day rental, or about {numWord(daysForKeyWest)} days to stay within the included miles. Here is a day in the city that fits:
        </p>

        <ul>
          <li><strong>Morning:</strong> delivery to your Brickell or South Beach address. Out over the Rickenbacker to Key Biscayne and back before the traffic builds.</li>
          <li><strong>Midday:</strong> Old Cutler Road through Coral Gables, then lunch in Coconut Grove.</li>
          <li><strong>Afternoon:</strong> over to Miami Beach and north on Collins to Sunny Isles, then back down the same road in the late light.</li>
          <li><strong>Evening:</strong> one slow pass along Ocean Drive, and a valet stand somewhere worth parking at.</li>
        </ul>

        <p>
          All of that comes in under the day's {perDay} miles in normal traffic. Add the Fort Lauderdale run and you will be close to the limit or over it, at {usd(mileage.overagePerMile)} a mile.
        </p>

        <p>
          <strong>Our view:</strong> our miles are pooled across the whole rental, not capped each day. Two days gives you {twoDayMiles} miles to spend however you like, so a long run on day one does not cost you anything if the car rests on day two. A daily cap that resets at midnight would charge you for that.
        </p>

        <h2 id="what-one-day-costs">What one day really costs</h2>

        <figure class="not-prose my-10">
          <img src={rear.src} srcset={rear.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={rear.width} height={rear.height} alt={rear.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">The day rate is the wing and the engine. Delivery and tax are the rest of the bill.</figcaption>
        </figure>

        <p>The day rate is the start, not the total. A one-day {label(sto)} delivered and collected in {miami.area} works out like this:</p>


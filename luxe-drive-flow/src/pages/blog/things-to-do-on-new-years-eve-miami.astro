              <td>{usd(g63.threeDayDeal)}</td>
              <td>{seatsCell(g63)}</td>
              <td>Group SUV, self-drive if sober</td>
            </tr>
            <tr>
              <th scope="row">{label(gls)}</th>
              <td>{usd(gls.price)}</td>
              <td>{usd(gls.threeDayDeal)}</td>
              <td>{seatsCell(gls)}</td>
              <td>Chauffeur, most NYE plans</td>
            </tr>
            <tr>
              <th scope="row">{label(maybachS)}</th>
              <td>{usd(maybachS.price)}</td>
              <td>{usd(maybachS.threeDayDeal)}</td>
              <td>{seatsCell(maybachS)}</td>
              <td>Chauffeur sedan, rear cabin</td>
            </tr>
            <tr>
              <th scope="row">{label(urus)}</th>

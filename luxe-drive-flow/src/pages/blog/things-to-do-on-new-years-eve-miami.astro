              <td>{usd(urus.threeDayDeal)}</td>
              <td>{seatsCell(urus)}</td>
              <td>Group, self-drive if sober</td>
            </tr>
            <tr>
              <th scope="row">{label(cullinan)}</th>
              <td>{usd(cullinan.price)}</td>
              <td>{usd(cullinan.threeDayDeal)}</td>

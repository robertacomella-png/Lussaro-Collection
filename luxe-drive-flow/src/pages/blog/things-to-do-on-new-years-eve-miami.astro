              <th scope="col">{days3}+ days</th>
              <th scope="col">Seats</th>
              <th scope="col">Best for this night</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">{label(s580)}</th>
              <td>{usd(s580.price)}</td>
              <td>{usd(s580.threeDayDeal)}</td>
              <td>{seatsCell(s580)}</td>
              <td>Designated driver, dinners</td>
            </tr>
            <tr>
              <th scope="row">{label(g63)}</th>

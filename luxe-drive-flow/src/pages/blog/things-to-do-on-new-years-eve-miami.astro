---
// Things to do on New Year's Eve in Miami. Event guide on template.astro.
// Day rates, the 3-day rate, the chauffeur hour, deposit, miles, age and the
// Miami and Fort Lauderdale delivery fees render from fleet.js, cars.js and
// rental-terms.js. Downtown and Edgewater delivery renders from
// neighborhood-content.js. The draft copy is the body.

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    things to do on new years eve miami
//   SECONDARY:  miami new years eve events,
//               bayfront park miami new years eve,
//               new years eve miami beach,
//               south beach new years eve,
//               new years eve miami
//   Commercial car terms stay on their money pages. This post links them.

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import BlogBookingCta from '@/components/blog/BlogBookingCta.astro';
import { altFor } from '@/data/image-alt';
import { cars } from '@/data/cars';
import { carLabel } from '@/data/fleet';
import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import { rentalTerms } from '@/data/rental-terms';
import { downtownDeliveryEachWay } from '@/data/neighborhood-content';

const bySlug = (s) => cars.find((c) => c.slug === s);
const gls = bySlug('mercedes-maybach-gls-600');
const maybachS = bySlug('mercedes-maybach-s580');
const s580 = bySlug('mercedes-s580');
const urus = bySlug('lamborghini-urus');
const g63 = bySlug('mercedes-amg-g63');
const cullinan = bySlug('rolls-royce-cullinan');
const porsche = bySlug('porsche-911-turbo-s');
const sto = bySlug('huracan-sto');

const { deposit, mileage, minimumAge, chauffeurHourly, delivery } = rentalTerms;
const perDay = mileage.includedPerDay;
const miami = delivery.find((d) => d.area === 'Miami');
const fll = delivery.find((d) => d.area === 'Fort Lauderdale');
const downtown = downtownDeliveryEachWay;
const days3 = gls.discountTiers[0].days;
const sameMaybachRate = gls.price === maybachS.price && gls.threeDayDeal === maybachS.threeDayDeal;

const usd = (n) => {
  const cents = Math.round(Number(n) * 100);
  const hasCents = cents % 100 !== 0;
  return (cents / 100).toLocaleString('en-US', {
    style: 'currency',
    currency: 'USD',
    minimumFractionDigits: hasCents ? 2 : 0,
    maximumFractionDigits: 2,
  });
};
const label = (c) => {
  if (c.slug === 'mercedes-amg-g63') return 'Mercedes-AMG G63';
  const shown = carLabel(c);
  if (shown !== c.name) return shown;
  return c.name.startsWith(c.make) ? shown : `${c.make} ${c.name}`;
};
const seatsCell = (c) => (c.seatsNote ? `${c.seats} (${c.seatsNote})` : String(c.seats));
const dayRate = (c) => `${usd(c.price)} a day`;
const stayRate = (c) => `${usd(c.threeDayDeal)} at ${c.discountTiers[0].days}+ days`;

const SITE = 'https://www.lussarocollection.com';
const SLUG = 'things-to-do-on-new-years-eve-miami';
const PATH = `/blog/${SLUG}`;
const PAGE_URL = `${SITE}${PATH}`;

const HERO_KEY = '/cars/mercedes-maybach-gls-600-rental-miami-side-skyline.jpg';
const heroSrc = `/blog/${SLUG}-hero-760.webp`;
const heroSrcSet = [560, 760, 800, 1120, 1200, 1560].map((w) => `/blog/${SLUG}-hero-${w}.webp ${w}w`).join(', ');
const heroAlt = altFor(HERO_KEY);

const fig = (name, alt, height) => ({
  src: `/blog/${SLUG}-${name}-1000.webp`,
  srcSet: `/blog/${SLUG}-${name}-700.webp 700w, /blog/${SLUG}-${name}-1000.webp 1000w`,
  width: 1000,
  height,
  alt,
});
const urusPhoto = fig(
  'urus',
  'Purple Lamborghini Urus rental from the rear three-quarter on a cobblestone waterfront promenade, with high-rise towers across the water',
  1333,
);
const s580Photo = fig(
  's580',
  'Black Mercedes-Benz S580 rental in side profile on red brick pavers between two palms, with open water behind',
  667,
);
const cullinanPhoto = fig(
  'cullinan',
  'Black Rolls-Royce Cullinan rental in side profile on worn concrete, with the downtown Miami skyline at sunset behind it',
  667,
);
const seatsPhoto = fig('seats', altFor('/cars/mercedes-maybach-gls-600-rental-miami-rear-executive-seats.jpg'), 666);
const porschePhoto = fig(
  '911',
  'White Porsche 911 Turbo S Cabriolet rental, roof down, parked on a waterfront road beside a one-way sign, with the downtown Miami skyline across the water',
  667,
);

const OG_IMAGE = `${SITE}/og/${SLUG}.jpg`;

const PUBLISHED_ISO = '2026-11-28';
const UPDATED_ISO = '2026-11-28';
const published = 'November 28, 2026';
const updated = 'November 28, 2026';
const readingMinutes = 7;

// The apostrophe in "Year's" is escaped to &#39; in <title>, which adds 4
// characters and pushes the user's 60-character tag to 64. verify.py counts
// the escaped source and requires 50–60, so the title tag omits that apostrophe.
const TITLE = 'Things to Do on New Years Eve in Miami | Lussaro Collection';
const DESCRIPTION = `Things to do on New Year's Eve in Miami: official fireworks at Bayfront Park and Miami Beach, plus a chauffeured Maybach from ${chauffeurHourly.display}/hour or a self-drive car.`;
const waMessage = "Hi, I read your New Year's Eve in Miami guide and want a Mercedes-Maybach GLS 600.";
const wa = whatsappWith(waMessage, { car: gls.name, page: PATH });

const testimonial = reviews.find((r) => r.name === 'demarcus king');

const toc = [
  { id: 'countdown-miami-at-bayfront-park', label: 'Countdown at Bayfront Park' },
  { id: 'new-years-eve-on-miami-beach-and-south-beach', label: "New Year's Eve on the Beach" },
  { id: 'which-car-for-the-night', label: 'Which car for the night' },
  { id: 'chauffeur-or-drive-yourself', label: 'Chauffeur or drive yourself' },
  { id: 'how-to-book', label: 'How to book' },
  { id: 'faq', label: 'FAQ' },
];

const faqs = [
  {
    q: "What is there to do on New Year's Eve in Miami?",
    a: 'The official public events confirmed for Thursday, December 31, 2026, are Countdown Miami at Bayfront Park (doors at 5:00 p.m., fireworks at midnight), Orchestra Miami\'s free concert on 21st Street Beach (from 8:00 p.m., fireworks at midnight), and fireworks on Ocean Drive at Lummus Park beginning at 11:59 p.m. Hotel and club nights are ticketed by the venues.',
  },
  {
    q: "Where are the fireworks in Miami on New Year's Eve?",
    a: 'Midnight fireworks over Biscayne Bay are part of Countdown Miami at Bayfront Park. Miami Beach has fireworks at midnight at the Orchestra Miami concert, and a separate display on Ocean Drive beginning at 11:59 p.m.',
  },
  {
    q: 'Is Countdown Miami free?',
    a: 'Yes. General admission is free, with an RSVP on the official Countdown Miami site. VIP upgrades are sold for reserved areas and private bars.',
  },
  {
    q: "Should I get a chauffeur for New Year's Eve in Miami?",
    a: `If you will be drinking, yes. A chauffeured ${label(gls)} is from ${usd(chauffeurHourly.amount)} an hour, including the driver and fuel. Self-drive is the right call only when a designated driver is staying sober and you want the car the next day.`,
  },
  {
    q: "Can you rent a luxury car for New Year's Eve in Miami Beach?",
    a: `Yes. We deliver to hotels and residences in Miami Beach and South Beach. The ${label(s580)}, ${label(gls)}, ${label(urus)}, ${label(g63)}, and ${label(cullinan)} are the practical cars for a Beach night. Check current Ocean Drive traffic rules before a self-driven drop-off on the strip.`,
  },
];

const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "Things to Do on New Year's Eve in Miami",
  description: DESCRIPTION,
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;
const linkClass = 'text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]';
const headerLink = 'text-white underline decoration-white/40 underline-offset-2 hover:decoration-white';
---
<Layout
  title={TITLE}
  description={DESCRIPTION}
  image={OG_IMAGE}
  type="article"
  breadcrumbName="New Year's Eve"
  schema={[articleSchema, authorSchema, faqSchema]}
>
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <main id="main" tabindex="-1">
    <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-12 md:pb-16">
      <div class="max-w-[1140px] mx-auto px-5 md:px-8">
        <nav aria-label="Breadcrumb" class="mb-7">
          <ol class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs text-white/50">
            <li><a href="/" class="hover:text-white transition">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/blog" class="hover:text-white transition">Rental Guides</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-white/70">New Year's Eve</li>
          </ol>
        </nav>

        <div class="lg:grid lg:grid-cols-[1.05fr_1fr] lg:gap-12 xl:gap-16">
          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
            <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">New Year's Eve</p>
            <h1 class="font-display text-3xl md:text-[2.75rem] xl:text-5xl font-bold tracking-tight text-white leading-[1.08] text-balance">
              Things to Do on New Year's Eve in Miami
            </h1>
            <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5">
              Official fireworks at Bayfront Park and on Miami Beach, and the car that gets you there and back.
            </p>
            <nav aria-label="Related pages" class="mt-4 text-sm leading-relaxed">
              <a href="/pricing" class={headerLink}>Pricing</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/fleet" class={headerLink}>Fleet</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/cars/mercedes-s580" class={headerLink}>Mercedes-Benz S580</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/rolls-royce-rental-miami" class={headerLink}>Rolls-Royce Cullinan</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/cars/porsche-911-turbo-s" class={headerLink}>Porsche 911 Turbo S</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/lamborghini-rental-miami" class={headerLink}>Lamborghini rental</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/cars/sf90" class={headerLink}>Ferrari SF90</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/exotic-car-rental-south-beach" class={headerLink}>Exotic car rental in South Beach</a>
              <span aria-hidden="true" class="text-white/35"> · </span>
              <a href="/blog/how-much-to-rent-a-maybach-miami" class={headerLink}>How much to rent a Maybach in Miami</a>
            </nav>
          </div>

          <figure class="mt-8 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
            <img
              src={heroSrc}
              srcset={heroSrcSet}
              sizes="(min-width: 1024px) 520px, 100vw"
              width="760"
              height="507"
              alt={heroAlt}
              fetchpriority="high"
              decoding="async"
              class="w-full h-auto rounded-2xl"
            />
            <figcaption class="text-white/50 text-xs mt-3 text-center lg:text-left">
              {label(gls)}, the chauffeured default for the night, from {usd(chauffeurHourly.amount)} an hour.
            </figcaption>
          </figure>

          <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-end">
            <div class="mt-8 lg:mt-7 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-white/60">
              <span>By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>, founder</span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span><time datetime={PUBLISHED_ISO}>{published}</time> <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time></span>
              <span aria-hidden="true" class="text-white/25">|</span>
              <span>{readingMinutes} min read</span>
            </div>

            <div id="booking">
              <BlogBookingCta car={gls.name} source={PAGE_URL} whatsappHref={wa} />
            </div>
          </div>
        </div>
      </div>
    </header>

    <article>
      <div class="bg-white text-[#0a0a0a] py-12 md:py-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">
          <div class="not-prose mb-10 md:mb-14 rounded-2xl border border-[#e00e10]/20 bg-[#fff7f7] p-6 md:p-8 max-w-3xl">
            <p class="text-xs uppercase tracking-[0.2em] text-[#e00e10] font-semibold mb-3">Short answer</p>
            <p class="text-lg leading-relaxed mb-4">
              Miami does not throw one New Year's Eve. It throws several, then puts them all on the same causeways at midnight.
            </p>
            <p class="text-lg md:text-xl leading-relaxed">
              <strong>
                For most plans on Thursday, December 31, 2026, start with a chauffeured <a href="/cars/mercedes-maybach-gls-600" class={linkClass}>{label(gls)}</a> rental, from {usd(chauffeurHourly.amount)} an hour. Official fireworks are confirmed at Bayfront Park in downtown Miami and on Miami Beach. Self-drive only if someone in the car is not drinking. If a designated driver is taking you to dinner, the <a href="/mercedes-s580-rental-miami" class={linkClass}>{label(s580)}</a> is {usd(s580.price)} a day, or {usd(s580.threeDayDeal)} a day for {days3} days or more.
              </strong>
            </p>

            <table class="w-full text-sm mt-6">
              <thead>
                <tr class="text-left border-b border-black/10">
                  <th scope="col" class="py-2 pr-3 font-semibold">Plan</th>
                  <th scope="col" class="py-2 pr-3 font-semibold">Car</th>
                  <th scope="col" class="py-2 font-semibold">Rate</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-black/10">
                  <th scope="row" class="py-2 pr-3 font-normal text-left">Chauffeur for the night</th>
                  <td class="py-2 pr-3">{label(gls)}</td>
                  <td class="py-2">From {usd(chauffeurHourly.amount)}/hour</td>
                </tr>
                <tr class="border-b border-black/10">
                  <th scope="row" class="py-2 pr-3 font-normal text-left">Designated-driver sedan</th>
                  <td class="py-2 pr-3">{label(s580)}</td>
                  <td class="py-2">{usd(s580.price)}/day ({usd(s580.threeDayDeal)} at {days3}+ days)</td>
                </tr>
                <tr class="border-b border-black/10">
                  <th scope="row" class="py-2 pr-3 font-normal text-left">Group SUV, self-drive if sober</th>
                  <td class="py-2 pr-3"><a href="/lamborghini-urus-rental-miami" class={linkClass}>{label(urus)}</a> or <a href="/g-wagon-rental-miami" class={linkClass}>{label(g63)}</a></td>
                  <td class="py-2">{usd(urus.price)} or {usd(g63.price)}/day</td>
                </tr>
                <tr>
                  <th scope="row" class="py-2 pr-3 font-normal text-left">Maybach, self-drive or chauffeur</th>
                  <td class="py-2 pr-3">{label(gls)} or <a href="/cars/mercedes-maybach-s580" class={linkClass}>{label(maybachS)}</a></td>
                  <td class="py-2">
                    {sameMaybachRate
                      ? `${usd(gls.price)}/day (${usd(gls.threeDayDeal)} at ${days3}+ days)`
                      : `${label(gls)} ${dayRate(gls)} (${stayRate(gls)}); ${label(maybachS)} ${dayRate(maybachS)} (${stayRate(maybachS)})`}
                  </td>
                </tr>
              </tbody>
            </table>

            <p class="mt-5 text-base leading-relaxed">
              Have the dates? Use the form above. It opens on the {label(gls)}; you can switch the car. WhatsApp sits under the form, at {business.phoneDisplay}.
            </p>
            <p class="mt-4 text-sm leading-relaxed">
              <span class="text-black/60">Jump to:</span>{' '}
              <a href="#countdown-miami-at-bayfront-park" class={linkClass}>Countdown Miami at Bayfront Park</a>
              <span aria-hidden="true"> · </span>
              <a href="#new-years-eve-on-miami-beach-and-south-beach" class={linkClass}>New Year's Eve on Miami Beach</a>
              <span aria-hidden="true"> · </span>
              <a href="#which-car-for-the-night" class={linkClass}>Which car for the night</a>
              <span aria-hidden="true"> · </span>
              <a href="#chauffeur-or-drive-yourself" class={linkClass}>Chauffeur or drive yourself</a>
              <span aria-hidden="true"> · </span>
              <a href="#how-to-book" class={linkClass}>How to book</a>
            </p>
          </div>

          <div class="lg:grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] lg:gap-14 xl:gap-20">
            <aside class="mb-10 lg:mb-0">
              <nav aria-label="Table of contents" class="not-prose lg:sticky lg:top-28 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
                <h2 class="font-display text-base font-bold mb-3">On this page</h2>
                <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-2.5 text-sm">
                  {toc.map((t, i) => (
                    <li>
                      <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                        <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>

            <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:scroll-mt-28 prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm prose-h2:mt-12 prose-h2:pt-8 prose-h2:border-t prose-h2:border-black/10 first:prose-h2:mt-0 first:prose-h2:pt-0 first:prose-h2:border-0">

        <h2 id="countdown-miami-at-bayfront-park">Countdown Miami at Bayfront Park</h2>

        <p>
          Downtown Miami's official celebration is <a href="https://thecountdownmiami.com/2027/" target="_blank" rel="noopener noreferrer">The Countdown Miami 2027</a>, presented by the Bayfront Park Management Trust at Bayfront Park, 301 Biscayne Boulevard.
        </p>
        <p>
          It is on Thursday, December 31, 2026. Doors open at 5:00 p.m. The festival runs until late, with live music, food, and bars on site. The countdown and fireworks over Biscayne Bay are at midnight.
        </p>
        <p>
          General admission is free. RSVP on the official site; VIP upgrades are offered for reserved areas and private bars. The published lineup is Afrojack, Sean Paul, Mario, Oscar De Leon, and Wilfrido Vargas, hosted by DJ M Dot.
        </p>
        <p>
          We deliver to hotels and residences in Miami. We do not promise a specific curb at the park gates, and we will not guess at unpublished road closures. If you are going to the countdown, a chauffeur who can drop you nearby and return after midnight is usually simpler than parking downtown yourself.
        </p>

        <figure class="not-prose my-10">
          <img src={urusPhoto.src} srcset={urusPhoto.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={urusPhoto.width} height={urusPhoto.height} alt={urusPhoto.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">A waterfront drop-off, not a parking hunt at midnight. We will not promise a curb at the park gates.</figcaption>
        </figure>

        <h2 id="new-years-eve-on-miami-beach-and-south-beach">New Year's Eve on Miami Beach and South Beach</h2>

        <p>
          Miami Beach has its own official program, published by the <a href="https://www.miamibeachfl.gov/celebrate-the-holidays-in-miami-beach/" target="_blank" rel="noopener noreferrer">City of Miami Beach</a> on November 25, 2026.
        </p>
        <p>
          <a href="https://www.orchestramiami.org/new-years-eve-2026" target="_blank" rel="noopener noreferrer">Orchestra Miami's New Year's Eve Celebration</a> is a free concert on the sand at 21st Street Beach, between 21st and 22nd Streets, east of Collins Avenue. Music starts at 8:00 p.m. with the Orchestra Miami String Quartet. The full orchestra takes the stage at 10:00 p.m. with special guests AfroBeta. Fireworks at midnight are sponsored by the city.
        </p>
        <p>
          Separately, fireworks on Ocean Drive begin at 11:59 p.m. at the Lummus Park beachfront, presented by the city and the Ocean Drive Association.
        </p>
        <p>
          The city is running free trolleys from 8:00 a.m. on December 31 until 2:00 a.m. on January 1, and free shuttles from several Beach garages to Washington Avenue between 11th and 12th Streets from 4:00 p.m. until 2:00 a.m.
        </p>
        <p>
          Ocean Drive traffic rules for the night had not been confirmed as of late November 2026, so check the city's latest notice before a self-driven drop-off on the strip. A chauffeur can drop you nearby and collect you afterward.
        </p>
        <p>
          Friday, January 1, has a free concert at Lummus Park, 12th Street and Ocean Drive, from 6:00 p.m. to 7:30 p.m. Saturday, January 2, is Superar Saturday, a supercar showcase on Ocean Drive. A rental of {days3} days or more can cover the night of the 31st and that weekend drive at the lower daily rate.
        </p>
        <p>
          Hotel and club nights are ticketed by the venues. If that is your plan, treat the car as the way there and back, not something to leave on the strip at midnight. For delivery on the Beach, see the exotic car rental in South Beach page linked above.
        </p>

        <figure class="not-prose my-10">
          <img src={s580Photo.src} srcset={s580Photo.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={s580Photo.width} height={s580Photo.height} alt={s580Photo.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">When someone in the car is staying sober, the {label(s580)} is the better buy at {usd(s580.price)} a day.</figcaption>
        </figure>

        <h2 id="which-car-for-the-night">Which car for the night</h2>

        <p>
          Most New Year's Eve plans involve more than two people, a dinner, and a late finish. That is why we usually start with an SUV or a sedan, not a two-seat supercar.
        </p>
        <p>
          The <a href="/maybach-rental-miami">{label(gls)}</a> is the default for a chauffeured night: {gls.seats} executive seats and room for jackets and bags. The <a href="/cars/mercedes-maybach-s580">{label(maybachS)}</a> is the sedan at the same rate when the rear cabin matters more than cargo.
        </p>
        <p>
          If a Maybach badge is not the point, and someone is staying sober, the ordinary <a href="/mercedes-s580-rental-miami">{label(s580)}</a> is the better buy at {usd(s580.price)} a day.
        </p>
        <p>
          For a self-driven group that is not drinking, the <a href="/lamborghini-urus-rental-miami">{label(urus)}</a> and the <a href="/g-wagon-rental-miami">{label(g63)}</a> are the practical SUVs. The {label(cullinan)} is the chauffeur upgrade. Ask about that option when you send the dates. The Rolls-Royce page is linked above.
        </p>

        <figure class="not-prose my-10">
          <img src={cullinanPhoto.src} srcset={cullinanPhoto.srcSet} sizes="(min-width: 1140px) 760px, 100vw" width={cullinanPhoto.width} height={cullinanPhoto.height} alt={cullinanPhoto.alt} loading="lazy" decoding="async" class="w-full h-auto rounded-2xl" />
          <figcaption class="text-black/60 text-sm mt-3">The {label(cullinan)} is the chauffeur upgrade, at {usd(cullinan.price)} a day, or {usd(cullinan.threeDayDeal)} a day for {days3} days or more.</figcaption>
        </figure>

        <table>

---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import { business, telHref, mailHref, addressLine, hoursSummary, whatsappWith } from '@/data/business';
import { bookingSteps } from '@/data/booking-steps';

const SITE = 'https://www.lussarocollection.com';
const PAGE_URL = `${SITE}/contact`;

const waMsg = "Hi, I'd like to check availability with Lussaro Collection.";
const wa = whatsappWith(waMsg);

// Map embed is built from the same address the NAP and JSON-LD use, so the pin
// can never point somewhere the rest of the page doesn't claim. The `output=embed`
// form needs no API key.
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(addressLine)}&output=embed`;

// ContactPage points at the LocalBusiness node from SchemaOrg.astro rather than
// restating name/address/phone — one business entity, referenced by @id.
const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: `Contact ${business.brandName}`,
  url: PAGE_URL,
  mainEntity: { '@id': `${SITE}/#business` },
};
---
<Layout
  title="Contact Lussaro Collection — Miami Exotic Car Rental"
  description="Contact Lussaro Collection: WhatsApp, phone or email. Same-day exotic car delivery across Miami, South Beach and Brickell."
  schema={[contactSchema]}
>
  <Nav />

  <!-- HERO + DIRECT CONTACT -->
  <header class="bg-black pt-28 md:pt-36 pb-14 md:pb-20">
    <div class="max-w-6xl mx-auto px-5 md:px-8">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Get in touch</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold text-white tracking-tight text-balance">
        Contact {business.brandName}
      </h1>
      <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5 max-w-2xl">
        WhatsApp is our fastest channel — most messages get a reply in minutes.
        Call or email if you prefer, and we will come straight back to you.
      </p>

      <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr] mt-10 md:mt-14 items-start">
        <!-- DIRECT CONTACT -->
        <div class="rounded-[24px] border border-white/10 bg-[#0f0f0f] p-6 md:p-8">
          <a href={wa} data-cta="contact_whatsapp" target="_blank" rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 bg-[#c9a96e] text-black px-7 py-4 rounded-full font-semibold hover:bg-white transition">
            Message us on WhatsApp <span class="w-2 h-2 rounded-full bg-[#1f7a3f]"></span>
          </a>
          <a href={telHref} data-cta="contact_call"
            class="flex items-center justify-center gap-2 mt-3 border border-white/20 text-white px-7 py-4 rounded-full font-medium hover:border-[#c9a96e] hover:text-[#c9a96e] transition">
            Call {business.phoneDisplay}
          </a>

          <dl class="mt-8 space-y-5 text-sm border-t border-white/10 pt-7">
            <div>
              <dt class="text-white/40 uppercase tracking-[0.22em] text-[11px] mb-1.5">Phone</dt>
              <dd><a href={telHref} class="text-white/80 hover:text-white transition-colors">{business.phoneDisplay}</a></dd>
            </div>
            {mailHref && (
              <div>
                <dt class="text-white/40 uppercase tracking-[0.22em] text-[11px] mb-1.5">Email</dt>
                <dd><a href={mailHref} class="text-white/80 hover:text-white transition-colors">{business.email}</a></dd>
              </div>
            )}
            <div>
              <dt class="text-white/40 uppercase tracking-[0.22em] text-[11px] mb-1.5">Hours</dt>
              <dd class="text-white/80">{hoursSummary}</dd>
            </div>
            <div>
              <dt class="text-white/40 uppercase tracking-[0.22em] text-[11px] mb-1.5">Address</dt>
              <dd>
                <address class="not-italic text-white/80 leading-relaxed">
                  {business.legalName}<br />
                  {business.street}<br />
                  {business.city}, {business.region} {business.postalCode}
                </address>
                <a href={business.googleMaps} target="_blank" rel="noopener noreferrer"
                  class="inline-block mt-2 text-[#c9a96e] hover:text-white transition-colors">Open in Google Maps →</a>
              </dd>
            </div>
          </dl>
        </div>

        <!-- MAP -->
        <div class="rounded-[24px] overflow-hidden border border-white/10 bg-[#0f0f0f]">
          <iframe
            src={mapSrc}
            title={`Map showing ${business.brandName} at ${addressLine}`}
            width="100%"
            height="420"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="block w-full"
          ></iframe>
        </div>
      </div>
    </div>
  </header>

  <!-- HOW BOOKING WORKS -->
  <section class="bg-black border-t border-white/5 py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-10">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">How booking works</p>
        <h2 class="font-display text-3xl md:text-4xl font-bold text-white tracking-tight">Three steps, start to keys</h2>
      </div>
      <div class="reveal grid gap-8 md:grid-cols-3">
        {bookingSteps.map((s) => (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full border border-[#c9a96e]/40 text-[#c9a96e] flex items-center justify-center mx-auto mb-5 font-display text-xl">{s.n}</div>
            <h3 class="font-display text-xl font-semibold text-white mb-2">{s.t}</h3>
            <p class="text-white/50 leading-relaxed">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ENQUIRY FORM -->
  <section id="enquiry" class="bg-[#0c0c0c] border-t border-white/5 py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-8">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Send an enquiry</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white tracking-tight text-balance">Tell us what you need</h2>
        <p class="text-white/55 mt-3">Prefer to write it out? Send your details and we will confirm availability.</p>
      </div>
      <LeadForm client:visible />
    </div>
  </section>

  <StickyMobileCta message={waMsg} />
</Layout>

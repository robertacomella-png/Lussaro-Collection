---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import Car3DViewer from '@/components/hero/Car3DViewer.jsx';
import FleetCollection from '@/components/fleet/FleetCollection.astro';
import { Phone } from 'lucide-react';
import { business, telHref, whatsappWith } from '@/data/business';
---
<Layout
  title="Luxury & Exotic Car Rental Miami | Lussaro Collection"
  description="Rent a Lamborghini, Ferrari or Rolls-Royce in Miami from $445/day. Delivered to your hotel, home or airport. Book on WhatsApp in minutes."
>
  <Nav />

  <!-- HERO — cinematic photo: text top, CTAs bottom (mobile) / centered (desktop) -->
  <header class="relative min-h-[100svh] flex flex-col overflow-hidden bg-black">
    <div class="absolute inset-0">
      <picture>
        <source media="(min-width: 768px)" srcset="https://ik.imagekit.io/8i3ae7fac/cars-14.jpg?tr=w-1920,q-80,f-webp" />
        <img src="https://ik.imagekit.io/8i3ae7fac/cars-11.jpg?tr=w-800,q-75,f-webp" alt="Exotic car rental in Miami" class="w-full h-full object-cover opacity-70" fetchpriority="high" />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-b from-black/55 via-black/20 to-black/90"></div>
    </div>

    <div class="relative z-10 w-full flex-1 flex flex-col max-w-7xl mx-auto px-5 md:px-8 pt-24 md:pt-[24svh] pb-[63px] md:pb-20 text-center">
      <!-- TEXT — top -->
      <div>
        <p class="text-[#c9a96e] tracking-[0.35em] uppercase text-[11px] md:text-xs font-medium mb-4">Miami's Exotic Fleet · From $445/day</p>
        <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.95] tracking-tight text-white">
          Drive the <span class="text-[#c9a96e]">Extraordinary</span>
        </h1>
        <p class="text-white/70 text-base md:text-lg max-w-md mx-auto mt-5 font-light">
          Lamborghini, Rolls-Royce &amp; Ferrari — delivered to your door. Booked in 60 seconds.
        </p>
      </div>

      <!-- CTAs + rating — bottom on mobile and desktop -->
      <div class="mt-auto">
        <div class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
          <a href="#fleet" class="cta-shine flex-1 inline-flex items-center justify-center bg-[#c9a96e] text-black px-7 py-4 rounded-full font-semibold whitespace-nowrap hover:bg-white transition-colors">See Cars &amp; Prices ↓</a>
          <a href={telHref} data-cta="hero" data-call-inline class="call-pop flex-1 order-first sm:order-none inline-flex items-center justify-center gap-2 bg-[#16a34a] text-white px-7 py-4 rounded-full font-semibold whitespace-nowrap shadow-[0_8px_24px_rgba(22,163,74,0.5)] ring-1 ring-white/15 hover:bg-[#22c55e] transition-colors">
            <Phone className="w-4 h-4 shrink-0" /> Call {business.phoneDisplayShort}
          </a>
        </div>
        <div class="mt-5 flex items-center justify-center gap-3 text-sm text-white/55">
          <span class="text-[#c9a96e]">★★★★★</span> 5.0 Google · Miami Delivery
        </div>
      </div>
    </div>
  </header>

  <!-- TRUST STRIP -->
  <section class="bg-black border-y border-white/5 py-6">
    <div class="max-w-7xl mx-auto px-5 md:px-8 flex flex-wrap items-center justify-center md:justify-between gap-x-8 gap-y-3 text-center text-white/55 text-sm">
      <span>⚡ Same-day booking</span>
      <span class="hidden md:inline text-white/15">|</span>
      <span>🛡️ Flexible insurance options</span>
      <span class="hidden md:inline text-white/15">|</span>
      <span>🚗 Delivered to your door</span>
      <span class="hidden md:inline text-white/15">|</span>
      <span>💬 60-second WhatsApp booking</span>
    </div>
  </section>

  <!-- FLEET — "The Collection" (shared with /fleet so the two stay identical) -->
  <FleetCollection id="fleet" />

  <!-- 3D MOMENT (the accent) -->
  <section class="relative bg-black py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(70% 60% at 50% 50%, rgba(201,169,110,0.12), transparent 70%);"></div>
    <div class="reveal relative z-10 max-w-3xl mx-auto px-5 md:px-8 text-center">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Interactive</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-5">See it like you're there.</h2>
      <p class="text-white/60 leading-relaxed mb-8">Spin our signature Lamborghini Urus in real 3D — every angle, every detail, right from your screen.</p>
      <button data-open-3d type="button" class="inline-flex items-center gap-2 bg-[#c9a96e] text-black px-9 py-4 rounded-full font-semibold hover:bg-white transition">
        Launch 3D Experience ◆
      </button>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="bg-[#0c0c0c] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-14">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">How It Works</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white">Booked in three steps.</h2>
      </div>
      <div class="reveal grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#c9a96e]/40 text-[#c9a96e] flex items-center justify-center mx-auto mb-5 font-display text-xl">1</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">Message us</h3>
          <p class="text-white/50 leading-relaxed">Tap WhatsApp or call. Tell us the car and dates — we reply in minutes.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#c9a96e]/40 text-[#c9a96e] flex items-center justify-center mx-auto mb-5 font-display text-xl">2</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">We deliver</h3>
          <p class="text-white/50 leading-relaxed">White-glove delivery anywhere in Miami — hotel, home, or airport.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#c9a96e]/40 text-[#c9a96e] flex items-center justify-center mx-auto mb-5 font-display text-xl">3</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">You drive</h3>
          <p class="text-white/50 leading-relaxed">Keys in hand, full orientation, 24/7 support. Just enjoy the road.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEW -->
  <section id="reviews" class="bg-[#f7f5f0] text-[#0a0a0a] py-24">
    <!-- TODO: add 2–3 real customer testimonials when available -->
    <div class="reveal max-w-3xl mx-auto px-5 md:px-8 text-center">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-4">Trusted in Miami</p>
      <p class="text-[#c9a96e] text-3xl mb-5">★★★★★</p>
      <p class="font-display text-2xl md:text-3xl font-semibold leading-snug">Rated 5.0 on Google</p>
      <p class="text-[#0a0a0a]/55 mt-4 max-w-md mx-auto">White-glove delivery, immaculate vehicles, and concierge service across South Beach and Brickell.</p>
      <a href={business.googleMaps} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-6 text-[#0a0a0a] border-b border-[#0a0a0a]/30 hover:border-[#c9a96e] pb-1 transition">Read our Google reviews →</a>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section id="contact" class="bg-black py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-10">
        <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white">Request availability</h2>
        <p class="text-white/55 mt-3 max-w-md mx-auto">Tell us what and when — we'll confirm your exotic in minutes.</p>
      </div>
      <LeadForm client:visible />
    </div>
  </section>

  <CtaBand title={'Your Miami arrival,<br><span class="text-[#c9a96e]">unforgettable.</span>'} />

  <StickyMobileCta />
  <Car3DViewer client:idle />
</Layout>

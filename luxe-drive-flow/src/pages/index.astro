---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import LeadForm from '@/components/site/LeadForm.jsx';
import Car3DViewer from '@/components/hero/Car3DViewer.jsx';
import FleetCollection from '@/components/fleet/FleetCollection.astro';
import { Phone } from 'lucide-react';
import WhatsAppIcon from '@/components/site/WhatsAppIcon.astro';
import { business, telHref, whatsappWith } from '@/data/business';
import { cars } from '@/data/cars';
import { rentalTerms, deliveryEachWaySummary, discountSummary } from '@/data/rental-terms';
// Derived so every WhatsApp link says which page it was tapped from without
// a path being threaded through each route by hand.
const waPage = Astro.url.pathname.replace(/(.)\/$/, '$1');

const SITE = 'https://www.lussarocollection.com';
const usd = (n) => `$${n.toLocaleString('en-US')}`;
const fleetFrom = Math.min(...cars.map((c) => c.price));
const perDayMiles = rentalTerms.mileage.includedPerDay;

// The same ItemList /fleet emits for the identical car grid. The homepage
// rendered the grid without it, so the one page most likely to be crawled
// first said nothing structured about what it lists.
const fleetSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Lussaro Collection — Miami luxury and exotic car rental fleet',
  itemListElement: cars.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    url: `${SITE}/cars/${c.slug}`,
  })),
};

const heroWa = whatsappWith(
  "Hi, I'd like to book a car with Lussaro Collection. Which dates do you have open?"
, { page: waPage });
---
<Layout
  title="Luxury & Exotic Car Rental Miami | Lussaro Collection"
  description={`Luxury and exotic car rental in Miami: Lamborghini, Ferrari and Rolls-Royce from ${usd(fleetFrom)} a day, delivered to your hotel, home or airport. Booked on WhatsApp.`}
  schema={[fleetSchema]}
>
  <Nav />

  <!-- HERO — cinematic photo: text top, CTAs bottom (mobile) / centered (desktop) -->
  <header class="relative min-h-[100svh] flex flex-col overflow-hidden bg-black">
    <div class="absolute inset-0">
      {/* HERO VIDEO TEST — added 22 Oct 2026.
          The <picture> below is unchanged and remains the LCP element: a
          <video> can never be the LCP paint, so removing the image would blank
          the first frame and cost Core Web Vitals outright. The video sits on
          top and fades in only once it can actually play, so a slow connection
          simply keeps the photograph.

          ONE element, two sources. The file is chosen by matchMedia rather
          than a <source media> attribute, which WebKit ignores inside <video>
          even though it honours it in <picture>. A second <video> would mean
          two elements fighting over the same slot.

          To revert: delete this element and the inline script below it. */}
      <video
        id="hero-video"
        class="absolute inset-0 w-full h-full object-cover brightness-[0.8] md:brightness-[0.95] z-10 opacity-0 transition-opacity duration-500"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        tabindex="-1"
      ></video>
      <script is:inline>
        // Autoplay needs muted + playsinline, both on the element. The source is
        // attached here rather than in markup so the file is never fetched on
        // desktop, or by anyone who asked for reduced motion.
        (() => {
          const start = () => {
            const v = document.getElementById('hero-video');
            if (!v || v.dataset.ready) return;

            // Reduced motion is the only gate now that both breakpoints have a
            // file. index.css honours the preference in three other places and
            // the hero should not be the exception.
            if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) return;

            // 767px matches the md: breakpoint the <picture> switches on, so the
            // video and the still it replaces always agree about orientation.
            const isPhone = window.matchMedia('(max-width: 767px)').matches;

            v.dataset.ready = '1';
            // The muted PROPERTY, not only the attribute — Safari and Chrome
            // check the property before permitting autoplay.
            v.muted = true;
            // Reveal on 'playing', not before. The element used to carry a
            // poster and sit opaque above the <picture>, which produced a
            // three-way flicker on every load: the hero photo painted, the
            // poster covered it, then setting .src reloaded the element and it
            // went transparent again — showing the photo a second time — before
            // the first video frame. Invisible until frames are actually
            // rendering means one transition, and a stall just keeps the photo.
            v.addEventListener('playing', () => { v.style.opacity = '1'; }, { once: true });
            v.src = isPhone ? '/hero/hero-mobile.mp4' : '/hero/hero-desktop.mp4';
            v.play().catch((e) => { console.warn('hero autoplay blocked:', e.name); });
          };
          // Deferred past load. Attaching the source at parse time put a
          // 2.4 MB download in direct competition with the LCP image, which on
          // a throttled connection delays the very paint the video sits behind.
          if (document.readyState === 'complete') requestAnimationFrame(start);
          else window.addEventListener('load', () => requestAnimationFrame(start), { once: true });
          document.addEventListener('astro:page-load', start);
        })();
      </script>
      <picture>
        {/* Desktop hero is a local WebP, not an ik.imagekit.io URL: this shot
            (the Urus on silver performance rims) was never uploaded to the CDN,
            and the car photos have been migrating to committed local variants
            anyway — see the note at the top of scripts/optimize-images.mjs.
            Generated from "hero image perf rims.jpg" (3840x2560) at width 1920,
            WebP q80, matching the w-1920,q-80,f-webp transform this slot used to
            request from ImageKit. That script only covers /cars and /gallery at
            700/1200, so regenerate this one directly with sharp if it changes.
            Mobile is NO LONGER the same shoot. It is a still lifted from
            hero-mobile.mp4 at the 6s mark, cropped identically (1850:3288 at
            x155 y500 of the 2160x3840 source), so the photograph and the video
            are the same frame of the same car. Before this they were different
            shoots entirely, and the handover read as a cut between two
            unrelated images. Regenerate both together or they drift apart.

            Mobile ships a srcset, NOT a lone 800px file. The CDN slot this
            replaced requested w-800, and at 800 the hero was visibly soft: with
            object-cover on a 100svh box the image covers by HEIGHT, so on a
            430x932 phone it paints ~614 CSS px wide — wider than the viewport —
            and at DPR 3 that wants ~1840px of image. An 800px file was being
            upscaled 2.3x. Hence 1200 and 1600 variants.

            sizes is 150vw rather than 100vw for the same reason: the painted
            width runs about 1.43x the viewport width on typical phone aspects
            (it is viewportHeight x 0.66 / viewportWidth), so 100vw would
            under-request and reintroduce the blur. */}
        <source media="(min-width: 768px)" srcset="/hero/hero-perf-rims-1920.webp" />
        <img src="/hero/hero-vertical-800.webp"
             srcset="/hero/hero-vertical-800.webp 800w, /hero/hero-vertical-1200.webp 1200w, /hero/hero-vertical-1600.webp 1600w"
             sizes="150vw"
             alt="Exotic car rental in Miami" class="w-full h-full object-cover brightness-[0.8] md:brightness-[0.95]" fetchpriority="high" />
      </picture>
      {/* The 0.8 darkening is kept on mobile and all but lifted on desktop.
          Measured on the shipped files: the mobile clip averages 120/255 luma,
          the desktop clip 88.5 — the desktop footage is dusk with traffic and
          is already 26% darker before any filter, so the same 0.8 compounds
          into something murky. White headline over the region it actually sits
          in measures 7.11:1 at 0.8, 6.01:1 at 0.9 and 5.10:1 unfiltered, so
          none of this is holding the text up; 0.95 keeps a little headroom for
          the brightest frames.

          Scrim confined to the bottom quarter of the hero: 60% black at the
          very foot, fading to nothing 25% up. Everything above is the clean
          photo. It exists to hold contrast under the CTA row and to blend the
          hero into the black section beneath — the nav carries its own
          bg-black/40 + backdrop blur and needs nothing from this.
          Inline rather than Tailwind from/via/to, which cannot place a stop at
          an arbitrary percentage; the radial glows here are written the same way. */}
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: linear-gradient(to top, rgba(0,0,0,0.60) 0%, rgba(0,0,0,0) 25%);"
      ></div>
    </div>

    <div class="relative z-10 w-full flex-1 flex flex-col max-w-7xl mx-auto px-5 md:px-8 pt-24 md:pt-[15svh] pb-[33px] md:pb-20 text-center md:text-left">
      <!-- TEXT — top -->
      <div>
        {/* Headline first, the fleet line under it. Optical alignment: the
            headline carries tracking-tight and a large left side bearing on the
            "D", while the line below is 11px uppercase at 0.35em — set flush
            they read as misaligned even though both box edges sit on the same
            x. The -0.035em pull on the headline lines the glyphs up rather than
            the boxes, which is what the eye actually measures. */}
        <h1 class="font-display text-5xl font-bold leading-[1.02] tracking-tight text-white [text-shadow:0_2px_24px_rgba(0,0,0,0.5)] md:whitespace-nowrap md:text-[clamp(2rem,5.4vw,5.25rem)] md:-ml-[0.035em]">
          Drive the <span class="text-[#ff1516]">Extraordinary</span>
        </h1>
        {/* White, not red — this line sits over a photograph, and small red
            letterforms at 11px against mid-tone sky were unreadable even with a
            shadow. White is the logo's other colour, so the hero still reads as
            brand; the red is carried by "Extraordinary" and the CTA beneath.

            Letter-spacing adds a trailing space after the final character, so
            the text block is wider than the glyphs — harmless on a centred
            line, visible when it has to align to a left edge. */}
        <p class="text-white/90 [text-shadow:0_2px_10px_rgba(0,0,0,0.8)] tracking-[0.35em] uppercase text-[10px] md:text-[11px] font-semibold mb-3.5 md:mb-0 md:mt-4">Miami's Exotic Fleet · From $399/day</p>
        {/* On mobile this stays under the headline. On desktop it moves to the
            foot with the buttons — layout B keeps a clear band through the
            middle of frame so the car is never behind type. */}
        <p class="md:hidden text-white/70 text-base max-w-md mx-auto mt-5 font-light">
          Lamborghini, Rolls-Royce &amp; Ferrari — delivered to your door. Booked in 60 seconds.
        </p>
      </div>

      <!-- CTAs + rating — bottom on mobile and desktop -->
      <div class="mt-auto">
        {/* Two contact CTAs, structurally identical — same pill, padding,
            weight, icon gap, ring, shadow and pulse — so they read as one pair
            and differ only by channel colour. Browsing the fleet keeps its
            white treatment but moves beneath them.

            #128f42 is not WhatsApp's #25D366: white type needs 4.5:1 and the
            brand green gives 1.9:1, so the fill is darkened until the label
            holds 4.17:1. That is deliberately pitched just above the 3.91:1
            this file's palette note accepts for white-on-red — no reason to
            hold this button to a stricter bar than the one beside it. The
            halo stays true #25D366, since a glow carries no text. */}
        {/* Side by side from the smallest screen up, so the hero video is not
            buried under a stack of three full-width pills. The labels shorten
            below sm because "Call (645) 248-7305" cannot fit in half of a 390px
            viewport — the number returns as soon as there is room for it.
            min-h-[48px] keeps the touch target at the accessible floor even
            though the vertical padding drops. */}
        {/* Desktop only: one line, never two. nowrap so a narrow laptop cannot
            break it — a marque list that wraps reads as a sentence. */}
        <p class="hidden md:block text-white/75 text-sm font-light mb-5 whitespace-nowrap">
          Lamborghini<span class="text-white/35 px-2">·</span>Rolls-Royce<span class="text-white/35 px-2">·</span>Ferrari<span class="text-white/35 px-2">·</span>Mercedes
        </p>
        <div class="flex flex-row gap-2.5 sm:gap-3 max-w-sm md:max-w-md mx-auto md:mx-0">
          <a href={heroWa} data-cta="hero" target="_blank" rel="noopener noreferrer" class="wa-pop flex-1 min-h-[48px] inline-flex items-center justify-center gap-2 bg-[#128f42] text-white px-3 py-3 sm:px-5 sm:py-3 rounded-full font-semibold text-sm sm:text-sm whitespace-nowrap shadow-[0_8px_24px_rgba(37,211,102,0.5)] ring-1 ring-white/15 hover:bg-[#0f7536] transition-colors">
            <WhatsAppIcon class="w-4 h-4 shrink-0" />
            WhatsApp
          </a>
          <a href={telHref} data-cta="hero" data-call-inline class="call-pop flex-1 min-h-[48px] order-first sm:order-none inline-flex items-center justify-center gap-2 bg-[#e00e10] text-white px-3 py-3 sm:px-5 sm:py-3 rounded-full font-semibold text-sm sm:text-sm whitespace-nowrap shadow-[0_8px_24px_rgba(255,21,22,0.45)] ring-1 ring-white/15 hover:bg-[#c40c0e] transition-colors">
            <Phone className="w-4 h-4 shrink-0" />
            Call
          </a>
        </div>
        {/* Matched to the Call/WhatsApp pills above: same vertical rhythm, same
            type scale, same 48px floor. It was the heaviest button in the group
            while being the least urgent of the three. */}
        {/* "Delivered to your door" replaces "Miami Delivery" here rather than
            going in the marque line: it is a reassurance, not a product list,
            so it belongs beside the rating where people look for one. */}
        <div class="mt-5 flex items-center justify-center md:justify-start gap-3 text-sm text-white/55">
          <span class="text-[#ff1516]">★★★★★</span> 5.0 Google · Delivered to your door
        </div>

        {/* The cue replaces the white "See Cars & Prices" pill on mobile too —
            that pill was the brightest object in the hero and sat on the car.
            Static in the stack on a phone, where an absolutely positioned cue
            would land under the sticky CTA; centred at the foot of frame on
            desktop, which is dead road. */}
        <a
          href="#fleet"
          class="hero-cue mt-6 md:mt-0 self-center md:self-auto flex flex-col items-center gap-1.5 text-white/75 hover:text-white transition-colors md:absolute md:bottom-6 md:left-1/2 md:-translate-x-1/2"
          aria-label="Scroll to cars and prices"
        >
          <span class="text-[11px] tracking-[0.22em] uppercase">See cars &amp; prices</span>
          <svg class="hero-cue-chev w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </a>
      </div>

    </div>
  </header>

  <!-- TRUST STRIP -->
  <section class="bg-black border-y border-white/5 py-6">
    <div class="max-w-7xl mx-auto px-5 md:px-8 flex flex-wrap items-center justify-center md:justify-between gap-x-8 gap-y-3 text-center text-white/55 text-sm">
      <span>⚡ Same-day booking</span>
      <span class="hidden md:inline text-white/15" aria-hidden="true">|</span>
      <span>🛡️ Flexible insurance options</span>
      <span class="hidden md:inline text-white/15" aria-hidden="true">|</span>
      <span>🚗 Delivered to your door</span>
      <span class="hidden md:inline text-white/15" aria-hidden="true">|</span>
      <span>💬 60-second WhatsApp booking</span>
    </div>
  </section>

  <!-- FLEET — "The Collection" (shared with /fleet so the two stay identical) -->
  <FleetCollection id="fleet"
    eyebrow="Luxury & Exotic · Miami"
    heading="The cars we rent in Miami" />

  <!-- 3D MOMENT (the accent) -->
  <section class="relative bg-black py-20 md:py-28 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(70% 60% at 50% 50%, rgba(255, 21, 22, 0.06), transparent 70%);"></div>
    <div class="reveal relative z-10 max-w-3xl mx-auto px-5 md:px-8 text-center">
      <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Interactive</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-5">See it like you're there.</h2>
      <p class="text-white/60 leading-relaxed mb-8">Spin our signature Lamborghini Urus in real 3D — every angle, every detail, right from your screen.</p>
      <button data-open-3d type="button" class="inline-flex items-center gap-2 bg-white text-black px-9 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">
        Launch 3D Experience ◆
      </button>
    </div>
  </section>

  <!-- PROCESS -->
  <section id="process" class="bg-[#0c0c0c] py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-14">
        <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-3">How It Works</p>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-white">How renting a car in Miami works</h2>
      </div>
      <div class="reveal grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#ff1516]/40 text-[#ff1516] flex items-center justify-center mx-auto mb-5 font-display text-xl">1</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">Message us</h3>
          <p class="text-white/50 leading-relaxed">Tap WhatsApp or call. Tell us the car and dates — we reply in minutes.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#ff1516]/40 text-[#ff1516] flex items-center justify-center mx-auto mb-5 font-display text-xl">2</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">We deliver</h3>
          <p class="text-white/50 leading-relaxed">White-glove delivery anywhere in Miami — hotel, home, or airport.</p>
        </div>
        <div class="text-center">
          <div class="w-14 h-14 rounded-full border border-[#ff1516]/40 text-[#ff1516] flex items-center justify-center mx-auto mb-5 font-display text-xl">3</div>
          <h3 class="font-display text-xl font-semibold text-white mb-2">You drive</h3>
          <p class="text-white/50 leading-relaxed">Keys in hand, full orientation, 24/7 support. Just enjoy the road.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEW -->
  <section id="reviews" class="bg-[#ffffff] text-[#0a0a0a] py-24">
    <!-- TODO: add 2–3 real customer testimonials when available -->
    <div class="reveal max-w-3xl mx-auto px-5 md:px-8 text-center">
      <p class="text-[#e00e10] tracking-[0.3em] uppercase text-xs mb-4">Trusted in Miami</p>
      <p class="text-[#e00e10] text-3xl mb-5">★★★★★</p>
      <p class="font-display text-2xl md:text-3xl font-semibold leading-snug">Rated 5.0 on Google</p>
      <p class="text-[#0a0a0a]/60 mt-4 max-w-md mx-auto">White-glove delivery, immaculate vehicles, and concierge service across South Beach and Brickell.</p>
      <a href={business.googleMaps} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-6 text-[#0a0a0a] border-b border-[#0a0a0a]/30 hover:border-[#e00e10] pb-1 transition">Read our Google reviews →</a>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section id="contact" class="bg-black py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 md:px-8">
      <div class="reveal text-center mb-10">
        <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-3">Reserve</p>
        <h2 class="font-display text-3xl md:text-5xl font-bold text-white">Request availability</h2>
        <p class="text-white/55 mt-3 max-w-md mx-auto">Tell us what and when — we'll confirm your exotic in minutes.</p>
      </div>
      <LeadForm client:visible />
    </div>
  </section>

  <CtaBand title={'Your Miami arrival,<br><span class="text-[#ff1516]">unforgettable.</span>'} />

  <StickyMobileCta />
  {/* client:visible, not client:idle. This bundle is 688 KB — three.js plus the
      viewer — and it sits at the very bottom of the page, yet client:idle
      fetched and executed it the moment the browser went idle, whether anyone
      scrolled here or not. Measured on the live site 22 Oct 2026: Total
      Blocking Time 1,190 ms on a mobile Lighthouse run, nearly all of it this.
      client:visible defers it until the viewer is actually approached. */}
  <Car3DViewer client:visible />
</Layout>

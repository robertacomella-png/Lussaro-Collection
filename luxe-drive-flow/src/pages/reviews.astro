---
import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import SmartLink from '@/components/site/SmartLink.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import { business, whatsappWith } from '@/data/business';
import { reviews, reviewCount, averageRating, relativeMonth } from '@/data/reviews';

const waMsg = "Hi, I'd like to check availability with Lussaro Collection.";
const wa = whatsappWith(waMsg);

// Build-time "now", so every card's relative date is measured from one instant.
const now = new Date();

// NO Review / AggregateRating JSON-LD ON THIS PAGE — DELIBERATE, DO NOT ADD.
//
// These are reviews collected by Google and displayed on Google. Google's
// structured-data policy is explicit that a site must not mark up reviews it
// gathered from, or that are shown on, a third-party site, and that reviews
// about the business itself hosted on that business's own pages are not
// eligible for review rich results. Marking these up would be self-serving
// review spam by Google's own definition and risks a manual action against the
// whole domain — for a star snippet Google already shows from the profile.
//
// The same reasoning is why cars/[slug].astro carries no aggregateRating.
//
// If first-party reviews are ever collected (a form on this site, moderated and
// stored by us), those WOULD be markup-eligible and could carry Review nodes.
// These five are not that.
---
<Layout
  title="Lussaro Collection Reviews — Miami Exotic Car Rental"
  description="What renters say about Lussaro Collection — real five-star Google reviews of our Lamborghini, Maybach and Rolls-Royce rentals in Miami."
>
  <Nav />

  <header class="bg-black pt-28 md:pt-36 pb-10 md:pb-14">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">What renters say</p>
      <h1 class="font-display text-4xl md:text-6xl font-bold text-white tracking-tight text-balance">
        {business.brandName} Reviews
      </h1>
      <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-white/60 text-sm">
        <span class="text-[#ff1516] text-base tracking-[0.15em]" aria-hidden="true">★★★★★</span>
        <span class="text-white font-medium">{averageRating.toFixed(1)} out of 5</span>
        <span class="text-white/50">·</span>
        <span>{reviewCount} reviews on Google</span>
      </p>
      <p class="mt-4 text-white/60 leading-relaxed">
        Every review below was left on our Google Business Profile and is reproduced word for
        word, exactly as written. Nothing here is edited, shortened or written by us.
      </p>
    </div>
  </header>

  <section class="bg-black pb-4">
    <div class="max-w-3xl mx-auto px-5 md:px-8 space-y-4">
      {reviews.map((r) => (
        <article class="rounded-[20px] border border-white/10 bg-[#0f0f0f] p-5 md:p-7">
          <div class="flex items-start gap-4">
            <div
              class="shrink-0 w-11 h-11 rounded-full bg-[#ff1516]/15 border border-[#ff1516]/25 flex items-center justify-center font-display text-lg font-semibold text-[#ff1516]"
              aria-hidden="true"
            >
              {r.name.trim().charAt(0).toUpperCase()}
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <p class="text-white font-medium">{r.name}</p>
                <p class="text-white/50 text-xs">{relativeMonth(r.month, now)}</p>
              </div>

              <p class="mt-1.5 text-[#ff1516] text-sm tracking-[0.15em]" aria-label={`${r.rating} out of 5 stars`}>
                <span aria-hidden="true">{'★'.repeat(r.rating)}</span>
              </p>

              {r.car && (
                <p class="mt-3">
                  <span class="inline-flex items-center rounded-full border border-white/12 bg-white/[0.04] px-3 py-1 text-[11px] uppercase tracking-wide text-white/55">
                    {r.car}
                  </span>
                </p>
              )}

              <p class="mt-3 text-white/70 leading-relaxed">{r.text}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-black py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-5 md:px-8">
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href={business.googleProfileLink}
          data-cta="reviews_google_profile"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center text-center border border-white/20 text-white px-6 py-4 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition"
        >
          Read all our reviews on Google
        </a>
        <a
          href={business.googleReviewLink}
          data-cta="reviews_leave_review"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 inline-flex items-center justify-center text-center border border-white/20 text-white px-6 py-4 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition"
        >
          Leave a review
        </a>
      </div>

      <SmartLink
        href="/fleet"
        data-cta="reviews_fleet"
        class="mt-3 w-full inline-flex items-center justify-center bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition"
      >
        Rent with us
      </SmartLink>

      <p class="mt-6 text-white/50 text-xs leading-relaxed">
        Rented with us? Leaving a review takes a minute and helps other people in Miami decide.
      </p>
    </div>
  </section>

  <CtaBand message={waMsg} />
  <StickyMobileCta message={waMsg} />
</Layout>

---
import { Phone, MessageCircle } from 'lucide-react';
const { message = "Hi, I'm interested in renting a luxury car with Lussaro Collection." } = Astro.props;
const wa = `https://wa.me/16452487305?text=${encodeURIComponent(message)}`;
---
<div
  id="sticky-cta"
  class="md:hidden fixed inset-x-3 z-50 flex gap-2.5 transition-transform duration-300 ease-out will-change-transform"
  style="bottom: calc(0.75rem + env(safe-area-inset-bottom));"
>
  <a
    href="tel:+16452487305"
    data-cta="sticky_mobile"
    class="flex-1 inline-flex items-center justify-center gap-2 bg-black/55 backdrop-blur-xl border border-white/15 text-white py-3.5 rounded-full font-medium shadow-[0_8px_30px_rgba(0,0,0,0.45)]"
  >
    <Phone className="w-4 h-4" /> Call
  </a>
  <a
    href={wa}
    data-cta="sticky_mobile"
    target="_blank"
    rel="noopener noreferrer"
    class="flex-1 inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-black py-3.5 rounded-full font-semibold shadow-[0_8px_30px_rgba(201,169,110,0.35)]"
  >
    <MessageCircle className="w-4 h-4 text-[#1f7a3f]" /> WhatsApp
  </a>
</div>

<script>
  // Hide on scroll-down, reveal on scroll-up. Re-queries so it survives view-transition navigations.
  (function () {
    let last = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const bar = document.getElementById('sticky-cta');
        if (!bar) return;
        const y = window.scrollY;
        bar.style.transform = y > last && y > 100 ? 'translateY(160%)' : 'translateY(0)';
        last = y;
      },
      { passive: true }
    );
  })();
</script>

---
// Sticky mobile contact pair — WhatsApp and Call as two equal pills pinned to
// the bottom edge (mobile only; desktop has its own pair in StickyCall).
//
// Two circular icon buttons stacked bottom-right, WhatsApp above Call —
// matching the left-to-right order the two take everywhere else. Covers a
// corner rather than a strip of every page, which matters on the one screen
// size where this floats over content for the entire scroll.
//
// Icon-only circles rather than labelled pills: the marks are the real WhatsApp
// glyph and a phone, which name themselves. This only became reasonable once
// WhatsAppIcon replaced lucide's generic bubble — that bubble read as "chat" and
// would have needed a word beside it.
//
// Side by side at 64px (w-16/h-16), comfortably past the 44px minimum. Square
// dimensions plus rounded-full is what makes them circles — padding-based
// sizing would track the icon and go oval.

//
// THE aria-label ON EACH ANCHOR IS LOAD-BEARING, not a nicety: no visible text
// remains, so it is the only thing naming these controls for a screen reader.
// Do not drop it. The desktop pair in StickyCall keeps its labels — there is
// room for them in a corner that is not competing with content.
//
// bottom is a calc with env(safe-area-inset-bottom) so the pair clears the home
// indicator on notched phones instead of sitting under the gesture bar.
//
// Hidden while any inline data-call-inline CTA is on screen, via the observer
// in Layout.astro — it keys off data-sticky-cta on the WRAPPER, since hiding a
// single anchor would strand the other pill on screen. Both clicks are
// auto-tracked off data-cta: tel: fires call_click, wa.me fires whatsapp_click.
import { Phone } from 'lucide-react';
import WhatsAppIcon from '@/components/site/WhatsAppIcon.astro';
import { business, telHref, whatsappWith } from '@/data/business';

const wa = whatsappWith(
  "Hi, I'd like to book a car with Lussaro Collection. Which dates do you have open?"
);
---
<div
  data-sticky-cta
  class="md:hidden fixed right-4 z-50 flex flex-row items-center gap-3 transition-[opacity,transform] duration-300 ease-out"
  style="bottom: calc(1rem + env(safe-area-inset-bottom));"
>
  <a
    href={wa}
    data-cta="sticky_mobile_wa"
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Message ${business.brandName} on WhatsApp`}
    class="wa-pop w-16 h-16 inline-flex items-center justify-center rounded-full bg-[#128f42] text-white ring-1 ring-white/15 active:scale-95 transition-transform duration-300 ease-out"
  >
    <WhatsAppIcon class="w-7 h-7" />
  </a>
  <a
    href={telHref}
    data-cta="sticky_mobile"
    aria-label={`Call ${business.brandName} at ${business.phoneDisplayShort}`}
    class="call-pop w-16 h-16 inline-flex items-center justify-center rounded-full bg-[#e00e10] text-white ring-1 ring-white/15 active:scale-95 transition-transform duration-300 ease-out"
  >
    <Phone className="w-7 h-7" />
  </a>
</div>

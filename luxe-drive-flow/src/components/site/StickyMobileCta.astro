---
// Sticky mobile "Call" button — a green pill in the bottom-right corner (mobile
// only; desktop has its own StickyCall pill). Phone icon beside a readable
// "Call" label, with the shared pulsing green halo (call-pop) so it draws the
// eye. Hidden while any inline data-call-inline CTA is on screen (observer in
// Layout.astro). The tel: click is auto-tracked as `call_click` via data-cta.
import { Phone } from 'lucide-react';
import { business, telHref, whatsappWith } from '@/data/business';
---
<a
  href={telHref}
  data-cta="sticky_mobile"
  aria-label={`Call ${business.brandName} at ${business.phoneDisplayShort}`}
  class="call-pop md:hidden fixed right-4 z-50 inline-flex items-center justify-center gap-2.5 px-6 py-4 rounded-full bg-[#e00e10] text-white font-semibold text-base shadow-[0_8px_24px_rgba(255,21,22,0.45)] ring-1 ring-white/15 active:scale-95 transition-[opacity,transform] duration-300 ease-out"
  style="bottom: calc(1rem + env(safe-area-inset-bottom));"
>
  <Phone className="w-5 h-5" />
  <span>Call</span>
</a>

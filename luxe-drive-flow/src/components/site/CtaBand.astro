---
import { business, telHref, whatsappWith } from '@/data/business';
const {
  title = 'Ready when you are.',
  subtitle = 'Same-day availability across Miami. Reserve in under a minute.',
  message = "Hi, I'm interested in renting a luxury car with Lussaro Collection.",
} = Astro.props;
const wa = whatsappWith(message);
---
<section class="relative py-24 text-center bg-gradient-to-r from-[#0a0a0a] via-[#161010] to-[#0a0a0a]">
  <div class="max-w-2xl mx-auto px-5">
    <h2 class="font-display text-3xl md:text-5xl font-bold text-white mb-4" set:html={title} />
    <p class="text-white/55 mb-8">{subtitle}</p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center max-w-md mx-auto">
      <a href={wa} data-cta="cta_band" target="_blank" rel="noopener noreferrer" class="flex-1 bg-white text-black px-8 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">Book on WhatsApp</a>
      <a href={telHref} data-cta="cta_band" class="flex-1 border border-white/25 text-white px-8 py-4 rounded-full font-medium hover:border-[#ff1516] hover:text-[#ff1516] transition">Call Now</a>
    </div>
  </div>
</section>

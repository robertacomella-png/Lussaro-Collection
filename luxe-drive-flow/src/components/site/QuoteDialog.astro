---
// "Get a quote" — a short lead form in a modal, opened by any element with
// [data-quote-open]. Posts to /api/lead, which forwards to the Rental
// Dashboard (the system of record) and emails a copy.
//
// A native <dialog> and a few lines of script rather than a React island: the
// opener sits in the hero, so it has to work on first tap, and client:load on
// a form nobody has opened yet would be paid for by every visitor.
//
// No date fields, by the owner's call (23 Nov 2026): name, phone, email, car.
import { fleet, carLabel } from '@/data/fleet';
import { business, telHref, whatsappWith } from '@/data/business';
import { Phone, X } from 'lucide-react';
import WhatsAppIcon from '@/components/site/WhatsAppIcon.astro';

const { source = 'quote_dialog' } = Astro.props;
const waPage = Astro.url.pathname.replace(/(.)\/$/, '$1');
const wa = whatsappWith("Hi, I'd like a quote from Lussaro Collection.", { page: waPage });

// Same field treatment as LeadForm. placeholder-white/50 is the contrast floor
// on this near-black.
const field = 'w-full bg-white/[0.04] border border-white/15 rounded-xl px-4 py-3 text-white text-base placeholder-white/50 focus:outline-none focus:border-[#ff1516] transition';
const label = 'block text-white/60 text-xs mb-1.5';
---
<dialog
  id="quote-dialog"
  aria-labelledby="quote-title"
  class="quote-dialog w-[calc(100%-32px)] max-w-md rounded-2xl bg-[#0f0f0f] text-white p-0 ring-1 ring-white/15 shadow-[0_24px_80px_rgba(0,0,0,0.6)]"
>
  <div class="relative p-6 sm:p-7">
    <button
      type="button"
      data-quote-close
      aria-label="Close"
      title="Close"
      class="absolute top-4 right-4 w-9 h-9 inline-flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
    >
      <X className="w-4 h-4" />
    </button>

    <div data-quote-form-wrap>
      <p class="text-[#ff1516] text-xs uppercase tracking-[0.2em] mb-2">Miami · Free Quote</p>
      <h2 id="quote-title" class="font-display text-2xl font-semibold leading-tight pr-10">Get Your Quote</h2>
      <p class="text-white/60 text-sm mt-2 mb-5">Pick a car and leave your number. We text you the daily rate and availability. Nothing to pay today.</p>

      {/* data-astro-reload: without it <ClientRouter /> treats this as a
          navigation form and swaps the page to "/?name=…" before the submit
          handler below runs. */}
      <form id="quote-form" data-source={source} data-astro-reload class="grid gap-3.5" novalidate>
        <div>
          <label for="q-name" class={label}>Name</label>
          <input id="q-name" name="name" required autocomplete="name" placeholder="Your name" aria-label="Your name" class={field} />
        </div>
        <div>
          <label for="q-phone" class={label}>Phone</label>
          <input id="q-phone" name="phone" required type="tel" inputmode="tel" autocomplete="tel" placeholder="(305) 555-0123" aria-label="Your phone number" aria-describedby="q-phone-err" class={field} />
          <p id="q-phone-err" data-field-error class="hidden mt-1.5 text-[#ff6b6b] text-xs"></p>
        </div>
        <div>
          <label for="q-email" class={label}>Email</label>
          <input id="q-email" name="email" required type="email" inputmode="email" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="you@email.com" aria-label="Your email address" aria-describedby="q-email-err" class={field} />
          <p id="q-email-err" data-field-error class="hidden mt-1.5 text-[#ff6b6b] text-xs"></p>
        </div>
        <div>
          <label for="q-car" class={label}>Car</label>
          <select id="q-car" name="vehicle" aria-label="Choose a car" class={field}>
            <option value="" class="bg-[#111]">Any car / not sure</option>
            {fleet.map((c) => (
              <option value={c.name} data-dashboard-id={c.dashboardId || ''} class="bg-[#111]">{carLabel(c)}</option>
            ))}
          </select>
        </div>

        <p data-quote-error role="alert" class="hidden text-[#ff6b6b] text-sm"></p>

        {/* White fill, ink-red label: #e00e10 is the red that clears 4.5:1 on white. */}
        <button
          type="submit"
          class="mt-1 w-full min-h-[48px] bg-white text-[#e00e10] rounded-full font-semibold hover:bg-white/90 transition-colors disabled:opacity-60"
        >
          Get My Quote
        </button>
      </form>

      <p class="text-white/50 text-xs text-center mt-5 mb-3">or reach us now</p>
      <div class="grid grid-cols-2 gap-3">
        <a href={telHref} data-cta="quote_dialog" class="min-h-[44px] inline-flex items-center justify-center gap-2 rounded-full ring-1 ring-white/20 text-white text-sm font-semibold hover:bg-white/10 transition-colors">
          <Phone className="w-4 h-4" /> Call
        </a>
        <a href={wa} data-cta="quote_dialog" target="_blank" rel="noopener noreferrer" class="min-h-[44px] inline-flex items-center justify-center gap-2 rounded-full ring-1 ring-white/20 text-white text-sm font-semibold hover:bg-white/10 transition-colors">
          <WhatsAppIcon class="w-4 h-4" /> WhatsApp
        </a>
      </div>
    </div>

    <div data-quote-done class="hidden text-center py-8" tabindex="-1">
      <p class="text-[#ff1516] text-4xl mb-4" aria-hidden="true">✓</p>
      <h2 class="font-display text-2xl font-semibold mb-2">Request received</h2>
      <p class="text-white/60 text-sm">We will text you your rate shortly. Need it sooner? Call {business.phoneDisplay}.</p>
    </div>
  </div>
</dialog>

<style>
  .quote-dialog { margin: auto; max-height: calc(100dvh - 32px); overflow-y: auto; }
  .quote-dialog::backdrop { background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(4px); }
  /* Quick open: fade + slight rise and scale, transform/opacity only so it
     stays on the compositor. Off entirely under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .quote-dialog[open] { animation: quote-in 180ms cubic-bezier(0.2, 0.9, 0.3, 1); }
    .quote-dialog[open]::backdrop { animation: quote-fade 180ms ease-out; }
  }
  @keyframes quote-in {
    from { opacity: 0; transform: translateY(12px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes quote-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }</style>

<script>
  import { withAttribution } from '@/lib/attribution';
  import { trackLead } from '@/lib/track';
  import { checkPhone, checkEmail } from '@/lib/contactCheck';

  // Delegated from document, so it keeps working across view-transition swaps
  // without rebinding on astro:page-load.
  const dialog = () => document.getElementById('quote-dialog');

  function open() {
    const d = dialog();
    if (!d) return;
    // A second open after a sent request starts from a fresh form.
    d.querySelector('[data-quote-form-wrap]').classList.remove('hidden');
    d.querySelector('[data-quote-done]').classList.add('hidden');
    d.querySelector('[data-quote-error]').classList.add('hidden');
    fieldError('q-phone', '');
    fieldError('q-email', '');
    d.showModal();
  }

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!(t instanceof Element)) return;
    if (t.closest('[data-quote-open]')) { e.preventDefault(); open(); return; }
    const d = dialog();
    if (!d) return;
    // Close button, or a click on the backdrop (the dialog element itself).
    if (t.closest('[data-quote-close]') || t === d) d.close();
  });

  function fieldError(id, msg) {
    const input = document.getElementById(id);
    const p = document.getElementById(id + '-err');
    if (!input || !p) return;
    p.textContent = msg || '';
    p.classList.toggle('hidden', !msg);
    input.classList.toggle('!border-[#ff6b6b]', !!msg);
    if (msg) input.setAttribute('aria-invalid', 'true');
    else input.removeAttribute('aria-invalid');
  }

  // Clear a field's error as soon as it is edited.
  document.addEventListener('input', (e) => {
    const t = e.target;
    if (t instanceof HTMLInputElement && (t.id === 'q-phone' || t.id === 'q-email')) fieldError(t.id, '');
  });

  document.addEventListener('submit', async (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement) || form.id !== 'quote-form') return;
    e.preventDefault();
    const d = dialog();
    const err = d.querySelector('[data-quote-error]');
    const btn = form.querySelector('button[type="submit"]');
    const showError = (msg) => { err.textContent = msg; err.classList.remove('hidden'); };
    err.classList.add('hidden');

    const fd = new FormData(form);
    const name = String(fd.get('name') || '').trim();
    const phone = checkPhone(String(fd.get('phone') || ''));
    const email = checkEmail(String(fd.get('email') || ''));
    fieldError('q-phone', phone.error);
    fieldError('q-email', email.error);
    if (!name) {
      showError('Please add your name.');
      form.querySelector('#q-name').focus();
      return;
    }
    if (phone.error || email.error) {
      form.querySelector(phone.error ? '#q-phone' : '#q-email').focus();
      return;
    }
    const opt = form.querySelector('#q-car').selectedOptions[0];
    const payload = withAttribution({
      name,
      phone: phone.value,
      email: email.value,
      vehicle: fd.get('vehicle'),
      vehicle_id: opt?.dataset.dashboardId || '',
      source: form.dataset.source || 'quote_dialog',
    }, 'QuoteDialog');

    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const res = await fetch('/api/lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.error || 'Something went wrong. Please call or WhatsApp us.');
      trackLead({
        vehicle: payload.vehicle || 'unspecified',
        lead_source: payload.source,
        lead_id: data.lead_id,
        email: payload.email,
        phone: payload.phone,
      });
      form.reset();
      d.querySelector('[data-quote-form-wrap]').classList.add('hidden');
      const done = d.querySelector('[data-quote-done]');
      done.classList.remove('hidden');
      done.focus();
    } catch (ex) {
      showError(ex.message);
    } finally {
      btn.disabled = false;
      btn.textContent = 'Get My Quote';
    }
  }, true);
</script>

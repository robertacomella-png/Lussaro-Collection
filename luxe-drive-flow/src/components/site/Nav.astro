---
import { Menu, X, Phone, MessageCircle } from 'lucide-react';
const wa = 'https://wa.me/16452487305';
---
<nav id="site-nav" class="fixed top-0 inset-x-0 z-50 backdrop-blur-xl bg-black/40 border-b border-white/[0.06] transition-transform duration-300">
  <div class="max-w-7xl mx-auto px-5 md:px-8 h-14 md:h-16 flex items-center justify-between">
    <a href="/" class="font-display text-base md:text-lg font-semibold tracking-tight text-white">
      LUSSARO<span class="text-[#c9a96e]">COLLECTION</span>
    </a>

    <!-- desktop links -->
    <div class="hidden md:flex items-center gap-7 text-sm text-white/60">
      <a href="/#fleet" class="hover:text-white transition">Fleet</a>
      <a href="/gallery" class="hover:text-white transition">Gallery</a>
      <a href="/#process" class="hover:text-white transition">How it works</a>
    </div>

    <!-- desktop CTAs -->
    <div class="hidden md:flex items-center gap-2.5">
      <a href="tel:+16452487305" data-cta="nav" class="inline-flex items-center border border-white/15 text-white text-sm px-4 py-2 rounded-full hover:border-[#c9a96e] hover:text-[#c9a96e] transition">Call</a>
      <a href={wa} data-cta="nav" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-white text-black text-sm px-5 py-2 rounded-full font-medium hover:bg-[#c9a96e] transition">
        Book <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
      </a>
    </div>

    <!-- mobile menu button -->
    <button id="menu-open" type="button" aria-label="Open menu" class="md:hidden -mr-2 w-10 h-10 flex items-center justify-center text-white">
      <Menu className="w-6 h-6" />
    </button>
  </div>
</nav>

<!-- mobile menu overlay -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 z-[100]">
  <div id="menu-backdrop" class="absolute inset-0 bg-black/95 backdrop-blur-2xl"></div>
  <div class="relative h-full flex flex-col px-6 pt-5 pb-10" style="padding-bottom: calc(2.5rem + env(safe-area-inset-bottom));">
    <div class="flex items-center justify-between">
      <a href="/" class="font-display text-lg font-semibold tracking-tight text-white">LUSSARO<span class="text-[#c9a96e]">COLLECTION</span></a>
      <button id="menu-close" type="button" aria-label="Close menu" class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 border border-white/10 text-white">
        <X className="w-5 h-5" />
      </button>
    </div>

    <nav class="mt-14 flex flex-col gap-7">
      <a href="/#fleet" class="font-display text-3xl font-semibold text-white">Fleet</a>
      <a href="/gallery" class="font-display text-3xl font-semibold text-white">Gallery</a>
      <a href="/#process" class="font-display text-3xl font-semibold text-white">How it works</a>
      <a href="/#contact" class="font-display text-3xl font-semibold text-white">Reserve</a>
    </nav>

    <div class="mt-auto grid grid-cols-2 gap-3">
      <a href="tel:+16452487305" data-cta="menu" class="inline-flex items-center justify-center gap-2 border border-white/15 text-white py-3.5 rounded-full font-medium">
        <Phone className="w-4 h-4" /> Call
      </a>
      <a href={wa} data-cta="menu" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 bg-[#c9a96e] text-black py-3.5 rounded-full font-semibold">
        <MessageCircle className="w-4 h-4 text-[#1f7a3f]" /> WhatsApp
      </a>
    </div>
  </div>
</div>

<script>
  // Mobile menu + nav scroll-hide. Delegated/re-queried so it survives view-transition navigations.
  document.addEventListener('click', (e) => {
    const menu = document.getElementById('mobile-menu');
    if (!menu) return;
    if (e.target.closest('#menu-open')) {
      menu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    } else if (e.target.closest('#menu-close') || e.target.closest('#menu-backdrop') || e.target.closest('#mobile-menu a')) {
      menu.classList.add('hidden');
      document.body.style.overflow = '';
    }
  });

  (function () {
    let last = window.scrollY;
    window.addEventListener('scroll', () => {
      const nav = document.getElementById('site-nav');
      if (!nav) return;
      const y = window.scrollY;
      nav.style.transform = y > last && y > 80 ? 'translateY(-100%)' : 'translateY(0)';
      last = y;
    }, { passive: true });
  })();
</script>

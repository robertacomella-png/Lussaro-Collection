---
// Floating "Call" button — sticky bottom-right on desktop (md+). Lets a
// customer tap to call directly from any page. Vivid green with a pulsing glow
// so it stands out against the dark site. Mobile already has a sticky Call in
// StickyMobileCta, so this stays hidden below md to avoid overlapping that
// full-width bar. The tel: click is auto-tracked as `call_click` in
// Layout.astro via the data-cta attribute.
import { Phone } from 'lucide-react';
---
<a
  href="tel:+16452487305"
  data-cta="sticky_call_desktop"
  aria-label="Call Lussaro Collection at (645) 248-7305"
  class="call-pop hidden md:inline-flex fixed bottom-6 right-6 z-50 items-center gap-2.5 bg-[#16a34a] text-white pl-5 pr-6 py-3.5 rounded-full font-semibold shadow-[0_10px_40px_rgba(22,163,74,0.55)] ring-1 ring-white/15 hover:bg-[#22c55e] hover:scale-[1.05] transition-[opacity,transform] duration-300 ease-out"
>
  <Phone className="w-[18px] h-[18px]" />
  <span>Call (645) 248-7305</span>
</a>

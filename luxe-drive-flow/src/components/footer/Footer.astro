---
import { cars } from '@/data/cars';
import SmartLink from '@/components/site/SmartLink.astro';
import { business, telHref, mailHref, addressLine, hoursSummary } from '@/data/business';
import { whatsappWith } from '@/data/business';
// A car whose landing page should take the footer link instead of its own
// /cars/ page. The footer renders on every route, so this is 33 inbound links
// — the single biggest internal-link lever on the site, and the reason the
// blog hub was added here rather than left orphaned.
//
// Keyed by slug so a renamed car loses the override rather than silently
// pointing the wrong vehicle at the wrong page.
// Label as well as href: anchor text is the signal these 33 links actually
// carry. Pointing them at a page that targets "maybach rental miami" while
// the anchor reads "GLS 600 Maybach" describes the wrong thing, and the page
// covers both Maybachs rather than just the SUV.
const FOOTER_OVERRIDES = {
  'mercedes-maybach-gls-600': { href: '/maybach-rental-miami', label: 'Maybach Rental Miami' },
  'lamborghini-urus': { href: '/lamborghini-urus-rental-miami', label: 'Lamborghini Urus Rental Miami' },
  'mercedes-s580': { href: '/mercedes-s580-rental-miami', label: 'Mercedes-Benz S580 Rental Miami' },
};
const footerHref = (car) => FOOTER_OVERRIDES[car.slug]?.href ?? `/cars/${car.slug}`;
const footerLabel = (car) => FOOTER_OVERRIDES[car.slug]?.label ?? car.name;
// Derived so every WhatsApp link says which page it was tapped from without
// a path being threaded through each route by hand.
const waPage = Astro.url.pathname.replace(/(.)\/$/, '$1');
const year = new Date().getFullYear();
---
<footer class="bg-black text-white pt-16 pb-10 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 grid gap-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-5">
    <div class="space-y-4">
      {/* Same wordmark treatment as the nav — first word red, rest white —
          derived from business.brandName rather than hard-coded. */}
      <h3 class="text-white text-xl font-semibold tracking-tight">
        <span class="text-[#ff1516]">{business.brandName.split(' ')[0]}</span>{business.brandName.slice(business.brandName.indexOf(' '))}
      </h3>
      <p class="text-white/60 text-sm leading-relaxed max-w-xs">
        Miami luxury and exotic car rentals with premium delivery, insider service, and first-class attention. <SmartLink href="/about" class="text-white/80 underline decoration-white/25 underline-offset-4 hover:text-white hover:decoration-white transition-colors">Our story →</SmartLink>
      </p>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Explore</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        {/* First in the column, deliberately. The footer renders on every page,
            so this link is what gives the blog crawl equity sitewide — without
            it a post is reachable only from the sitemap, which is how the first
            one sat orphaned for two months. */}
        <li><SmartLink href="/blog" class="hover:text-white transition-colors">Blog</SmartLink></li>
        <li><SmartLink href="/fleet" class="hover:text-white transition-colors">The fleet</SmartLink></li>
        <li><SmartLink href="/pricing" class="hover:text-white transition-colors">Pricing &amp; policies</SmartLink></li>
        <li><SmartLink href="/chauffeur-service-miami" class="hover:text-white transition-colors">Chauffeur service</SmartLink></li>
        <li><SmartLink href="/gallery" class="hover:text-white transition-colors">Photo gallery</SmartLink></li>
        <li><SmartLink href="/reviews" class="hover:text-white transition-colors">Reviews</SmartLink></li>
        <li><SmartLink href="/about" class="hover:text-white transition-colors">Our story</SmartLink></li>
        <li><SmartLink href="/contact" class="hover:text-white transition-colors">Get in touch</SmartLink></li>
        <li><SmartLink href="/exotic-car-rental-miami" class="hover:text-white transition-colors">Exotic car rental in Miami</SmartLink></li>
        <li><SmartLink href="/best-exotic-car-rental-miami" class="hover:text-white transition-colors">Choosing the best rental</SmartLink></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Our Fleet</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        {cars.map((car) => (
          <li><SmartLink href={footerHref(car)} class="hover:text-white transition-colors">{footerLabel(car)}</SmartLink></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Contact</h4>
      {/* NAP — name, address, phone. Must stay identical to the Google Business
          Profile and to the JSON-LD, which reads the same source. */}
      <address class="not-italic space-y-2 text-white/60 text-sm">
        <p class="text-white/80">{business.legalName}</p>
        <p>{business.street}<br />{business.city}, {business.region} {business.postalCode}</p>
        <p><a href={telHref} data-cta="footer" class="hover:text-white transition-colors">{business.phoneDisplay}</a></p>
        {mailHref && (
          <p><a href={mailHref} data-cta="footer" class="hover:text-white transition-colors">{business.email}</a></p>
        )}
        <p class="text-white/50">{hoursSummary}</p>
      </address>
      <ul class="space-y-3 text-white/60 text-sm mt-4">
        <li><a href={whatsappWith("Hi, I'd like to book a car with Lussaro Collection.", { page: waPage })} data-cta="footer" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Booking</a></li>
        <li><a href={business.googleMaps} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Google Business</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Social</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        <li><a href={business.instagram} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a></li>
        {/* Profile link, not the write-a-review form — a link labelled
            "Google Reviews" should go somewhere you read them. */}
        <li><a href={business.googleProfileLink} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Google Reviews</a></li>
      </ul>
    </div>
  </div>

  {/* text-white/50 is the floor for body text on this black: /40 measures
      3.66:1 and /45 measures 4.43:1, both under the 4.5:1 WCAG AA minimum.
      The Terms and Privacy links inherit this colour, so they failed with it. */}
  <div class="max-w-7xl mx-auto px-6 mt-12 pt-6 border-t border-white/10 flex flex-col gap-4 text-white/50 text-xs md:flex-row md:justify-between md:items-center">
    <p>© {year} {business.legalName}. All rights reserved.</p>
    <div class="flex flex-wrap gap-6">
      <SmartLink href="/terms" class="hover:text-white transition-colors">Terms of Service</SmartLink>
      <SmartLink href="/privacy" class="hover:text-white transition-colors">Privacy Policy</SmartLink>
    </div>
  </div>
</footer>

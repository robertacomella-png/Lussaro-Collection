---
import { cars } from '@/data/cars';
const year = new Date().getFullYear();
---
<footer class="bg-black text-white pt-16 pb-10 border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 grid gap-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-5">
    <div class="space-y-4">
      <h3 class="text-[#c9a96e] text-xl font-semibold tracking-tight">Lussaro Collection</h3>
      <p class="text-white/60 text-sm leading-relaxed max-w-xs">
        Miami luxury and exotic car rentals with premium delivery, insider service, and first-class attention.
      </p>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Explore</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        <li><a href="/#fleet" class="hover:text-white transition-colors">Fleet</a></li>
        <li><a href="/gallery" class="hover:text-white transition-colors">Gallery</a></li>
        <li><a href="/exotic-car-rental-miami" class="hover:text-white transition-colors">Exotic Car Rental Miami</a></li>
        <li><a href="/lamborghini-rental-miami" class="hover:text-white transition-colors">Lamborghini Rental Miami</a></li>
        <li><a href="/g-wagon-rental-miami" class="hover:text-white transition-colors">G-Wagon Rental Miami</a></li>
        <li><a href="/luxury-suv-rental-miami" class="hover:text-white transition-colors">Luxury SUV Rental Miami</a></li>
        <li><a href="/rolls-royce-rental-miami" class="hover:text-white transition-colors">Rolls-Royce Rental Miami</a></li>
        <li><a href="/exotic-car-rental-brickell" class="hover:text-white transition-colors">Exotic Car Rental Brickell</a></li>
        <li><a href="/exotic-car-rental-south-beach" class="hover:text-white transition-colors">Exotic Car Rental South Beach</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Our Fleet</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        {cars.map((car) => (
          <li><a href={`/cars/${car.slug}`} class="hover:text-white transition-colors">{car.name}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Contact</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        <li>Miami, Florida</li>
        <li><a href="https://wa.me/16452487305" data-cta="footer" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">WhatsApp Booking</a></li>
        <li><a href="https://maps.app.goo.gl/9nEuwbuyZzhGTQscA" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Google Business</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white text-sm uppercase tracking-[0.25em] mb-4">Social</h4>
      <ul class="space-y-3 text-white/60 text-sm">
        <li><a href="https://instagram.com/lussarocollection" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Instagram</a></li>
        <li><a href="https://maps.app.goo.gl/9nEuwbuyZzhGTQscA" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Google Reviews</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 mt-12 pt-6 border-t border-white/10 flex flex-col gap-4 text-white/40 text-xs md:flex-row md:justify-between md:items-center">
    <p>© {year} Lussaro Collection. All rights reserved.</p>
    <div class="flex flex-wrap gap-6">
      <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
      <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
    </div>
  </div>
</footer>

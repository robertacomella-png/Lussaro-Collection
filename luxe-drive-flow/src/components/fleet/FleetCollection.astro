---
// "The Collection" — the signature fleet grid (real photos → booking pages;
// 3D badge on showpiece cars). Shared by the homepage #fleet section and the
// /fleet landing page so the two always stay identical. Pages that render a
// card with a 3D badge should also mount <Car3DViewer client:idle />.
import { cars } from '@/data/cars';
import { getImageKitSrc, getImageKitSrcSet } from '@/lib/imageKit';

const {
  id = 'fleet',
  eyebrow = 'Curated Luxury Fleet',
  heading = 'The Collection',
  pad = 'py-16 md:py-24', // vertical padding — override where the section follows a tight hero
  filter = true,          // set false to render the grid with no brand filter
} = Astro.props;

// Brands in FLEET ORDER, deduped — so the pills follow the same sequence as the
// grid rather than an arbitrary alphabetical one. Derived from the data, so a
// new marque in fleet.js gets a pill automatically and one that leaves loses it.
const brands = [...new Set(cars.map((c) => c.make))];
const showFilter = filter && brands.length > 1;
---
{/* Dark, on the page ground rather than pure black, with hairline rules top and
    bottom: on the homepage this sits between two bg-black sections and would
    otherwise merge into one unbroken slab. #e00e10 cannot come along as text —
    it is the red tuned for white backgrounds and measures 3.87:1 on a #0f0f0f
    card, under the AA floor. The eyebrow uses #ff1516 at 5.06:1 on the ground;
    the price is plain white, leaving red to the OFF badge alone. */}
<section id={id} class={`bg-[#0a0a0a] text-white border-y border-white/5 ${pad}`}>
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="reveal text-center mb-12 md:mb-14">
      <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs font-medium mb-3">{eyebrow}</p>
      <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">{heading}</h2>
    </div>

    {/* Progressive enhancement on purpose: every card is in the server HTML and
        the filter only hides them client-side, so crawlers and no-JS visitors
        still see the whole fleet. The pills are real buttons with aria-pressed
        rather than links, since this filters in place and does not change the
        URL. */}
    {showFilter && (
      <div
        data-brand-filter
        role="group"
        aria-label="Filter the collection by brand"
        class="reveal mb-8 md:mb-11 flex md:flex-wrap items-center md:justify-center gap-2
               -mx-5 px-5 md:mx-0 md:px-0
               overflow-x-auto md:overflow-visible no-scrollbar snap-x"
      >
        <button type="button" data-brand="all" aria-pressed="true">All</button>
        {brands.map((b) => (
          <button type="button" data-brand={b} aria-pressed="false">{b}</button>
        ))}
      </div>
    )}

    {/* A drop shadow does nothing against a dark ground, so each card is lifted
        by a red hairline instead — the same treatment FleetCard uses on the
        landing pages. */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cars.map((car) => (
        <div data-car-make={car.make} class="reveal group relative rounded-[24px] bg-[#0f0f0f] border border-[#ff1516]/25 overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.4)] hover:border-[#ff1516]/50 transition-colors">
          <a href={`/cars/${car.slug}`} class="absolute inset-0 z-10" aria-label={`View the ${car.name}`}></a>
          <div class="relative aspect-[16/11] overflow-hidden">
            <img
              src={getImageKitSrc(car.images?.[0], 800)}
              srcset={getImageKitSrcSet(car.images?.[0])}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              alt={car.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute top-4 left-4 bg-[#0a0a0a]/80 text-white text-[11px] tracking-wide px-3 py-1 rounded-full">{car.make}</span>
            {/* Bottom-left: the only free corner. Top-left is the make, and
                top-right is taken by Coming Soon or the 3D button.

                WhatsApp's green, but its #0f7536 hover shade rather than the
                #128f42 fill — white on the fill measures 4.17:1, under the
                4.5:1 AA floor for text this size. The hover shade is 5.80:1. */}
            {car.offerLabel && (
              <span class="absolute bottom-4 left-4 bg-[#0f7536] text-white text-[11px] font-bold tracking-[0.12em] uppercase px-3 py-1 rounded-full">{car.offerLabel}</span>
            )}
            {car.comingSoon && (
              <span class="absolute top-4 right-4 bg-[#ff1516] text-black text-[11px] font-bold tracking-[0.12em] uppercase px-3 py-1 rounded-full">Coming Soon</span>
            )}
            {car.model && (
              <button data-open-3d type="button" class="absolute top-4 right-4 z-20 inline-flex items-center gap-1.5 bg-white text-black text-[11px] font-semibold px-3 py-1.5 rounded-full hover:bg-[#ff1516] transition">
                ◆ Explore in 3D
              </button>
            )}
          </div>
          <div class="p-5 flex items-center justify-between">
            <div>
              <h3 class="font-display text-lg font-semibold">{car.name}</h3>
              <p class="text-white/50 text-xs">{car.zeroToSixty} · {car.power} HP</p>
            </div>
            <div class="text-right leading-tight">
              {car.wasPrice > car.price && (
                <div class="flex items-center justify-end gap-1.5 mb-0.5">
                  <span class="text-white/50 text-sm line-through">${car.wasPrice.toLocaleString()}</span>
                  <span class="bg-[#e00e10] text-white text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded">${car.wasPrice - car.price} OFF</span>
                </div>
              )}
              <p class="text-white font-display text-xl font-bold leading-none">${car.price.toLocaleString()}<span class="text-white/50 text-xs font-normal">/day</span></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Pills follow the section's dark palette: white-on-near-black, red only on
     the active one, matching the WHITE = browse / RED = act split the rest of
     the site uses. Idle label is white at 62% (7.76:1 on #0a0a0a) and the
     active pill is near-black on #ff1516 (5.06:1), the same pairing as the
     Coming Soon badge. */
  /* On a phone the row is a single edge-to-edge scroller rather than a wrapping
     block: five pills across ~350px wrapped into a ragged 3-then-2 that read as
     broken rather than centred. It bleeds past the section padding (-mx-5 px-5)
     so the last pill is visibly cut off at the edge — that overflow is the only
     honest affordance that there is more to scroll, since the scrollbar itself
     is hidden. From md up it goes back to a centred wrap, where there is room.
     shrink-0 is what stops flex squashing the pills to fit instead of
     overflowing, which would defeat the whole arrangement. */
  [data-brand-filter] button {
    flex: none;
    scroll-snap-align: start;
    border-radius: 9999px;
    min-height: 2.75rem; /* 44px — the tap-target floor on mobile */
    padding: 0.45rem 1.05rem;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  @media (min-width: 768px) {
    /* Desktop has a pointer and no reach problem, so the pills can be tighter. */
    [data-brand-filter] button { min-height: 2.375rem; }
  }
  [data-brand-filter] button:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.45);
  }
  [data-brand-filter] button[aria-pressed='true'] {
    background: #ff1516;
    border-color: #ff1516;
    color: #0a0a0a;
  }
</style>

<script is:inline>
  (function () {
    function initBrandFilter() {
      document.querySelectorAll('[data-brand-filter]').forEach(function (bar) {
        if (bar.dataset.bound === '1') return;
        bar.dataset.bound = '1';
        var section = bar.closest('section');
        if (!section) return;
        var cards = section.querySelectorAll('[data-car-make]');
        bar.addEventListener('click', function (e) {
          var btn = e.target.closest('button[data-brand]');
          if (!btn) return;
          var want = btn.getAttribute('data-brand');
          bar.querySelectorAll('button[data-brand]').forEach(function (b) {
            b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
          });
          cards.forEach(function (card) {
            var show = want === 'all' || card.getAttribute('data-car-make') === want;
            card.hidden = !show;
            // A card that was hidden while the reveal observer ran never got
            // .in, and .reveal sits at opacity 0 — so it would come back
            // invisible. Mark it seen as it is revealed.
            if (show) card.classList.add('in');
          });
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBrandFilter);
    } else {
      initBrandFilter();
    }
    // The router swaps the DOM on navigation, so re-bind against the new nodes.
    document.addEventListener('astro:page-load', initBrandFilter);
  })();
</script>

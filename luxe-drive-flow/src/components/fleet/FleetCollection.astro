---
// "The Collection" — the signature fleet grid (real photos → booking pages;
// 3D badge on showpiece cars). Shared by the homepage #fleet section and the
// /fleet landing page so the two always stay identical. Pages that render a
// card with a 3D badge should also mount <Car3DViewer client:idle />.
import { cars } from '@/data/cars';
import { getImageKitSrc, getImageKitSrcSet } from '@/lib/imageKit';

const {
  id = 'fleet',
  eyebrow = 'Curated Luxury Fleet',
  heading = 'The Collection',
  pad = 'py-16 md:py-24', // vertical padding — override where the section follows a tight hero
} = Astro.props;
---
<section id={id} class={`bg-[#f7f5f0] text-[#0a0a0a] ${pad}`}>
  <div class="max-w-7xl mx-auto px-5 md:px-8">
    <div class="reveal text-center mb-12 md:mb-14">
      <p class="text-[#c9a96e] tracking-[0.3em] uppercase text-xs font-medium mb-3">{eyebrow}</p>
      <h2 class="font-display text-4xl md:text-6xl font-bold tracking-tight">{heading}</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cars.map((car) => (
        <div class="reveal group relative rounded-[24px] bg-white overflow-hidden shadow-[0_10px_40px_rgba(0,0,0,0.08)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.15)] transition-shadow">
          <a href={`/cars/${car.slug}`} class="absolute inset-0 z-10" aria-label={`View the ${car.name}`}></a>
          <div class="relative aspect-[16/11] overflow-hidden">
            <img
              src={getImageKitSrc(car.images?.[0], 800)}
              srcset={getImageKitSrcSet(car.images?.[0])}
              sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
              alt={car.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <span class="absolute top-4 left-4 bg-[#0a0a0a]/80 text-white text-[11px] tracking-wide px-3 py-1 rounded-full">{car.make}</span>
            {car.comingSoon && (
              <span class="absolute top-4 right-4 bg-[#c9a96e] text-black text-[11px] font-bold tracking-[0.12em] uppercase px-3 py-1 rounded-full">Coming Soon</span>
            )}
            {car.model && (
              <button data-open-3d type="button" class="absolute top-4 right-4 z-20 inline-flex items-center gap-1.5 bg-[#c9a96e] text-black text-[11px] font-semibold px-3 py-1.5 rounded-full hover:bg-white transition">
                ◆ Explore in 3D
              </button>
            )}
          </div>
          <div class="p-5 flex items-center justify-between">
            <div>
              <h3 class="font-display text-lg font-semibold">{car.name}</h3>
              <p class="text-[#0a0a0a]/50 text-xs">{car.zeroToSixty} · {car.power} HP</p>
            </div>
            <div class="text-right leading-tight">
              <div class="flex items-center justify-end gap-1.5 mb-0.5">
                <span class="text-[#0a0a0a]/45 text-sm line-through">${(car.wasPrice ?? car.price + 200).toLocaleString()}</span>
                <span class="bg-red-600 text-white text-[10px] font-bold tracking-wide px-1.5 py-0.5 rounded">${(car.wasPrice ?? car.price + 200) - car.price} OFF</span>
              </div>
              <p class="text-[#c9a96e] font-display text-xl font-bold leading-none">${car.price.toLocaleString()}<span class="text-[#0a0a0a]/40 text-xs font-normal">/day</span></p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

---
// The rating pill beside the price — styled to the booking brief's mockup:
// Google mark, five stars in Google's own rating yellow, the review count and
// a "Read reviews" link, inside one outlined pill.
//
// The yellow is Google's, not ours, in the same way the WhatsApp dots are
// WhatsApp's green: it marks the rating as Google's. Brand red stays on the
// site's own stars elsewhere.
//
// No average is printed. Robert, 27 Nov 2026, 8:11 PM ET: the badge does not
// need to say 4.8, the stars just have to be right. Each star's fill is
// clamp(rating - i, 0, 1) from google-rating.js, so 4.8 is four full stars and
// a fifth filled 80%, with the rest of that star grey. The number is only in
// the screen-reader label. The count stays the stored total with a plus ("25+").
// The fill is a per-star CSS gradient (a custom property on each star), so two
// badges on one page cannot collide on a shared clip or gradient id.
import { googleCountLabel, googleRating } from '@/data/google-rating';

const { href = '#reviews' } = Astro.props;

const starFills = [0, 1, 2, 3, 4].map((i) => {
  const fraction = Math.min(1, Math.max(0, googleRating.rating - i));
  return Math.round(fraction * 10000) / 100;
});
---
<div class="relative inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-xl border border-white/15 bg-white/[0.04] px-3 py-2 text-[14px] max-[400px]:text-[13px] max-[400px]:gap-x-1.5 max-[400px]:px-2.5">
  <svg class="w-4 h-4 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
    <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
    <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
    <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
    <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
  </svg>
  <span class="sr-only">Rated {googleRating.rating} out of 5 on Google</span>
  <span class="google-stars leading-none" aria-hidden="true">
    {starFills.map((fill) => (
      <span class="google-star" style={`--fill:${fill}%`}></span>
    ))}
  </span>
  <span class="text-white font-medium whitespace-nowrap">{googleCountLabel()} reviews</span>
  <a href={href} class="text-white underline decoration-white/40 underline-offset-4 hover:decoration-white transition-colors whitespace-nowrap border-l border-white/20 pl-2 max-[400px]:pl-1.5">Read reviews</a>
</div>

<style>
  /* A tight star mask, not the ★ glyph. The glyph's side bearings made an
     80% gradient land on the last sliver of the point, so 4.8 still read as
     five stars. The mask's box is the star, so --fill is the visible fraction.
     Width, height and the gap are the measured ink of ★ at this font size
     (advance plus the old 0.06em tracking), so the row keeps the same size
     and spacing, and both scale with the 14px / 13px pill text. No shared
     gradient id: the stop is a custom property on each star. */
  .google-stars {
    display: inline-flex;
    align-items: center;
    line-height: 1;
  }
  .google-star {
    display: block;
    flex: none;
    width: 0.857em;
    height: 0.821em;
    margin-right: 0.248em;
    background-image: linear-gradient(90deg, #FBBC04 var(--fill), #9aa0a6 var(--fill));
    -webkit-mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 95.106 90.451'><path fill='white' d='M47.553 0L58.779 34.549L95.106 34.549L65.716 55.902L76.942 90.451L47.553 69.098L18.164 90.451L29.389 55.902L0 34.549L36.327 34.549Z'/></svg>");
    mask-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 95.106 90.451'><path fill='white' d='M47.553 0L58.779 34.549L95.106 34.549L65.716 55.902L76.942 90.451L47.553 69.098L18.164 90.451L29.389 55.902L0 34.549L36.327 34.549Z'/></svg>");
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-position: center;
    mask-position: center;
  }
</style>

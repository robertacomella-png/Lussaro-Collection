---
// The Google rating as stars: full stars for the whole number, and the next
// star filled to the decimal (4.8 → four stars and an 80% fifth). Decorative.
// The number beside it is what a screen reader gets.
import { googleRating } from '@/data/google-rating';

const { class: className = '' } = Astro.props;
const [whole, frac = '0'] = googleRating.rating.toFixed(1).split('.');
const full = Number(whole);
const partial = Number(frac) * 10;
---
<span class:list={['inline-block leading-none align-[-0.05em]', className]} aria-hidden="true">
  {'★'.repeat(full)}
  {partial > 0 && (
    <span class="relative inline-block">
      <span class="opacity-25">★</span>
      <span class="absolute inset-0 overflow-hidden" style={`width:${partial}%`}>★</span>
    </span>
  )}
</span>

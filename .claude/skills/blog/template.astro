---
// ============================================================================
// LUSSARO BLOG POST TEMPLATE — DO NOT RESTRUCTURE
//
// Every blog post uses this file verbatim. The structure, class names, schema
// shape and ordering are all load-bearing: they are what produce Accessibility
// 100, SEO 100 and LCP ~1.5s on mobile. Replace the marked values, write the
// body, and change nothing else.
//
// Anything marked >>> FILL is yours to replace.
// Anything not marked stays exactly as it is.
//
// Measured baseline this template produces (production build, mobile, Slow 4G):
//   Performance 90 · Accessibility 100 · Best Practices 58 · SEO 100
//   FCP 1.1s · LCP 1.5s · CLS 0
// Best Practices is capped by GTM / Meta Pixel / Clarity and is not fixable here.
// ============================================================================

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    >>> FILL
//   SECONDARY:  >>> FILL (4–5, comma separated)
//
// The primary must be INFORMATIONAL whenever a service page already targets the
// commercial term. Blog posts funnel into landing pages; they never compete with
// them. See rule 4 in /used-keywords.md.

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import { altFor } from '@/data/image-alt';
import { cars } from '@/data/cars';
import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import {
  rentalTerms,
  deliveryEachWaySummary,
  roundTripSummary,
  discountSummary,
  rateForDays,
} from '@/data/rental-terms';

const bySlug = (s) => cars.find((c) => c.slug === s);

// >>> FILL — pull only the cars this post actually discusses.
// Slugs: lamborghini-urus · huracan-evo · sf90 · rolls-royce-cullinan ·
//        mercedes-maybach-gls-600 · mercedes-s580
const car = bySlug('lamborghini-urus');

const { deposit, mileage, minimumAge, cancellation, insurance } = rentalTerms;
const perDay = mileage.includedPerDay;
const usd = (n) => `$${n.toLocaleString('en-US')}`;

const SITE = 'https://www.lussarocollection.com';
const PATH = '/blog/>>> FILL-slug';           // must match the filename
const PAGE_URL = `${SITE}${PATH}`;

// ---------------------------------------------------------------------------
// IMAGES. Hero variants are generated by the skill from the existing photo
// library — never hotlinked, never sourced from image search. The hero renders
// at 25% opacity behind a gradient, so it takes heavy compression: target
// ~60 KB at 1400w and ~30 KB at 800w. HERO_KEY is the ORIGINAL path, used only
// to look up alt text in image-alt.js.
// ---------------------------------------------------------------------------
const HERO_KEY = '/cars/>>> FILL.jpg';
const heroSrc = '/blog/>>> FILL-hero-1400.webp';
const heroSrcSet =
  '/blog/>>> FILL-hero-800.webp 800w, /blog/>>> FILL-hero-1400.webp 1400w';
const heroAlt = altFor(HERO_KEY);
const OG_IMAGE = `${SITE}/og/>>> FILL.jpg`;   // 1200×630, under 1 MB

const PUBLISHED_ISO = '>>> FILL YYYY-MM-DD';
const UPDATED_ISO = '>>> FILL YYYY-MM-DD';
const published = '>>> FILL Month D, YYYY';
const updated = '>>> FILL Month D, YYYY';

const TITLE = '>>> FILL — 50–60 chars, primary keyword near the start';
const waMessage = '>>> FILL — WhatsApp prefill, one sentence referencing this post';
const wa = whatsappWith(waMessage);

// A named reviewer, quoted verbatim from Google. NEVER edited — see reviews.js.
const testimonial = reviews[0];

// >>> FILL — one entry per H2 in the body. ids must match the H2 ids exactly.
const toc = [
  { id: 'section-one', label: 'Section one' },
];

// >>> FILL — 4–8 questions from People Also Ask. Answers 2–4 sentences.
// Do NOT duplicate questions already answered on /best-exotic-car-rental-miami.
// Every number must render from the data files, never be typed as a literal.
const faqs = [
  { q: '>>> FILL', a: `>>> FILL` },
];

// --- Schema. Do not restructure. ------------------------------------------
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: '>>> FILL — one sentence, mirrors the meta description',
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;
---
<Layout
  title={`${TITLE} | Lussaro`}
  description={'>>> FILL — 150–160 chars, primary keyword first, ends with a soft CTA'}
  image={OG_IMAGE}
  type="article"
  breadcrumbName={'>>> FILL — the breadcrumb leaf label'}
  schema={[articleSchema, authorSchema, faqSchema]}
>
  <!-- Skip link stays on the page, not in Layout: the other routes have no
       #main target yet, and a skip link that lands nowhere is worse than none. -->
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <header class="relative bg-black pt-28 md:pt-36 pb-14 md:pb-20 overflow-hidden">
    <div class="absolute inset-0 opacity-25">
      <!-- fetchpriority=high + no lazy: this is the LCP element. -->
      <img
        src={heroSrc}
        srcset={heroSrcSet}
        sizes="100vw"
        width="1400"
        height="984"
        alt={heroAlt}
        fetchpriority="high"
        decoding="async"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto px-5 md:px-8">
      <nav aria-label="Breadcrumb" class="mb-5">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-white/50">
          <li><a href="/" class="hover:text-white transition">Home</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white/70">>>> FILL — short page label</li>
        </ol>
      </nav>

      <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">>>> FILL — eyebrow</p>
      <h1 class="font-display text-3xl md:text-5xl font-bold tracking-tight text-white leading-[1.1]">
        >>> FILL — one H1, contains the primary keyword
      </h1>
      <p class="text-white/65 max-w-2xl text-base md:text-lg leading-relaxed mt-5">
        >>> FILL — dek, one or two sentences
      </p>

      <p class="mt-6 text-sm text-white/60">
        By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>,
        founder <span aria-hidden="true">·</span>
        <time datetime={PUBLISHED_ISO}>{published}</time>
        <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time>
      </p>

      <div class="mt-7 flex flex-col sm:flex-row gap-3 max-w-md">
        <a href={wa} data-cta="blog_hero" target="_blank" rel="noopener noreferrer"
           class="flex-1 inline-flex items-center justify-center gap-2 min-h-[48px] bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">
          Check your dates <span class="w-2 h-2 rounded-full bg-[#1f7a3f]" aria-hidden="true"></span>
        </a>
        <a href={telHref} data-cta="blog_hero" data-call-inline
           class="flex-1 inline-flex items-center justify-center min-h-[48px] border border-white/25 text-white px-7 py-4 rounded-full font-medium hover:border-[#e00e10] hover:text-[#e00e10] transition">
          Call {business.phoneDisplayShort}
        </a>
      </div>

      <p class="mt-5 flex items-center gap-3 text-sm text-white/60">
        <span class="text-[#ff1516]" aria-hidden="true">★★★★★</span>
        5.0 on Google <span aria-hidden="true">·</span> Delivered across Miami
      </p>
    </div>
  </header>

  <main id="main" tabindex="-1">
    <article class="bg-white text-[#0a0a0a] py-14 md:py-20">
      <!-- NO `reveal` class here. It starts the subtree at opacity:0 and only
           fades in on intersection, which leaves the whole article invisible
           until the reader scrolls and makes the body a hidden LCP element.
           Inline links are underlined: a link distinguished only by color fails
           WCAG 1.4.1. -->
      <div class="prose prose-neutral max-w-3xl mx-auto px-5 md:px-8 prose-headings:font-display prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm">

        <nav aria-label="Table of contents" class="not-prose mb-10 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
          <h2 class="font-display text-base font-bold mb-3">On this page</h2>
          <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
            {toc.map((t, i) => (
              <li>
                <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                  <!-- /60 minimum on light backgrounds. /40 fails WCAG AA. -->
                  <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <!-- OPENING JOKE. One line, aimed at the industry or at Miami — never
             self-deprecating in the opening line (references/humour.md). Keep it
             under ~30 words so the bolded answer below still lands inside the
             first 100 words and stays the featured-snippet candidate. -->
        <p>
          >>> FILL — opening joke, one line
        </p>

        <!-- DIRECT ANSWER. Bolded, ~40–60 words, answers the query outright and
             contains the primary keyword. This is the featured-snippet target. -->
        <p>
          <strong>
            >>> FILL — direct answer with real figures
          </strong>
        </p>

        <!-- BODY. One H2 per toc entry, ids matching. H3s only under H2s.
             Every number renders from the data files — never typed as a literal.
             Voice: references/voice.md. Light dry touches throughout, one or two
             bigger lines (references/humour.md). One story maximum, from
             references/stories.md, never invented. -->

        <h2 id="section-one">>>> FILL — H2 carrying a supporting keyword</h2>

        <p>>>> FILL</p>

        <!-- Somewhere in the body: 2–3 external links to authoritative sources,
             verified to return 200 before use. Reliable ones for this site:
               https://www.flhsmv.gov/insurance/   (state licensing + insurance)
               https://www.lamborghini.com/…       (manufacturer specs)
               https://www.sunpass.com/            (Florida cashless tolls)
             All need target="_blank" rel="noopener noreferrer". -->

        <!-- Real Google review. Verbatim, never edited, never invented. -->
        <figure class="not-prose my-10 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
          <blockquote class="text-[#0a0a0a]/80 leading-relaxed">
            <p>“{testimonial.text}”</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-[#0a0a0a]/60">
            <span class="text-[#e00e10]" aria-hidden="true">★★★★★</span>
            <span class="font-semibold text-[#0a0a0a]"> {testimonial.name}</span> — verified Google review
          </figcaption>
        </figure>

        <!-- 3–5 internal links in descriptive anchor text, contextually placed.
             Never "click here". Good targets: /lamborghini-rental-miami,
             /rolls-royce-rental-miami, /pricing, /fleet, /cars/[slug]. -->

        <h2 id="faq">Common questions</h2>

        {faqs.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}

        <p>
          >>> FILL — closing paragraph. End by handing the decision back rather
          than instructing: "What are you thinking?" is the house close.
        </p>

        <div class="not-prose mt-10 flex flex-col sm:flex-row gap-3 max-w-md">
          <a href={wa} data-cta="blog_body" target="_blank" rel="noopener noreferrer"
             class="flex-1 inline-flex items-center justify-center min-h-[48px] bg-[#0a0a0a] text-white px-7 py-4 rounded-full font-semibold hover:bg-[#e00e10] transition">
            Message us on WhatsApp
          </a>
          <a href={telHref} data-cta="blog_body" data-call-inline
             class="flex-1 inline-flex items-center justify-center min-h-[48px] border border-[#0a0a0a]/20 text-[#0a0a0a] px-7 py-4 rounded-full font-medium hover:border-[#e00e10] hover:text-[#e00e10] transition">
            Call {business.phoneDisplayShort}
          </a>
        </div>

        <!-- Author bio — E-E-A-T. Never claims tenure: the company was formed
             December 2025 and registration is public. -->
        <aside class="not-prose mt-12 rounded-2xl border border-black/10 bg-[#fafafa] p-6 flex flex-col sm:flex-row gap-5">
          <img src="/favicon-96.png" width="64" height="64" alt="" aria-hidden="true"
               loading="lazy" decoding="async"
               class="w-16 h-16 rounded-full shrink-0 object-cover ring-1 ring-black/10" />
          <div>
            <p class="font-display font-bold text-lg">
              <a href="/about" class="hover:text-[#e00e10] transition">Robert Comella</a>
            </p>
            <p class="text-sm text-[#0a0a0a]/70 mt-1">Founder, {business.brandName}</p>
            <p class="text-sm text-[#0a0a0a]/70 mt-3 leading-relaxed">
              Robert founded Lussaro Collection in Miami and runs it hands-on — he answers the phone,
              screens the renters and hands over the keys himself. The fleet started with a single
              Mercedes-Maybach GLS 600 bought with his own savings and now runs to six cars. Every
              price, deposit and fee quoted here is one he sets and honors personally.
              <a href="/about" class="text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]"> More about Lussaro Collection</a>.
            </p>
          </div>
        </aside>

        <!-- NAP block. A link, never an embedded map: a Maps iframe pulls in
             third-party JS and cookies and costs Performance and Best Practices
             on a page whose job is to be read. -->
        <aside class="not-prose mt-8 rounded-2xl border border-black/10 p-6">
          <h2 class="font-display text-lg font-bold">Lussaro Collection</h2>
          <dl class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
            <div>
              <dt class="font-semibold">Address</dt>
              <dd class="text-[#0a0a0a]/70">{addressLine}</dd>
            </div>
            <div>
              <dt class="font-semibold">Hours</dt>
              <dd class="text-[#0a0a0a]/70">{hoursSummary}</dd>
            </div>
            <div>
              <dt class="font-semibold">Phone</dt>
              <dd><a href={telHref} data-cta="blog_nap" class="text-[#e00e10] hover:underline">{business.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt class="font-semibold">Delivery area</dt>
              <dd class="text-[#0a0a0a]/70">Miami, South Beach, Brickell, both airports. Fort Lauderdale at {usd(rentalTerms.delivery[1].fee)} each way.</dd>
            </div>
          </dl>
          <p class="mt-5">
            <a href={mapLink} target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 min-h-[48px] text-sm text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]">
              Open {addressLine} in Google Maps
            </a>
          </p>
        </aside>

        <p class="not-prose mt-10 text-center">
          <a href="#main" class="inline-flex items-center gap-2 min-h-[48px] px-5 py-3 text-sm text-[#0a0a0a]/60 hover:text-[#e00e10] transition">
            <span aria-hidden="true">↑</span> Back to top
          </a>
        </p>
      </div>
    </article>
  </main>

  <CtaBand
    title={'>>> FILL — two lines, second wrapped in <span class="text-[#ff1516]">'}
    subtitle="Delivered across Miami. Replies usually take minutes."
    message={waMessage}
  />
  <StickyMobileCta message={waMessage} />
</Layout>

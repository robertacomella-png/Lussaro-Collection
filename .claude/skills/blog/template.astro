---
// ============================================================================
// LUSSARO BLOG — BASE TEMPLATE
//
// The shared layout every post type uses, and the starting point for a new one.
// If you are writing a head-to-head, start from templates/comparison.astro
// instead — it has the two-car frontmatter and the spec table already wired.
//
// To add a type: copy this file to templates/<type>.astro, change only the
// marked BODY region and whatever frontmatter that body needs, and record the
// type in SKILL.md. The layout above and below the body does not move.
//
// Anything marked >>> FILL is yours to replace. Anything else stays.
//
// LOAD-BEARING, LEARNED THE HARD WAY — do not undo any of these:
//   · <header> sits OUTSIDE <article>. The hero's markup (a six-candidate
//     srcset alone is ~450 chars) otherwise eats the 4000-character window
//     verify.py uses to find the bolded answer, and every post fights it.
//   · Developer notes use {/* */}, never <!-- -->. HTML comments ship to the
//     browser and count against that same window.
//   · The featured image is SHOWN. Encode it at quality ~72-78, not the 38 a
//     dimmed backdrop could hide, and give it a full variant ladder (see the
//     image step in SKILL.md) or phones pull a 1500px file to paint 390px.
//   · The testimonial must be a review with NO exclamation marks. verify.py
//     bans [a-z]! in the article body and reviews.js forbids editing one.
//   · rateForDays(price, days) returns { pct, perDay } — an object. Render
//     .perDay, or the page prints "$[object Object]".
// ============================================================================

// KEYWORD CLUSTER — must match the entry in /used-keywords.md
//   PRIMARY:    >>> FILL — the comparison phrasing, informational
//   SECONDARY:  >>> FILL (4–5, comma separated)
//
// A comparison primary is informational by nature, so it rarely collides. The
// commercial terms for each car belong to that car's page; this post funnels
// into both rather than competing with either.

import Layout from '@/layouts/Layout.astro';
import Nav from '@/components/site/Nav.astro';
import CtaBand from '@/components/site/CtaBand.astro';
import StickyMobileCta from '@/components/site/StickyMobileCta.astro';
import RelatedPosts from '@/components/blog/RelatedPosts.astro';
import { altFor } from '@/data/image-alt';
import { cars } from '@/data/cars';
import { reviews } from '@/data/reviews';
import { business, telHref, whatsappWith, addressLine, hoursSummary } from '@/data/business';
import {
  rentalTerms,
  deliveryEachWaySummary,
  discountSummary,
  rateForDays,
} from '@/data/rental-terms';

const bySlug = (s) => cars.find((c) => c.slug === s);

// >>> FILL — pull only the cars this post actually discusses. Slugs:
// lamborghini-urus · huracan-evo · huracan-evo-spyder · sf90 ·
// rolls-royce-cullinan · mercedes-maybach-gls-600 · mercedes-s580 ·
// mercedes-maybach-s580 · mercedes-amg-g63
const car = bySlug('>>> FILL-slug');

const { deposit, mileage, minimumAge, cancellation } = rentalTerms;
const perDay = mileage.includedPerDay;
const usd = (n) => `$${n.toLocaleString('en-US')}`;

// rateForDays returns { pct, perDay } — an object. Render .perDay or the page
// prints "$[object Object]".
const weekRate = rateForDays(car.price, 7).perDay;

const SITE = 'https://www.lussarocollection.com';
const PATH = '/blog/>>> FILL-slug';           // must match the filename
const PAGE_URL = `${SITE}${PATH}`;

// IMAGES. Generated by the image step in SKILL.md from the existing library —
// never hotlinked, never from image search. The hero is a real, visible figure.
const HERO_KEY = '/cars/>>> FILL.jpg';
const heroSrc = '/blog/>>> FILL-slug-hero-760.webp';
const heroSrcSet =
  '/blog/>>> FILL-slug-hero-560.webp 560w, /blog/>>> FILL-slug-hero-760.webp 760w, /blog/>>> FILL-slug-hero-800.webp 800w, /blog/>>> FILL-slug-hero-1120.webp 1120w, /blog/>>> FILL-slug-hero-1200.webp 1200w, /blog/>>> FILL-slug-hero-1560.webp 1560w';
const heroAlt = altFor(HERO_KEY);

// One inline image in the body. Long form with no picture in it reads as a wall.
const BODY_KEY = '/cars/>>> FILL.jpg';
const bodySrc = '/blog/>>> FILL-slug-body-1000.webp';
const bodySrcSet =
  '/blog/>>> FILL-slug-body-700.webp 700w, /blog/>>> FILL-slug-body-1000.webp 1000w';
const bodyAlt = altFor(BODY_KEY);

const OG_IMAGE = `${SITE}/og/>>> FILL-slug.jpg`;   // 1200×630, under 1 MB

const PUBLISHED_ISO = '>>> FILL YYYY-MM-DD';
const UPDATED_ISO = '>>> FILL YYYY-MM-DD';
const published = '>>> FILL Month D, YYYY';
const updated = '>>> FILL Month D, YYYY';
const readingMinutes = 6;                      // >>> FILL — words / ~250

// 50 chars MAX: Layout renders `${TITLE} | Lussaro`, and verify.py wants the
// rendered <title> between 50 and 60.
const TITLE = '>>> FILL — <=50 chars, primary keyword near the start';
const waMessage = '>>> FILL — WhatsApp prefill, one sentence referencing this post';
const wa = whatsappWith(waMessage);

// A named reviewer, quoted verbatim. Pick one with NO exclamation marks:
// reviews[0] and reviews[4] contain them and will fail verify.py.
const testimonial = reviews[2];

// >>> FILL — one entry per H2 in the body. ids must match the H2 ids exactly.
const toc = [
  { id: 'section-one', label: '>>> FILL' },
  { id: 'section-two', label: '>>> FILL' },
  { id: 'section-three', label: '>>> FILL' },
  { id: 'faq', label: 'Common questions' },
];

// >>> FILL — 4–8 questions from People Also Ask. Answers 2–4 sentences.
// Every number renders from the data files, never typed as a literal.
const faqs = [
  { q: '>>> FILL', a: `>>> FILL` },
];

// --- Schema. Do not restructure. ------------------------------------------
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE}/about#robert`,
  name: 'Robert Comella',
  jobTitle: 'Founder',
  url: `${SITE}/about`,
  worksFor: { '@type': 'Organization', name: business.brandName, url: `${SITE}/` },
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: TITLE,
  description: '>>> FILL — one sentence, mirrors the meta description',
  image: OG_IMAGE,
  datePublished: PUBLISHED_ISO,
  dateModified: UPDATED_ISO,
  author: { '@id': `${SITE}/about#robert` },
  publisher: {
    '@type': 'Organization',
    name: business.brandName,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': PAGE_URL },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const mapLink = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(addressLine)}`;

---
<Layout
  title={`${TITLE} | Lussaro`}
  description={'>>> FILL — 150–160 chars rendered, primary keyword first, ends with a soft CTA'}
  image={OG_IMAGE}
  type="article"
  breadcrumbName=">>> FILL — the breadcrumb leaf label"
  schema={[articleSchema, authorSchema, faqSchema]}
>
  {/* Skip link stays on the page, not in Layout: the other routes have no
       #main target yet, and a skip link that lands nowhere is worse than none. */}
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:text-black focus:px-5 focus:py-3 focus:rounded-full focus:font-semibold focus:ring-2 focus:ring-[#ff1516]"
  >
    Skip to content
  </a>

  <Nav />

  <main id="main" tabindex="-1">
    {/* The header sits OUTSIDE <article> deliberately. The hero markup — a
        srcset of six candidates alone runs ~450 characters — otherwise eats
        the window the on-page checklist uses to confirm the bolded answer is
        near the top, and every future post would fight the same budget. The
        article element wraps the prose, which is what the word-count and link
        checks measure anyway. */}
      {/* ARTICLE HEADER. The photograph used to sit behind this text at 25%
           opacity under a 60% black gradient, which meant nobody ever saw it.
           The header is now type only, and the image gets its own figure
           below at full opacity where it can actually be looked at. */}
      {/* SPLIT HERO. The first version buried the photo behind the headline at
          25% opacity; the second stacked a 1076px-wide image under a 768px text
          block, which left a dead column on the right and pushed the article
          below the fold. Headline and photograph now sit side by side at one
          shared height, so the image is a real element and the body starts
          sooner. Explicit grid placement rather than source order: on a phone
          the stack reads headline, photo, then byline and buttons. */}
      <header class="bg-[#0a0a0a] pt-28 md:pt-32 pb-12 md:pb-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">
          <nav aria-label="Breadcrumb" class="mb-7">
            <ol class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-xs text-white/50">
              <li><a href="/" class="hover:text-white transition">Home</a></li>
              <li aria-hidden="true">/</li>
              <li><a href="/blog" class="hover:text-white transition">Rental Guides</a></li>
              <li aria-hidden="true">/</li>
              <li aria-current="page" class="text-white/70">>>> FILL — short leaf label</li>
            </ol>
          </nav>

          <div class="lg:grid lg:grid-cols-[1.05fr_1fr] lg:gap-12 xl:gap-16">
            <div class="text-center lg:text-left lg:col-start-1 lg:row-start-1">
              <p class="text-[#ff1516] tracking-[0.3em] uppercase text-xs mb-4">Comparison</p>
              <h1 class="font-display text-3xl md:text-[2.75rem] xl:text-5xl font-bold tracking-tight text-white leading-[1.08] text-balance">
                >>> FILL — one H1, contains the primary keyword
              </h1>
              <p class="text-white/65 text-base md:text-lg leading-relaxed mt-5">
                >>> FILL — dek, one or two sentences. Name the real difference.
              </p>
            </div>

            <figure class="mt-8 lg:mt-0 lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center">
              <img
                src={heroSrc}
                srcset={heroSrcSet}
                sizes="(min-width: 1024px) 520px, 100vw"
                width="760"
                height="507"
                alt={heroAlt}
                fetchpriority="high"
                decoding="async"
                class="w-full h-auto rounded-2xl"
              />
              <figcaption class="text-white/45 text-xs mt-3 text-center lg:text-left">
                >>> FILL — short caption. Keep it tight: this sits in the hero.
              </figcaption>
            </figure>

            <div class="text-center lg:text-left lg:col-start-1 lg:row-start-2 lg:self-end">
              <div class="mt-8 lg:mt-7 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-sm text-white/60">
                <span>By <a href="/about" class="text-white underline decoration-white/30 hover:decoration-white">Robert Comella</a>, founder</span>
                <span aria-hidden="true" class="text-white/25">|</span>
                <span><time datetime={PUBLISHED_ISO}>{published}</time> <span aria-hidden="true">·</span> Updated <time datetime={UPDATED_ISO}>{updated}</time></span>
                <span aria-hidden="true" class="text-white/25">|</span>
                <span>{readingMinutes} min read</span>
              </div>

              <div class="mt-6 flex flex-col sm:flex-row gap-3 max-w-md mx-auto lg:mx-0">
                <a href={wa} data-cta="blog_hero" target="_blank" rel="noopener noreferrer"
                   class="flex-1 inline-flex items-center justify-center gap-2 min-h-[48px] bg-white text-black px-7 py-4 rounded-full font-semibold hover:bg-[#ff1516] transition">
                  Check your dates <span class="w-2 h-2 rounded-full bg-[#1f7a3f]" aria-hidden="true"></span>
                </a>
                <a href={telHref} data-cta="blog_hero" data-call-inline
                   class="flex-1 inline-flex items-center justify-center min-h-[48px] border border-white/25 text-white px-7 py-4 rounded-full font-medium hover:border-[#e00e10] hover:text-[#e00e10] transition">
                  Call {business.phoneDisplayShort}
                </a>
              </div>
            </div>
          </div>
        </div>
      </header>

    <article>
      <div class="bg-white text-[#0a0a0a] py-12 md:py-16">
        <div class="max-w-[1140px] mx-auto px-5 md:px-8">

          {/* SHORT ANSWER. Full width, above the columns, so it reads as the
               answer to the headline rather than as the first paragraph. */}
          <div class="not-prose mb-10 md:mb-14 rounded-2xl border border-[#e00e10]/20 bg-[#fff7f7] p-6 md:p-8 max-w-3xl">
            <p class="text-xs uppercase tracking-[0.2em] text-[#e00e10] font-semibold mb-3">Short answer</p>
            <p class="text-lg md:text-xl leading-relaxed">
              <strong>
                >>> FILL — 40–60 words answering the query outright, with the real figures
                rendered from the data files. This is the featured-snippet target and the
                first bolded text on the page.
              </strong>
            </p>
          </div>

          {/* TWO COLUMNS from lg up: a readable measure for the prose and a
               sticky contents rail, instead of one long column of text across a
               desktop viewport. The rail is first in the DOM so it is reachable
               before the content it indexes. */}
          <div class="lg:grid lg:grid-cols-[minmax(0,260px)_minmax(0,1fr)] lg:gap-14 xl:gap-20">
            <aside class="mb-10 lg:mb-0">
              <nav aria-label="Table of contents" class="not-prose lg:sticky lg:top-28 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
                <h2 class="font-display text-base font-bold mb-3">On this page</h2>
                <ol class="grid sm:grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-2.5 text-sm">
                  {toc.map((t, i) => (
                    <li>
                      <a href={`#${t.id}`} class="text-[#e00e10] hover:underline">
                        <span class="text-black/60 tabular-nums mr-1">{i + 1}.</span>{t.label}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            </aside>

            {/* Inline links underlined: color alone fails WCAG 1.4.1.
                 text-black/60 is the floor on this background; /40 fails AA. */}
            <div class="prose prose-neutral max-w-none prose-headings:font-display prose-headings:scroll-mt-28 prose-a:text-[#e00e10] prose-a:underline prose-a:decoration-[#e00e10]/40 prose-a:underline-offset-2 hover:prose-a:decoration-[#e00e10] prose-table:text-sm prose-h2:mt-12 prose-h2:pt-8 prose-h2:border-t prose-h2:border-black/10 first:prose-h2:mt-0 first:prose-h2:pt-0 first:prose-h2:border-0">

        <p>
          >>> FILL — opening joke, one line, under ~30 words. Aimed at the industry or at
          Miami, never self-deprecating here. Deadpan, sharp word last, then move on.
          See references/humour.md.
        </p>

        {/* ===================== BODY — YOURS TO WRITE =====================
             One H2 per toc entry, ids matching exactly. H3s only under H2s.
             Every number renders from the data files; never type a literal.
             Keep {/* */} comments — HTML comments ship to the browser.
        ===================================================================== */}

        <h2 id="section-one">>>> FILL — H2 carrying a supporting keyword</h2>

        <p>>>> FILL</p>

        {/* INLINE FIGURE. Lazy, never fetchpriority — the hero owns that. */}
        <figure class="not-prose my-10">
          <img
            src={bodySrc}
            srcset={bodySrcSet}
            sizes="(min-width: 1140px) 760px, 100vw"
            width="1000"
            height="667"
            alt={bodyAlt}
            loading="lazy"
            decoding="async"
            class="w-full h-auto rounded-2xl"
          />
          <figcaption class="text-black/60 text-sm mt-3">>>> FILL — a caption that argues, not one that repeats the alt</figcaption>
        </figure>

        <h2 id="section-two">>>> FILL</h2>

        <p>>>> FILL</p>

        {/* Real Google review. Verbatim, never edited. Pick one with NO
            exclamation marks — verify.py bans [a-z]! in the article body. */}
        <figure class="not-prose my-10 rounded-2xl border border-black/10 bg-[#fafafa] p-6">
          <blockquote class="text-[#0a0a0a]/80 leading-relaxed">
            <p>“{testimonial.text}”</p>
          </blockquote>
          <figcaption class="mt-4 text-sm text-[#0a0a0a]/60">
            <span class="text-[#e00e10]" aria-hidden="true">★★★★★</span>
            <span class="font-semibold text-[#0a0a0a]"> {testimonial.name}</span> — verified Google review
          </figcaption>
        </figure>

        <h2 id="section-three">>>> FILL</h2>

        <p>>>> FILL — 3–5 internal links with descriptive anchors across these
           sections. 2–3 external links, each verified 200 before use.</p>

        <h2 id="faq">Common questions</h2>

        {faqs.map((f) => (
          <div>
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}

        <p>
          Both cars are kept to the same standard and handed over by the same person, so the only
          real decision is the seat. Tell us your dates and who is travelling and we will tell you
          which one we would put you in — including when that is the cheaper one. What are you
          thinking?
        </p>

        <div class="not-prose mt-10 flex flex-col sm:flex-row gap-3 max-w-md">
          <a href={wa} data-cta="blog_body" target="_blank" rel="noopener noreferrer"
             class="flex-1 inline-flex items-center justify-center min-h-[48px] bg-[#0a0a0a] text-white px-7 py-4 rounded-full font-semibold hover:bg-[#e00e10] transition">
            Message us on WhatsApp
          </a>
          <a href={telHref} data-cta="blog_body" data-call-inline
             class="flex-1 inline-flex items-center justify-center min-h-[48px] border border-[#0a0a0a]/20 text-[#0a0a0a] px-7 py-4 rounded-full font-medium hover:border-[#e00e10] hover:text-[#e00e10] transition">
            Call {business.phoneDisplayShort}
          </a>
        </div>

        <RelatedPosts currentSlug=">>> FILL-slug" />

        {/* Author bio — E-E-A-T. Never claims tenure: the company was formed
             December 2025 and registration is public. */}
        <aside class="not-prose mt-12 rounded-2xl border border-black/10 bg-[#fafafa] p-6 flex flex-col sm:flex-row gap-5">
          <img src="/favicon-96.png" width="64" height="64" alt="" aria-hidden="true"
               loading="lazy" decoding="async"
               class="w-16 h-16 rounded-full shrink-0 object-cover ring-1 ring-black/10" />
          <div>
            <p class="font-display font-bold text-lg">
              <a href="/about" class="hover:text-[#e00e10] transition">Robert Comella</a>
            </p>
            <p class="text-sm text-[#0a0a0a]/70 mt-1">Founder, {business.brandName}</p>
            <p class="text-sm text-[#0a0a0a]/70 mt-3 leading-relaxed">
              Robert founded Lussaro Collection in Miami and runs it hands-on — he answers the phone,
              screens the renters and hands over the keys himself. The fleet started with a single
              Mercedes-Maybach GLS 600 bought with his own savings. Every price, deposit and fee
              quoted here is one he sets and honors personally.
              <a href="/about" class="text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]"> More about Lussaro Collection</a>.
            </p>
          </div>
        </aside>

        {/* NAP block. A link, never an embedded map. */}
        <aside class="not-prose mt-8 rounded-2xl border border-black/10 p-6">
          <h2 class="font-display text-lg font-bold">Lussaro Collection</h2>
          <dl class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm">
            <div>
              <dt class="font-semibold">Address</dt>
              <dd class="text-[#0a0a0a]/70">{addressLine}</dd>
            </div>
            <div>
              <dt class="font-semibold">Hours</dt>
              <dd class="text-[#0a0a0a]/70">{hoursSummary}</dd>
            </div>
            <div>
              <dt class="font-semibold">Phone</dt>
              <dd><a href={telHref} data-cta="blog_nap" class="text-[#e00e10] hover:underline">{business.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt class="font-semibold">Delivery area</dt>
              <dd class="text-[#0a0a0a]/70">Miami, South Beach, Brickell, both airports. Fort Lauderdale at {usd(rentalTerms.delivery[1].fee)} each way.</dd>
            </div>
          </dl>
          <p class="mt-5">
            <a href={mapLink} target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 min-h-[48px] text-sm text-[#e00e10] underline decoration-[#e00e10]/40 underline-offset-2 hover:decoration-[#e00e10]">
              Open {addressLine} in Google Maps
            </a>
          </p>
        </aside>

        <p class="not-prose mt-10 text-center">
          <a href="#main" class="inline-flex items-center gap-2 min-h-[48px] px-5 py-3 text-sm text-[#0a0a0a]/60 hover:text-[#e00e10] transition">
            <span aria-hidden="true">↑</span> Back to top
          </a>
        </p>
            </div>
          </div>
        </div>
      </div>
    </article>
  </main>

  <CtaBand
    title={'>>> FILL — two lines, second wrapped in <span class="text-[#ff1516]">'}
    subtitle="Delivered across Miami. Replies usually take minutes."
    message={waMessage}
  />
  <StickyMobileCta message={waMessage} />
</Layout>
